---
import Base from '../../layouts/Base.astro';
import Board from '../../components/Board.astro';
// Rocznik 2026: samo Płótno; sekcja Ostatnie zajęcia zniknęła (jego słowo, 2026-10-22), opis zajęć stoi w dymku przy ich etykiecie.
---
<Base title="Rocznik 2026 · kogni.pl" activePage="plotno" rocznik="2026" description="Rocznik 2026: zajęcia z kognitywistyki na Uniwersytecie w Białymstoku w roku 2026/27, wątek po wątku, karta po karcie.">
<h1 class="sr-only">Rocznik 2026</h1>

<section aria-labelledby="plotno">
  <h2 class="sr-only" id="plotno">Płótno: cały rok, zajęcia na osnowach</h2>
  <div class="start-plotno"><Board view="plotno" /></div>
</section>
<script>
  const koniec = (s) => s.parentElement?.classList.toggle('pl-koniec', s.scrollLeft + s.clientWidth >= s.scrollWidth - 4);
  const wszystkie = () => document.querySelectorAll('.pl-scroll').forEach(koniec);
  document.addEventListener('scroll', (e) => { if (e.target instanceof Element && e.target.classList.contains('pl-scroll')) koniec(e.target); }, true);
  addEventListener('load', wszystkie); addEventListener('resize', wszystkie); setTimeout(wszystkie, 600);
</script>
</Base>
