---
import Base from '../../../layouts/Base.astro';
import Board from '../../../components/Board.astro';
import { SP } from '../../../rocznik/data.js';
export function getStaticPaths() {
  return SP.map((s) => ({ params: { karta: s.id }, props: { s } }));
}
const { s } = Astro.props;
---
<Base title={s.h + ' · Rocznik 2026 · kogni.pl'} activePage="" rocznik="2026">
  <Board view="karta" state={{ id: s.id }} />
</Base>
