---
import R from '../../../rocznik/2026/rocznik.json';
import { card } from '../../../karty/data.js';
// Dawne adresy kart Rocznika prowadzą do kart wiki. Stare karty zajęć i adresy prowadzące do dymków zajęć zeszły ze strony
// razem z kursami (jego słowo, 2026-11-17: *Take off the kursy from kogni*); ich strona leży w _backups/2026-11-17_kursy/.
export function getStaticPaths() {
  return Object.entries(R['przekierowania'] || {})
    .map(([slug, t]) => ({ slug, k: t.karta && card(t.karta) }))
    .filter((r) => r.k)
    .map((r) => ({ params: { karta: r.slug }, props: { to: r.k.url } }));
}
const { to } = Astro.props;
---
<html lang="pl"><head><meta charset="UTF-8"><meta http-equiv="refresh" content={'0; url=' + to}><link rel="canonical" href={to}><meta name="robots" content="noindex"><title>kogni.pl</title></head><body><a href={to}>{to}</a></body></html>
