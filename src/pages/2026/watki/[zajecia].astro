---
// Wątki zniknęły (jego słowo, 2026-10-22): adres zajęć prowadzi na Płótno z ich dymkiem.
import { held } from '../../../rocznik/data.js';
export function getStaticPaths() {
  return held.map((c) => ({ params: { zajecia: c.id }, props: { to: '/2026/?z=' + c.id } }));
}
const { to } = Astro.props;
---
<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<title>kogni.pl</title>
<meta name="robots" content="noindex">
<link rel="canonical" href={'https://kogni.pl' + to}>
<meta http-equiv="refresh" content={'0; url=' + to}>
<script is:inline define:vars={{ to }}>location.replace(to);</script>
</head>
<body><p><a href={to}>{'kogni.pl' + to}</a></p></body>
</html>
