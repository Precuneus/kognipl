---
// Wpis zajęć: cały opis, karty i materiały po zajęciach na własnej stronie; dymek na Płótnie otwiera półtora
// akapitu i prowadzi tutaj (jego słowo, 2026-11-01: *it should open with 2,5 para and with cta to open an entire entry*, potem *change it to 1,5 para from 2,5*).
import Base from '../../../layouts/Base.astro';
import R from '../../../rocznik/2026/rocznik.json';
import { held } from '../../../rocznik/data.js';
import { segs, card, INK } from '../../../karty/data.js';
import '../../../styles/wiki.css';
import TerminDymek from '../../../components/TerminDymek.astro';
export function getStaticPaths() {
  return held.map((c) => ({ params: { zajecia: c.id }, props: { c } }));
}
const { c } = Astro.props;
const z = R['zajęcia'].find((x) => x.id === c.id);
const ink = c.course === 'Intro' ? '#f0c060' : '#edbbc5';
const karty = (z.karty || []).map((name) => card(name) ? { h: card(name).h, url: card(name).url, color: INK[card(name).g] } : { h: name });
const plain = (p) => p.replace(/\[\[([^\]|]+)(?:\|([^\]]+))?\]\]/g, (_, a, b) => b || a);
const first = z.opis && z.opis.length ? plain(z.opis[0]).split(/(?<=\.)\s/)[0] : '';
// Ryciny wpisu (jego słowo, 2026-11-01: *we should start adding illustrations to the website. To the kursy*): pole `ryciny` zajęć,
// każda po akapicie `po`, numerowana w kolejności i podpisana; rysunki w src/rocznik/2026/ryciny/wpisy/, w kolorze kursu.
const RYC = import.meta.glob('../../../rocznik/2026/ryciny/wpisy/*.svg', { query: '?raw', import: 'default', eager: true });
const unmark = (t) => String(t || '').replace(/<!--\[s:[^\]]*\]-->/g, '');
// rycina z otwartego źródła (jego słowo, 2026-11-01: *Find add, and cite open source images where possible*): pole `obraz` (adres w public),
// `zrodlo` z autorem i licencją, `jasne` kładzie rysunek o ciemnych podpisach na jasnym tle; podpis może mieć listę `lista`
// jedna rycina z kilku części (jego słowo, 2026-11-01: *ryc 2 and 3 should be a single rycina*): pole `czesci`, każda z `obraz` albo `plik`
const svgOf = (plik) => RYC['../../../rocznik/2026/ryciny/wpisy/' + plik + '.svg'] || '';
const figs = (z.ryciny || []).slice().sort((x, y) => x.po - y.po).map((r, i) => ({ ...r, n: i + 1,
  czesci: (r.czesci || [r]).map((q) => ({ ...q, svg: q.obraz ? '' : svgOf(q.plik) })), zrodla: r.zrodla || (r.zrodlo ? [r.zrodlo] : []) }));
figs.forEach((f) => f.czesci.forEach((q) => { if (!q.svg && !q.obraz) throw new Error('Wpis ' + c.id + ': brak ryciny ' + q.plik); }));
// poprzednie i następne zajęcia (jego słowo, 2026-11-01: *I should see a menu on the top, to click right to the previous class and right to the next*)
const hi = held.findIndex((x) => x.id === c.id), prev = held[hi - 1], next = held[hi + 1];
---
<Base title={c.title + ' · ' + c.course + ' ' + c.short + ' · kogni.pl'} activePage="plotno" rocznik="2026" description={first}>
<article class="wk wz" style={'--ink:' + ink}>
  <nav aria-label="Zajęcia" class="wz-nav">
    {prev ? <a href={prev.url} class="wz-nav-l" title={prev.title}><span aria-hidden="true">‹</span> {prev.course} {prev.short}</a> : <span class="wz-nav-l"></span>}
    <a href={'/2026/?z=' + c.id} class="wz-nav-c" aria-current="page">{c.course} {c.short}</a>
    {next ? <a href={next.url} class="wz-nav-r" title={next.title}>{next.course} {next.short} <span aria-hidden="true">›</span></a> : <span class="wz-nav-r"></span>}
  </nav>
  <div class="wk-grid">
    <div class="wk-col">
      <section aria-label="Zajęcia" class="wk-box wk-mysl">
        <h2>{c.course} · {c.date}</h2>
        <h1>{c.title}</h1>
      </section>
      <section aria-label="Opis" class="wk-box">
        <h2>Opis</h2>
        {(z.opis || []).map((p, i) => [
          <p class="wk-p">{segs(p).map((s) => s.url ? <a href={s.url} title={s.label} data-def={s.def} style={'color:' + s.color}>{s.t}</a> : s.t)}</p>,
          ...figs.filter((f) => f.po === i).map((f) => (
            <figure class="wk-fig wz-fig">
              <div class={f.czesci.length > 1 ? 'wz-czesci' : ''}>{f.czesci.map((q) => q.obraz ? <img src={q.obraz} alt={unmark(q.alt || f.podpis)} loading="lazy" class={q.jasne ? 'wz-jasne' : ''} /> : <Fragment set:html={q.svg} />)}</div>
              <figcaption>{'Ryc. ' + f.n + '. '}{segs(unmark(f.podpis)).map((s) => s.url ? <a href={s.url} title={s.label} data-def={s.def} style={'color:' + s.color}>{s.t}</a> : s.t)}
                {f.lista && <ul class="wz-lista">{f.lista.map((x) => <li>{segs(unmark(x)).map((s) => s.url ? <a href={s.url} title={s.label} data-def={s.def} style={'color:' + s.color}>{s.t}</a> : s.t)}</li>)}</ul>}
                {f.dopis && <span>{' ' + unmark(f.dopis)}</span>}
                {f.zrodla.length > 0 && <span class="wz-zrodlo">{f.zrodla.length > 1 ? ' Źródła: ' : ' Źródło: '}{f.zrodla.map((z2, i) => [i > 0 ? '; ' : '', <a href={z2.url} target="_blank" rel="noopener">{z2.t}</a>])}</span>}
              </figcaption>
            </figure>
          )),
        ])}
      </section>
    </div>
    <div class="wk-col">
      {karty.length > 0 && (
        <section aria-label="Karty" class="wk-box">
          <h2>Karty</h2>
          <div class="wk-chips">{karty.map((k) => k.url
            ? <a href={k.url} class="wk-chip" style={'--c:' + k.color}>{k.h}</a>
            : <span class="wk-chip wz-szkic">{k.h}</span>)}</div>
        </section>
      )}
      {c.after.length > 0 && (
        <section aria-label="Po zajęciach" class="wk-box">
          <h2>Po zajęciach</h2>
          <ul class="wz-po">{c.after.map((a) => <li><a href={a.url} target="_blank" rel="noopener">{a.label}</a></li>)}</ul>
        </section>
      )}
    </div>
  </div>
</article>
<TerminDymek />
<script>
  // Etykiety rycin (jego słowo, 2026-11-01: *When you draw something you use a label, a podpis, etykieta. And you use a regular font with
  // white bold letters. I want this to look better*): każdy podpis na rycinie (text.et) dostaje plakietkę na swoją miarę, ciemną,
  // z cienką ciepłą obwódką; podpisy w kilku wierszach o tym samym wyrównaniu dzielą jedną plakietkę
  const NS = 'http://www.w3.org/2000/svg';
  document.querySelectorAll('.wz-fig svg').forEach((svg) => {
    const ts = [...svg.querySelectorAll('text.et')] as SVGTextElement[];
    const grupy: SVGTextElement[][] = [];
    for (const t of ts) {
      const g = grupy.find((gr) => { const l = gr[gr.length - 1], fs = parseFloat(t.getAttribute('font-size') || '12');
        return l.getAttribute('text-anchor') === t.getAttribute('text-anchor') && Math.abs(+l.getAttribute('x')! - +t.getAttribute('x')!) < 1 && +t.getAttribute('y')! - +l.getAttribute('y')! > 0 && +t.getAttribute('y')! - +l.getAttribute('y')! <= fs * 1.6; });
      if (g) g.push(t); else grupy.push([t]);
    }
    for (const gr of grupy) {
      let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
      for (const t of gr) { const b = t.getBBox(); x0 = Math.min(x0, b.x); y0 = Math.min(y0, b.y); x1 = Math.max(x1, b.x + b.width); y1 = Math.max(y1, b.y + b.height); }
      const fs = parseFloat(gr[0].getAttribute('font-size') || '12'), px = fs * .62, py = fs * .3;
      const r = document.createElementNS(NS, 'rect');
      r.setAttribute('x', String(x0 - px)); r.setAttribute('y', String(y0 - py)); r.setAttribute('width', String(x1 - x0 + 2 * px)); r.setAttribute('height', String(y1 - y0 + 2 * py));
      r.setAttribute('rx', String(Math.min(fs * .9, (y1 - y0 + 2 * py) / 2))); r.setAttribute('class', 'et-tlo');
      gr[0].parentNode!.insertBefore(r, gr[0]);
    }
  });
</script>
</Base>

<style is:global>
.wz .wk-mysl h1{font-style:normal}
.wz-szkic{--c:#6f685d;color:#a09888}
.wz-po{margin:0;padding:0 0 0 18px;font-size:14.5px;line-height:1.6}
.wz-po li{margin-bottom:8px}
.wz-po a{color:var(--ink)}
.wz-fig svg{max-width:100%}
.wz-fig svg text.et{font-family:var(--font-body);font-weight:500;letter-spacing:.015em;fill:#ebe3d3}
.wz-fig svg .et-tlo{fill:rgba(18,17,13,.9);stroke:rgba(214,198,166,.42);stroke-width:1;vector-effect:non-scaling-stroke}
.wz-fig img{display:block;width:100%;max-width:560px;height:auto;border-radius:10px}
.wz-fig img.wz-jasne{background:#ece6da;padding:10px}
.wz-czesci{display:grid;grid-template-columns:1fr;gap:10px;align-items:center}
.wz-czesci img,.wz-czesci svg{max-width:100%}
@media (max-width:720px){.wz-czesci{grid-template-columns:1fr}}
.wz-lista{margin:6px 0 4px;padding-left:18px}
.wz-lista li{margin:2px 0}
.wz-zrodlo{color:#7d7466}
.wz-zrodlo a{color:#a09888}
.wz-nav{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:12px;font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:18px}
.wz-nav a{color:var(--ink);text-decoration:none}
.wz-nav-l{justify-self:start}
.wz-nav-r{justify-self:end}
.wz-nav-c{justify-self:center;color:#e2ddd4 !important;font-size:13.5px}
.wz-nav a.wz-nav-l,.wz-nav a.wz-nav-r{color:#a09888}
.wz-nav a.wz-nav-l:hover,.wz-nav a.wz-nav-r:hover{color:var(--ink)}
.wz-fig figcaption a{text-decoration:none}
</style>
