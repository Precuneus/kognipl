---
import Base from '../../../layouts/Base.astro';
import RocznikHeader from '../../../components/RocznikHeader.astro';
import Board from '../../../components/Board.astro';
import { held } from '../../../rocznik/data.js';
export function getStaticPaths() {
  return held.map((c) => ({ params: { zajecia: c.id }, props: { c } }));
}
const { c } = Astro.props;
---
<Base title={'Rocznik 2026 · ' + c.course + ' ' + c.short + ': ' + c.title + ' · kogni.pl'} activePage="rocznik">
  <RocznikHeader current="watki" />
  <Board view="watki" state={{ cls: c.id }} />
</Base>
