---
import Base from '../layouts/Base.astro';
import '../styles/karta-strony.css';
---
<Base title="Nie ma takiej strony · kogni.pl" activePage="404" description="Ten adres na kogni.pl prowadzi donikąd; dalej prowadzą Wiki, Kursy i strona startowa.">

<div class="ostronie">
  <h1>Nie ma takiej strony</h1>

  <div class="ostronie-card">
    <p class="ostronie-lead">Ten adres prowadzi donikąd, ale stąd dojdziesz wszędzie.</p>
    <div class="ostronie-line" aria-hidden="true"></div>
    <p class="ostronie-txt">Pojęcia czekają w <a href="/wiki/">Wiki</a>, zajęcia w <a href="/2026/">Kursach</a>, a <a href="/">strona startowa</a> otwiera mózg i jego historię.</p>
  </div>
</div>

</Base>
