.roj .roj-ku-plotnu.puls::after{animation:puls 2.6s ease-in-out infinite}
/* drzwi do Płótna bez napisu: pas po prawej zna ten, kto wie; reszta przewija dalej (jego słowo, 2026-10-20) */
@keyframes puls{50%{opacity:1}}
.roj .roj-ku-plotnu:hover,.roj .roj-ku-plotnu:focus-visible{background:linear-gradient(90deg,rgba(240,192,96,0),rgba(240,192,96,.07));outline:0}
