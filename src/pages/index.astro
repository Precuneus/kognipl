---
import Base from '../layouts/Base.astro';
import R from '../rocznik/2026/rocznik.json';

// Strona startowa: ekrany przewijane nad rojem cząstek z masek sieci. Złote zdania duże, białe opisy małe.
// {{słowo}} to miejsce, na którym staje iskra (kropka z logo, która wędruje z czytelnikiem); {{słowo|klasa}} dokłada klasę.
const WIKI = Object.keys(import.meta.glob('./wiki/**/*.astro')).length > 0 ? '/wiki/' : '';
const md = (t) => t.replace(/\{\{([^}|]+)(?:\|([^}]+))?\}\}/g, (_, w, k) => '<span class="iskra-cel' + (k ? ' ' + k : '') + '">' + w + '</span>');
const T = {
  pytanie: 'Czym jest to, czego {{doświadczasz}}?',
  punkty: ['rozumienie tekstu, dotyk, swój oddech, spojrzenie w oczy...', 'To aktywność sieci mózgowych.'],
  zmiany: 'Zmiany struktury mózgu (np. degeneracje, lezje, uszkodzenia) i zmiany funkcjonowania struktur między sobą (np. substancje psychoaktywne, uzależnienia, nauka, rozwój) {{zmieniają}} czego doświadczam.',
  zombie: ['Jesteś człowiekiem, prawda? Czy {{zombie}}?', 'Założę, że człowiekiem i też doświadczasz, jak ja. Ale nie mogę tego {{wiedzieć|dalej}}.'],
  wiem: ['Wiem tylko tyle, ile się nauczyłem od {{środowiska}}, w którym się urodziłem.', 'Doświadczam Modeli Mentalnych, które jednocześnie są moją aktywnością biologiczną.'],
  ja: ['Ale... "{{ja}}" to też Model Mentalny', 'Model "ja" zmienia się w czasie,  Zmienia się płynnie (nauka, dryfowanie) i gwałtownie (szok, przeskok). "Ja" to Statek Tezeusza strukturalnie i funkcjonalnie połączonych komórek.'],
  dosw: ['{{Doświadcza}} się.', 'Skoro podmiot i treść doświadczenia się zmieniają to zostaje samo doświadczenie. Doświadcza się. Swiat się doświadcza, ciało się doświadcza, ja się doświadczam.'],
  badane: 'Doświadczanie się badane przez...',
  kogni: [
    'W zamyśle inicjatorów, powinna być to interdyscyplinarna nauka o umyśle, adresująca najgłębsze zagadki doświadczanej rzeczywistości. Doświadcza się Model Mentalny obiektywnego świata z jego mechanikami. Mechaniki doświadczają się, a potem doświadcza się ich wytłumaczenie. W zależności od czasów, biologia żeglarza i fizyka wzburzonego morza wytłumaczy się gniewem Posejdona, albo meteorologią. Czasem wytłumaczenie się interakcji biologii z fizyką i chemią jest tak trafne, że doświadcza się na przykład wyzdrowienia.',
    'Tylko wciąż... Wytłumacza się kawałek skały krążący wokół reaktora fuzyjnego we wszechświecie, który powstał z niczego 13,8 mld lat temu. Doświadcza się głęboka subiektywność, czasem dzielona z kimś tak bardzo, że wydaje się jakby mogła być intersubiektywna. Tyle rzeczy, które się doświadczają... nie wytłumacza się.',
  ],
  sprobujmy: 'Spróbujmy je {{wytłumaczyć|hura}}.',
};
// Sieci w kolejności od receptorów; numer to etykieta w masce BraiNets_MASKS.
const SIECI = [
  [2, 'Sieć wzrokowa', 'Widzisz.'],
  [3, 'Sieć czuciowo-ruchowa', 'Czujesz ciało i się ruszasz.'],
  [4, 'Sieć grzbietowa uwagi', 'Koordynujesz oko i rękę.'],
  [6, 'Sieć istotności', 'Coś zagraża schematowi ciała.'],
  [5, 'Sieć kontroli', 'Trzymasz zadanie.'],
  [7, 'Sieć domyślna', 'Ty, Twoja przeszłość i przyszłość, inni ludzie.'],
];
// odstępy między sieciami: nieregularny rytm, jak w ciągłym tekście
const ODSTEP = ['0', '6vh', '11vh', '4vh', '14vh', '8vh'];
const KOLOR = { 2: '#ee6b6f', 3: '#f9d780', 4: '#e58e76', 5: '#f69959', 6: '#a9b26f', 7: '#bb6fb2' };
const OSNOWY = [['socjologia', '#8fa274'], ['psychologia', '#5f9a96'], ['biologia', '#6585b0'], ['fizyka', '#8577b3']];
const KOL_OSN = Object.fromEntries(OSNOWY);
const NAUKI = [
  ['Socjologię', 'socjologia', 'Doświadcza się wspólnota, której język i zwyczaje przejmujesz od urodzenia.'],
  ['Psychologię', 'psychologia', 'Doświadczają się Twoje modele siebie, innych i świata.'],
  ['Biologię', 'biologia', 'Doświadcza się organizm, od komórki po sieci Twojego mózgu.'],
  ['Fizykę', 'fizyka', 'Doświadcza się energia, którą Twoje receptory przetwarzają w bioinformację.'],
];
// Słowa, które oświetlają postacie: osnowy Płótna, każda grupa w swoim kolorze.
const GRUPY = R.grupy.map((g) => ({ nazwa: g.nazwa, kolor: KOL_OSN[g.nazwa], slowa: g.osnowy.map((o) => o.nazwa) }));
const CHMURA = ['solipsyści', 'mózg w naczyniu', 'symulacja', 'matrix'];
const slowoPoz = (j, n) => 'top:' + (n === 1 ? 50 : 3 + j * 90 / (n - 1)).toFixed(1) + '%;left:' + (50 + (j % 2 ? 1 : -1) * (12 + (j * 7) % 14)).toFixed(1) + '%';
// Postać w habicie z kapturem, bez twarzy, ze świecą; płomień i światło w kolorze --swiatlo.
const SZATA = 'M50 5 C34 5 25 20 24 38 C23 50 21 57 17 65 C11 79 9 118 8 158 L5 218 L95 218 L92 158 C91 118 89 79 83 65 C79 57 77 50 76 38 C75 20 66 5 50 5 Z';
const postac = (id, swiatlo = '#ffc978') => `<svg class="postac" viewBox="0 0 100 220" style="--swiatlo:${swiatlo}" aria-hidden="true"><defs>`
  + `<radialGradient id="ps${id}" cx="50" cy="92" r="110" gradientUnits="userSpaceOnUse"><stop offset="0" class="s1"/><stop offset=".32" class="s2"/><stop offset="1" class="s3"/></radialGradient>`
  + `<radialGradient id="pg${id}" cx="50" cy="84" r="34" gradientUnits="userSpaceOnUse"><stop offset="0" class="g1"/><stop offset="1" class="g3"/></radialGradient></defs>`
  + `<path class="szata" d="${SZATA}"/>`
  + `<path class="faldy" d="M38 118 C36 150 33 185 30 216 M50 114 L50 216 M62 118 C64 150 67 185 70 216 M27 72 C23 102 19 142 17 200 M73 72 C77 102 81 142 83 200"/>`
  + `<path class="rekawy" d="M18 76 C22 96 34 112 47 113 L53 113 C66 112 78 96 82 76 C76 92 64 101 50 101 C36 101 24 92 18 76 Z"/>`
  + `<path class="swiatlo" fill="url(#ps${id})" d="${SZATA}"/>`
  + `<ellipse class="kaptur-brzeg" cx="50" cy="41" rx="15.5" ry="19.5"/><ellipse class="kaptur" cx="50" cy="42" rx="12" ry="16"/>`
  + `<circle class="poswiata" cx="50" cy="84" r="34" fill="url(#pg${id})"/>`
  + `<rect class="swieca" x="46.9" y="89" width="6.2" height="15" rx="1"/>`
  + `<g class="plomien"><path d="M50 74 C53 79 54 83 52.5 86.5 C51.5 88.5 48.5 88.5 47.5 86.5 C46 83 47 79 50 74 Z"/><ellipse class="rdzen" cx="50" cy="85" rx="1.2" ry="2.4"/></g>`
  + `</svg>`;
---
<Base title="kogni.pl" activePage="" description="kogni.pl: kognitywistyka na Uniwersytecie w Białymstoku. Czym jest to, czego doświadczasz?">
<canvas class="roj-plotno" aria-hidden="true"></canvas>
<canvas class="roj-plotno roj-iskra" aria-hidden="true"></canvas>
<main class="roj">
  <section class="roj-st lewo pierwszy" data-k="czesc">
    <div class="roj-t"><h1 class="roj-czesc">Cześć</h1></div>
  </section>
  <section class="roj-st lewo ciag" data-k="pytanie">
    <div class="roj-t">
      <p class="roj-duze" set:html={md(T.pytanie)} />
      <ul class="roj-lista">{T.punkty.map((t) => <li>{t}</li>)}</ul>
    </div>
  </section>
  <section class="roj-st lewo ciag" data-k="sieci">
    <div class="roj-t">
      <ul class="roj-sieci">{SIECI.map(([n, nazwa, zd], i) => <li class="roj-siec" data-n={n} style={'margin-top:' + ODSTEP[i]}><span style={'color:' + KOLOR[n]}>{nazwa}.</span> {zd}</li>)}</ul>
    </div>
  </section>
  <section class="roj-st lewo" data-k="zmiany">
    <div class="roj-t"><p class="roj-duze" set:html={md(T.zmiany)} /></div>
  </section>
  <section class="roj-st lepkie" data-k="zombie">
    <div class="roj-lepki">
      <div class="roj-t">
        <p class="roj-duze" set:html={md(T.zombie[0])} />
        <p set:html={md(T.zombie[1])} />
      </div>
      <div class="roj-sol">
        <div class="roj-chmura">{CHMURA.map((w, i) => <span class={'c' + i}>{w}</span>)}</div>
        <div class="roj-sol-p" set:html={postac('sol')} />
      </div>
    </div>
  </section>
  <section class="roj-st lewo" data-k="wiem">
    <div class="roj-t"><p class="roj-duze" set:html={md(T.wiem[0])} /><p set:html={md(T.wiem[1])} /></div>
  </section>
  <section class="roj-st lewo" data-k="ja">
    <div class="roj-t"><p class="roj-duze" set:html={md(T.ja[0])} /><p set:html={md(T.ja[1])} /></div>
  </section>
  <section class="roj-st srodek" data-k="doswiadcza">
    <div class="roj-t"><p class="roj-duze" set:html={md(T.dosw[0])} /><p set:html={md(T.dosw[1])} /></div>
  </section>
  <section class="roj-st poziom" data-k="osnowy" aria-label="Osnowy: socjologia, psychologia, biologia, fizyka">
    <div class="roj-lepki"><div class="roj-tor">
      <div class="roj-panel a">
        <div class="roj-gora">
          <p class="roj-duze">{T.badane}</p>
          {NAUKI.map(([n, o, z]) => <p class="roj-nauka"><span style={'color:' + KOL_OSN[o]}>{n}</span> {z}</p>)}
        </div>
      </div>
      <div class="roj-panel b">
        {GRUPY.map((g, i) => (
          <div class={'roj-grupa g' + i} style={'--k:' + g.kolor}>
            <div class="roj-slowa">{g.slowa.map((s, j) => <span style={slowoPoz(j, g.slowa.length)}>{s}</span>)}</div>
            <div class="roj-gp plonie" set:html={postac('b' + i, g.kolor)} />
          </div>
        ))}
      </div>
      <div class="roj-panel c">
        {GRUPY.map((g, i) => <div class={'roj-grupa koniec g' + i} style={'--k:' + g.kolor}><div class="roj-gp plonie" set:html={postac('c' + i, g.kolor)} /></div>)}
        <div class="roj-pchane">{GRUPY.map((g) => g.slowa.map((s) => <span style={'color:' + g.kolor}>{s}</span>))}</div>
      </div>
    </div>
    {OSNOWY.map(([n, c], i) => <span class={'roj-nitka n' + i} style={'color:' + c} aria-hidden="true">{n}</span>)}
    <a class="roj-ku-plotnu" href="/2026/" aria-label="Rocznik 2026: Płótno"></a>
    </div>
  </section>
  <section class="roj-st lewo kogni" data-k="kogni">
    <div class="roj-t">
      <p class="roj-duze" set:html={md('{{Kognitywistyka}}')} />
      <p>{T.kogni[0]}</p>
      <div class="roj-cien-w"><p>{T.kogni[1]}</p><div class="roj-cien" set:html={postac('cien')} /></div>
      <p class="roj-duze" set:html={md(T.sprobujmy)} />
    </div>
  </section>
  <section class="roj-st wiki" data-k="wiki" aria-label="kogniwiki">
    <div class="roj-t">
      {WIKI
        ? <a class="roj-wiki" href={WIKI}>kogni<span class="roj-wiki-kropka">.</span>pl/wiki</a>
        : <span class="roj-wiki">kogni<span class="roj-wiki-kropka">.</span>pl/wiki</span>}
    </div>
  </section>
</main>

<style is:global>
body:has(.roj){background:#000}
body:has(.roj) .rocznik-head,body:has(.roj) .site-footer{position:relative;z-index:1}
body:has(.roj) .site-footer::before{display:none}
.roj-plotno{position:fixed;inset:0;width:100vw;height:100vh;z-index:0;pointer-events:none}
.roj-plotno.roj-iskra{z-index:3}
.roj{position:relative;z-index:1;--kosc:#ece6da;--mgla:#b3aa9b;--zloto:#f0c060}
.roj-st{position:relative;min-height:100vh;display:flex;align-items:center;padding:12vh 56px 12vh 8vw}
.roj-st.lewo .roj-t{max-width:min(40vw,560px)}
.roj-st.srodek{justify-content:center;padding-left:56px}
.roj-st.srodek .roj-t{max-width:680px}
.roj-st.pierwszy{min-height:calc(100vh - 120px);align-items:flex-end;padding-top:0;padding-bottom:14vh}
/* Cześć, pytanie i sieci płyną jak jeden tekst */
.roj-st.ciag{min-height:0;padding-bottom:0}
.roj-st.ciag[data-k=pytanie]{padding-top:10vh}
.roj-st.ciag[data-k=sieci]{padding-top:9vh;padding-bottom:24vh}
.roj-t{opacity:0;transform:translateY(28px);transition:opacity .9s ease,transform .9s ease}
.roj-st.in .roj-t{opacity:1;transform:none}
.roj p,.roj h1,.roj ul{margin:0}
.roj-t p,.roj-lista li{font-family:var(--font-body);font-size:17px;line-height:1.9;color:var(--kosc);font-weight:300}
.roj-t > * + *{margin-top:1em}
.roj .roj-duze{font-family:var(--font-display);font-weight:400;font-size:clamp(28px,2.7vw,40px);line-height:1.2;letter-spacing:.005em;color:var(--zloto)}
.roj-t > .roj-duze{margin:.45em 0 .55em}
.roj-t > .roj-duze:first-child{margin-top:0}
.roj a{color:var(--kosc);text-decoration:none;border-bottom:1px solid rgba(240,192,96,.55)}
.roj a:hover{color:var(--zloto)}
.roj a:focus-visible{outline:2px solid var(--zloto);outline-offset:3px}
/* Cześć: przygaszone, dopóki iskra go nie oświetli */
.roj .roj-czesc{font-family:var(--font-display);font-weight:400;font-size:clamp(56px,6vw,96px);line-height:1;letter-spacing:.01em;color:var(--zloto);opacity:max(var(--min,.16),calc(.16 + var(--s,0) * .84));text-shadow:0 0 calc(var(--s,0) * 34px) rgba(240,192,96,calc(var(--s,0) * .7));transition:opacity .4s ease}
.roj .roj-czesc.lit{--min:.92}
.roj-lista{list-style:none;padding:0}
.roj-lista li{position:relative;padding-left:1.2em}
.roj-lista li::before{content:'';position:absolute;left:0;top:.86em;width:5px;height:5px;border-radius:50%;background:var(--zloto);opacity:.75}
/* sieci pojawiają się po kolei, gdy iskra je ogląda */
.roj-sieci{list-style:none;padding:0}
.roj-siec{font:300 18px/1.6 var(--font-body);color:var(--kosc);opacity:0;transform:translateY(10px);transition:opacity .6s ease,transform .6s ease}
.roj-siec.in{opacity:1;transform:none}
.roj-siec span{font-weight:400}
/* zombie i solipsysta: ekran lepki, postać odsłania iskra */
.roj-st.lepkie{display:block;height:210vh;padding:0}
.roj-lepki{position:sticky;top:0;height:100vh;overflow:hidden}
.roj-st.lepkie .roj-lepki{display:flex;align-items:center;padding:0 56px 0 8vw}
.roj-st.lepkie .roj-t{max-width:min(40vw,560px)}
.roj-sol{position:absolute;right:8vw;top:50%;transform:translateY(-46%);width:min(32vw,460px);height:66vh}
.roj-sol-p{position:absolute;left:50%;bottom:0;transform:translateX(-50%);height:54vh;aspect-ratio:100/220;opacity:0;transition:opacity 1.6s ease}
.roj-sol.widac .roj-sol-p{opacity:1}
.roj-chmura span{position:absolute;font:italic 400 clamp(17px,1.5vw,23px) var(--font-display);color:#d6cdbd;opacity:0;white-space:nowrap;transition:opacity 1.2s ease,text-shadow 1.2s ease}
.roj-chmura span.widac{opacity:.82;text-shadow:0 0 14px rgba(255,201,120,.3)}
.roj-chmura .c0{left:0;top:4%}.roj-chmura .c1{right:0;top:12%}.roj-chmura .c2{left:2%;top:34%}.roj-chmura .c3{right:6%;top:42%}
/* postać */
.postac{display:block;height:100%;width:auto;overflow:visible}
.postac .szata{fill:#151311;stroke:rgba(236,230,218,.09);stroke-width:.6}
.postac .faldy{fill:none;stroke:rgba(0,0,0,.6);stroke-width:1.3}
.postac .rekawy{fill:#0f0d0c;stroke:rgba(236,230,218,.06);stroke-width:.5}
.postac .swiatlo,.postac .poswiata{opacity:0;transition:opacity 1.2s ease}
.postac .kaptur-brzeg{fill:#0b0a09}
.postac .kaptur{fill:#000}
.postac .s1{stop-color:var(--swiatlo);stop-opacity:.5}.postac .s2{stop-color:var(--swiatlo);stop-opacity:.18}.postac .s3{stop-color:var(--swiatlo);stop-opacity:0}
.postac .g1{stop-color:var(--swiatlo);stop-opacity:.4}.postac .g3{stop-color:var(--swiatlo);stop-opacity:0}
.postac .swieca{fill:#d8cebb}
.postac .plomien{opacity:0;transform-box:view-box;transform-origin:50px 88px;transition:opacity .5s ease}
.postac .plomien path{fill:var(--swiatlo)}
.postac .rdzen{fill:#fff6e2}
.plonie .postac .swiatlo,.plonie .postac .poswiata{opacity:1}
.plonie .postac .plomien{opacity:1;animation:plomien 1.7s ease-in-out infinite}
@keyframes plomien{0%,100%{transform:scale(1,1) rotate(0)}25%{transform:scale(.93,1.09) rotate(-3deg)}50%{transform:scale(1.05,.94) rotate(2deg)}75%{transform:scale(.97,1.05) rotate(-1deg)}}
/* osnowy: u góry tekst i postacie, na dole nici */
.roj-st.poziom{display:block;height:440vh;padding:0}
.roj-tor{position:absolute;top:0;left:0;height:100%;width:300vw;display:flex;will-change:transform}
.roj-panel{position:relative;width:100vw;height:100%;overflow:hidden}
.roj-gora{position:absolute;left:clamp(30px,9vw,140px);top:7vh;max-width:min(880px,82vw)}
.roj-gora .roj-duze{font-size:clamp(28px,2.8vw,40px);margin-bottom:.45em}
.roj-nauka{font:italic 400 clamp(18px,1.5vw,23px)/1.45 var(--font-display);color:var(--kosc);opacity:0;transform:translateY(8px);transition:opacity .7s ease,transform .7s ease}
.roj-nauka + .roj-nauka{margin-top:.3em}
.roj-nauka.in{opacity:1;transform:none}
.roj-nauka span{font-weight:500}
.roj-grupa{position:absolute;top:4vh;height:46vh;width:20vw}
.roj-panel.b .g0{left:4vw}.roj-panel.b .g1{left:28vw}.roj-panel.b .g2{left:52vw}.roj-panel.b .g3{left:76vw}
.roj-gp{position:absolute;bottom:0;left:50%;transform:translateX(-50%);height:24vh;aspect-ratio:100/220}
.roj-slowa{position:absolute;left:0;right:0;top:0;height:21vh}
.roj-slowa span{position:absolute;transform:translate(-50%,-50%);font:300 clamp(12px,.95vw,15px) var(--font-body);letter-spacing:.02em;color:#cfc6b6;opacity:.2;white-space:nowrap;transition:opacity .5s ease,color .5s ease,text-shadow .5s ease}
.roj-slowa span.lit{opacity:1;color:var(--k);text-shadow:0 0 10px var(--k),0 0 22px var(--k)}
.roj-grupa.koniec{top:24vh;height:22vh;width:7vw}
.roj-panel.c .g0{left:34vw}.roj-panel.c .g1{left:41.5vw}.roj-panel.c .g2{left:49vw}.roj-panel.c .g3{left:56.5vw}
.roj-grupa.koniec .roj-gp{height:20vh;transform:translateX(calc(-50% + var(--px,0px))) rotate(var(--rot,0deg));transform-origin:50% 100%}
.roj-pchane{position:absolute;left:61.5vw;top:9vh;display:flex;flex-direction:column;gap:2px;will-change:transform}
.roj-pchane span{font:300 13px/1.32 var(--font-body);letter-spacing:.02em;white-space:nowrap;text-shadow:0 0 8px currentColor}
.roj-nitka{position:absolute;left:clamp(30px,9vw,140px);top:0;padding:3px 10px;background:#000;font:400 12px var(--font-body);letter-spacing:.08em;white-space:nowrap;transform:translateY(-50%);opacity:0;pointer-events:none;will-change:transform}
.roj-nitka.n0{top:56vh}.roj-nitka.n1{top:69vh}.roj-nitka.n2{top:82vh}.roj-nitka.n3{top:95vh}
.roj .roj-ku-plotnu{position:absolute;top:0;right:0;bottom:0;width:26vw;border:0;background:linear-gradient(90deg,rgba(240,192,96,0),rgba(240,192,96,0));transition:background .3s ease}
.roj .roj-ku-plotnu::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(240,192,96,0),rgba(240,192,96,.08));opacity:0;pointer-events:none}
.roj .roj-ku-plotnu.puls::after{animation:puls 2.6s ease-in-out infinite}
@keyframes puls{50%{opacity:1}}
.roj .roj-ku-plotnu:hover,.roj .roj-ku-plotnu:focus-visible{background:linear-gradient(90deg,rgba(240,192,96,0),rgba(240,192,96,.07));outline:0}
/* kognitywistyka i solipsysta w cieniu */
.roj-st.kogni .roj-t{max-width:min(46vw,640px)}
.roj-cien-w{position:relative}
.roj-cien{position:absolute;right:-190px;top:-30px;height:200px;opacity:0;transition:opacity 2.6s ease 1s}
.roj-st.in .roj-cien{opacity:.13}
/* kogni.pl/wiki: kropką staje się iskra */
.roj-st.wiki{min-height:80vh;justify-content:center;padding-left:56px}
.roj .roj-wiki{font-family:var(--font-display);font-weight:400;font-size:clamp(44px,5vw,76px);letter-spacing:.01em;color:var(--kosc);border:0}
.roj-js .roj-wiki-kropka{display:inline-block;width:.26em;height:.2em;vertical-align:baseline;color:transparent;overflow:hidden}
@media (max-width:760px){
  .roj-st{padding:52vh 20px 8vh 20px!important;align-items:flex-start;justify-content:flex-start!important}
  .roj-st.lewo .roj-t,.roj-st.kogni .roj-t,.roj-st.lepkie .roj-t{max-width:none}
  .roj-st.pierwszy{padding-top:calc(34vh + 33vw + 16px)!important;padding-bottom:0!important;align-items:flex-start}
  .roj-st.ciag[data-k=pytanie]{padding-top:14vh!important;padding-bottom:0!important}
  .roj-st.ciag[data-k=sieci]{padding-top:7vh!important;padding-bottom:20vh!important}
  .roj-st.poziom,.roj-st.lepkie{padding:0!important}
  .roj-st.lepkie .roj-lepki{padding:52vh 20px 0!important;align-items:flex-start}
  .roj-sol{left:50%;right:auto;top:6vh;transform:translateX(-50%);width:88vw;height:40vh}
  .roj-sol-p{height:34vh}
  .roj-chmura span{font-size:16px}
  .roj-st.poziom{height:380vh}
  .roj-st.srodek{padding-top:18vh!important}
  .roj-st.wiki{min-height:60vh;padding-top:24vh!important;justify-content:center!important}
  .roj-t p,.roj-lista li{font-size:15px}
  .roj-siec{font-size:15px}
  .roj-gora{top:5vh}
  .roj-gora .roj-duze{font-size:24px}
  .roj-nauka{font-size:16px;line-height:1.35}
  .roj-grupa{width:24vw;top:4vh}
  .roj-panel.b .g0{left:0}.roj-panel.b .g1{left:25vw}.roj-panel.b .g2{left:50vw}.roj-panel.b .g3{left:75vw}
  .roj-gp{height:17vh}
  .roj-slowa{height:24vh}
  .roj-slowa span{font-size:10px}
  .roj-panel.c .g0{left:6vw}.roj-panel.c .g1{left:17vw}.roj-panel.c .g2{left:28vw}.roj-panel.c .g3{left:39vw}
  .roj-grupa.koniec .roj-gp{height:15vh}
  .roj-pchane{left:52vw;top:6vh}
  .roj-pchane span{font-size:10px;line-height:1.25}
  .roj .roj-ku-plotnu{width:18vw}
  .roj-cien{right:-4px;top:-70px;height:110px}
  .roj-st.in .roj-cien{opacity:.1}
}
