.roj-lot{position:fixed;left:0;top:0;z-index:2;font:500 17px var(--font-body);white-space:nowrap;opacity:0;pointer-events:none;will-change:transform,opacity}
.roj .roj-ku-plotnu{position:absolute;top:0;right:0;bottom:0;width:26vw;border:0;background:linear-gradient(90deg,rgba(240,192,96,0),rgba(240,192,96,0));transition:background .3s ease}
