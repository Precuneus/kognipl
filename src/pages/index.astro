.postac .szata{fill:#000;stroke:var(--kontur);stroke-width:1.1;vector-effect:non-scaling-stroke}
.postac .linie{fill:none;stroke:var(--kontur);stroke-width:.9;vector-effect:non-scaling-stroke;opacity:.65}
.postac .twarz{fill:#000;stroke:var(--kontur);stroke-width:.9;vector-effect:non-scaling-stroke}
