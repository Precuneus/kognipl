---
import Base from '../layouts/Base.astro';
import R from '../rocznik/2026/rocznik.json';

// Strona startowa: ekrany przewijane nad rojem cząstek z masek sieci. Złote zdania duże, białe opisy małe.
// {{słowo}} to miejsce, na którym staje iskra (kropka z logo, która wędruje z czytelnikiem); {{słowo|klasa}} dokłada klasę.
const WIKI = Object.keys(import.meta.glob('./wiki/**/*.astro')).length > 0 ? '/wiki/' : '';
const md = (t) => t.replace(/\{\{([^}|]+)(?:\|([^}]+))?\}\}/g, (_, w, k) => '<span class="iskra-cel' + (k ? ' ' + k : '') + '">' + w + '</span>');
const T = {
  pytanie: 'Czym jest to, czego {{doświadczasz}}?',
  akt: 'Doświadczasz {{aktywności}} swoich własnych sieci mózgowych.',
  zmiany: 'Zmiany struktury mózgu (np. degeneracje, lezje, uszkodzenia) i zmiany funkcjonowania struktur między sobą (np. substancje psychoaktywne, uzależnienia, nauka, rozwój) zmieniają, czego doświadczasz.',
  zombie: ['Jesteś człowiekiem, prawda? Czy {{zombie}}?', 'Założę, że człowiekiem i też doświadczasz, jak ja. Ale nie mogę tego wiedzieć.'],
  wiem: ['Wiem tylko tyle, ile się nauczyłem od {{środowiska}}, w którym się urodziłem.', 'Doświadczam Modeli Mentalnych, które jednocześnie są moją aktywnością biologiczną.'],
  ja: ['Ale... "{{ja}}" to też Model Mentalny', 'Model "ja" zmienia się w czasie,  Zmienia się płynnie (nauka, dryfowanie) i gwałtownie (szok, przeskok). "Ja" to Statek Tezeusza strukturalnie i funkcjonalnie połączonych komórek.'],
  dysc: ['Dyscypliny się {{doświadczają}}.', '[[Socjologia]], [[psychologia]], [[biologia]], [[fizyka]]... Często ignorują się wzajemnie. Jakby nie istniały.'],
  dosw: ['{{Doświadcza}} się.', 'Skoro podmiot i treść doświadczenia się zmieniają to zostaje samo doświadczenie. Doświadcza się. Swiat się doświadcza, ciało się doświadcza, ja się doświadcza.'],
  kogni: [
    'W zamyśle inicjatorów, powinna być to interdyscyplinarna nauka o umyśle, adresująca najgłębsze zagadki doświadczanej rzeczywistości. Doświadcza się Model Mentalny obiektywnego świata z jego mechanikami. Mechaniki doświadczają się, a potem doświadcza się ich wytłumaczenie. W zależności od czasów, biologia żeglarza i fizyka wzburzonego morza wytłumaczy się gniewem Posejdona, albo meteorologią. Czasem wytłumaczenie się interakcji biologii z fizyką i chemią jest tak trafne, że doświadcza się na przykład wyzdrowienia.',
    'Tylko wciąż... Wytłumacza się kawałek skały krążący wokół reaktora fuzyjnego we wszechświecie, który powstał z niczego 13,8 mld lat temu. Doświadcza się głęboka subiektywność, czasem dzielona z kimś tak bardzo, że wydaje się jakby mogła być intersubiektywna. Tyle rzeczy, które się doświadczają... nie wytłumacza się.',
  ],
  sprobujmy: 'Spróbujmy je {{wytłumaczyć|hura}}.',
};
// Sieci w kolejności od receptorów; numer to etykieta w masce BraiNets_MASKS.
const SIECI = [
  [2, 'Sieć wzrokowa'],
  [3, 'Sieć czuciowo-ruchowa'],
  [4, 'Sieć grzbietowa uwagi'],
  [8, 'Sieć brzuszna uwagi'],
  [6, 'Sieć istotności'],
  [5, 'Sieć kontroli'],
  [7, 'Sieć domyślna'],
];
// odstępy między sieciami: nieregularny rytm, jak w ciągłym tekście
const ODSTEP = ['0', '6vh', '11vh', '4vh', '9vh', '14vh', '8vh'];
const KOLOR = { 2: '#ee6b6f', 3: '#f9d780', 4: '#e58e76', 5: '#f69959', 6: '#a9b26f', 7: '#bb6fb2', 8: '#6fb3a8' };
const OSNOWY = [['socjologia', '#8fa274'], ['psychologia', '#5f9a96'], ['biologia', '#6585b0'], ['fizyka', '#8577b3']];
const KOL_OSN = Object.fromEntries(OSNOWY);
// mnich to badacz swojej dyscypliny
const BADACZ = { socjologia: 'socjolog', psychologia: 'psycholog', biologia: 'biolog', fizyka: 'fizyk' };
// nazwy dyscyplin w tekście: każda w kolorze swoich osnów; przy przewijaniu lecą pod swoich mnichów
const dysc = (t: string) => { let k = 0; return t.replace(/\[\[([^\]]+)\]\]/g, (_, w) => { const i = k++; return '<span class="roj-dysc" data-k="' + i + '" style="color:' + OSNOWY[i][1] + '">' + w + '</span>'; }); };
// Słowa, które oświetlają postacie: osnowy Płótna, każda grupa w swoim kolorze.
const GRUPY = R.grupy.map((g) => ({ nazwa: g.nazwa, kolor: KOL_OSN[g.nazwa], slowa: g.osnowy.map((o) => o.nazwa) }));
const CHMURA = ['mózg w naczyniu', 'matrix', 'zły demon Kartezjusza', 'sen Zhuangzi', 'problem innych umysłów', 'filozoficzne zombie'];
// osnowy: wysokość każdej nici (vh) i miejsce jej mnicha (vw)
const YN_VH = [30, 48, 66, 84], MNICH_X = [17, 23, 11, 20];
// słowa osnów na różnych wysokościach nad swoją osnową: 24 px plus 0 do 10 vh, rozrzucone, a nie po kolei
const WYS = (k, j) => (((j * 37 + k * 23) % 11) / 10 * 10).toFixed(1);
// Postać w habicie z kapturem, bez twarzy, ze świecą: sam kontur, obrócona o mniej więcej 50 stopni w lewo.
// Płomień i światło w kolorze --swiatlo.
const SYLWETKA = 'M50 6 C62 5 73 12 76 26 C78 38 77 48 80 58 C86 80 88 120 90 160 C91 185 92 205 93 216 C75 221 45 222 21 217 C22 180 25 140 26 110 C26 90 28 70 33 56 C29 48 28 38 30 28 C32 16 40 8 50 6 Z';
const postac = (id, swiatlo = '#ffc978') => `<svg class="postac" viewBox="0 0 100 222" style="--swiatlo:${swiatlo}" aria-hidden="true"><defs>`
  + `<radialGradient id="ps${id}" cx="34" cy="90" r="110" gradientUnits="userSpaceOnUse"><stop offset="0" class="s1"/><stop offset=".32" class="s2"/><stop offset="1" class="s3"/></radialGradient>`
  + `<radialGradient id="pg${id}" cx="34" cy="86" r="30" gradientUnits="userSpaceOnUse"><stop offset="0" class="g1"/><stop offset="1" class="g3"/></radialGradient></defs>`
  + `<path class="szata" d="${SYLWETKA}"/>`
  + `<path class="swiatlo" fill="url(#ps${id})" d="${SYLWETKA}"/>`
  + `<path class="linie" d="M52 8 C56 20 58 34 62 50 M33 56 C45 62 66 62 80 58 M77 62 C73 84 61 99 45 104 M81 80 C77 98 65 110 47 112 M60 122 C62 152 64 186 66 218 M45 120 C43 152 41 186 39 219"/>`
  + `<ellipse class="twarz" cx="39" cy="36" rx="7.5" ry="12" transform="rotate(-12 39 36)"/>`
  + `<ellipse class="linie" cx="42" cy="108" rx="5" ry="6.5" transform="rotate(-25 42 108)"/>`
  + `<circle class="poswiata" cx="34" cy="86" r="30" fill="url(#pg${id})"/>`
  + `<rect class="swieca" x="31.5" y="88" width="5.5" height="15" rx="1"/>`
  + `<g class="plomien"><path d="M34.25 76 C37.25 81 38.25 85 36.75 88.5 C35.75 90.5 32.75 90.5 31.75 88.5 C30.25 85 31.25 81 34.25 76 Z"/><ellipse class="rdzen" cx="34.25" cy="87" rx="1.2" ry="2.4"/></g>`
  + `</svg>`;
---
<Base title="kogni.pl" activePage="" description="kogni.pl: kognitywistyka na Uniwersytecie w Białymstoku. Czym jest to, czego doświadczasz?">
<canvas class="roj-plotno" aria-hidden="true"></canvas>
<canvas class="roj-plotno roj-iskra" aria-hidden="true"></canvas>
<main class="roj">
  <section class="roj-st lewo pierwszy" data-k="czesc">
    <div class="roj-t"><h1 class="roj-czesc">Cześć!</h1></div>
  </section>
  <section class="roj-st lewo ciag" data-k="pytanie">
    <div class="roj-t">
      <p class="roj-duze" set:html={md(T.pytanie)} />
      <p><span class="roj-zrodlo">{T.akt.replace(/\{\{|\}\}/g, '')}</span> {T.zmiany}</p>
    </div>
  </section>
  <section class="roj-st lewo ciag" data-k="naglowek">
    <div class="roj-t"><p class="roj-duze roj-naglowek" set:html={md(T.akt)} /></div>
  </section>
  <section class="roj-st lewo ciag" data-k="sieci">
    <div class="roj-t">
      <ul class="roj-sieci">{SIECI.map(([n, nazwa], i) => <li class="roj-siec" data-n={n} data-nazwa={nazwa.replace(/^Sieć\s+/, '')} style={'margin-top:' + ODSTEP[i]}><span class="roj-ukryte">{nazwa}</span></li>)}</ul>
    </div>
  </section>
  <section class="roj-st lepkie" data-k="zombie">
    <div class="roj-lepki">
      <div class="roj-t">
        <p class="roj-duze" set:html={md(T.zombie[0])} />
        <p set:html={md(T.zombie[1])} />
        <div class="roj-sol">
          <div class="roj-chmura">{CHMURA.map((w, i) => <span class={'c' + i} style={'--i:' + i}>{w}</span>)}</div>
          <div class="roj-sol-p"><div class="roj-sol-snop"></div><div class="roj-sol-obrot" set:html={postac('sol')} /><span class="roj-sol-nazwa">solipsysta</span></div>
        </div>
      </div>
    </div>
  </section>
  <section class="roj-st lewo ciag" data-k="wiem">
    <div class="roj-t"><p class="roj-duze" set:html={md(T.wiem[0])} /><p set:html={md(T.wiem[1])} /></div>
  </section>
  <section class="roj-st lewo ciag" data-k="ja">
    <div class="roj-t"><p class="roj-duze" set:html={md(T.ja[0])} /><p set:html={md(T.ja[1])} /></div>
  </section>
  <section class="roj-st srodek ciag" data-k="doswiadcza">
    <div class="roj-t"><p class="roj-duze" set:html={md(T.dosw[0])} /><p set:html={md(T.dosw[1])} /></div>
  </section>
  <section class="roj-st srodek ciag" data-k="dyscypliny">
    <div class="roj-t"><p class="roj-duze" set:html={md(T.dysc[0])} /><p set:html={dysc(T.dysc[1])} /></div>
  </section>
  <section class="roj-st poziom" data-k="osnowy" aria-label="Osnowy: socjologia, psychologia, biologia, fizyka">
    <div class="roj-lepki"><div class="roj-tor">
      {GRUPY.map((g, k) => g.slowa.map((w, j) => <span class="roj-slowo-osn" data-k={k} style={'--k:' + g.kolor + ';left:' + (35 + 240 * (j + .5) / g.slowa.length).toFixed(1) + 'vw;top:calc(' + YN_VH[k] + 'vh - 24px - ' + WYS(k, j) + 'vh)'}>{[...w].map((z) => z === ' ' ? ' ' : <span class="zn">{z}</span>)}</span>))}
    </div>
    {GRUPY.map((g, k) => <div class="roj-mnich" data-k={k} style={'left:' + MNICH_X[k] + 'vw;top:calc(' + YN_VH[k] + 'vh - var(--mh))'}><div class="roj-mnich-c plonie" set:html={postac('m' + k, g.kolor)} /><span class="roj-mnich-nazwa" style={'color:' + g.kolor}>{BADACZ[g.nazwa] || g.nazwa}</span></div>)}
    <a class="roj-ku-plotnu" href="/2026/" aria-label="Rocznik 2026: Płótno"></a>
    </div>
  </section>
  <section class="roj-st lewo kogni" data-k="kogni">
    <div class="roj-t">
      <p class="roj-duze" set:html={md('{{Kognitywistyka}}')} />
      <p>{T.kogni[0]}</p>
      <div class="roj-cien-w"><p>{T.kogni[1]}</p><div class="roj-cien" set:html={postac('cien')} /></div>
      <p class="roj-duze" set:html={md(T.sprobujmy)} />
    </div>
  </section>
  <section class="roj-st wiki" data-k="wiki" aria-label="kogniwiki">
    <div class="roj-t">
      {WIKI
        ? <a class="roj-wiki" href={WIKI}>kogn<span class="roj-wiki-i">ı<span class="roj-wiki-kropka"></span></span>.pl/wiki</a>
        : <span class="roj-wiki">kogn<span class="roj-wiki-i">ı<span class="roj-wiki-kropka"></span></span>.pl/wiki</span>}
    </div>
  </section>
  <div class="roj-loty" aria-hidden="true">{OSNOWY.map(([n, c]) => <span class="roj-lot" style={'color:' + c}></span>)}</div>
</main>

<style is:global>
body:has(.roj){background:#000}
body:has(.roj) .rocznik-head,body:has(.roj) .site-footer{position:relative;z-index:1}
body:has(.roj) .site-footer::before{display:none}
.roj-plotno{position:fixed;inset:0;width:100vw;height:100vh;z-index:0;pointer-events:none}
.roj-plotno.roj-iskra{z-index:3}
.roj{position:relative;z-index:1;--kosc:#ece6da;--mgla:#b3aa9b;--zloto:#f0c060}
.roj-st{position:relative;min-height:100vh;display:flex;align-items:center;padding:12vh 56px 12vh 8vw}
.roj-st.lewo .roj-t{max-width:min(40vw,560px)}
.roj-st.srodek{justify-content:center;padding-left:56px}
.roj-st.srodek .roj-t{max-width:680px}
.roj-st.pierwszy{min-height:calc(100vh - 120px);align-items:flex-end;padding-top:0;padding-bottom:14vh}
/* Cześć, pytanie i sieci płyną jak jeden tekst */
.roj-st.ciag{min-height:0;padding-bottom:0}
.roj-st.ciag[data-k=pytanie]{padding-top:10vh}
.roj-st.ciag[data-k=naglowek]{padding-top:9vh}
.roj-st.ciag[data-k=sieci]{padding-top:9vh;padding-bottom:24vh}
/* zdanie z akapitu: iskra je złoci, ono rozpada się na punkty roju, które układają się w nagłówek */
.roj .roj-naglowek{opacity:0}
.roj .roj-zrodlo{transition:color .8s ease,text-shadow .8s ease}
.roj .roj-zrodlo.zloty{color:var(--zloto);text-shadow:0 0 12px rgba(240,192,96,.45)}
/* po solipsyście tekst płynie dalej z krótszymi odstępami */
.roj-st.ciag[data-k=wiem]{padding-top:0;margin-top:-33vh}
.roj-st.ciag[data-k=ja]{padding-top:14.3vh}
.roj-st.ciag[data-k=doswiadcza]{padding-top:10.4vh;padding-bottom:0}
.roj-st.ciag[data-k=dyscypliny]{padding-top:11.7vh;padding-bottom:22vh}
.roj .roj-dysc{font-weight:500}
.roj-t{opacity:0;transform:translateY(28px);transition:opacity .9s ease,transform .9s ease}
.roj-st.in .roj-t{opacity:1;transform:none}
.roj p,.roj h1,.roj ul{margin:0}
.roj-t p,.roj-lista li{font-family:var(--font-body);font-size:17px;line-height:1.9;color:var(--kosc);font-weight:300}
.roj-t > * + *{margin-top:1em}
/* od „Jesteś człowiekiem” dalej akapity mają o 30% więcej powietrza (jego słowo, 2026-10-19) */
.roj-st:is([data-k=zombie],[data-k=wiem],[data-k=ja],[data-k=doswiadcza],[data-k=dyscypliny],[data-k=kogni]) .roj-t > * + *{margin-top:1.3em}
.roj .roj-duze{font-family:var(--font-display);font-weight:400;font-size:clamp(28px,2.7vw,40px);line-height:1.2;letter-spacing:.005em;color:var(--zloto)}
.roj-t > .roj-duze{margin:.45em 0 .55em}
.roj-t > .roj-duze:first-child{margin-top:0}
.roj a{color:var(--kosc);text-decoration:none;border-bottom:1px solid rgba(240,192,96,.55)}
.roj a:hover{color:var(--zloto)}
.roj a:focus-visible{outline:2px solid var(--zloto);outline-offset:3px}
/* Cześć: przygaszone, dopóki iskra go nie oświetli */
.roj .roj-czesc{font-family:var(--font-display);font-weight:400;font-size:clamp(56px,6vw,96px);line-height:1;letter-spacing:.01em;color:var(--zloto);opacity:max(var(--min,.16),calc(.16 + var(--s,0) * .84));text-shadow:0 0 calc(var(--s,0) * 34px) rgba(240,192,96,calc(var(--s,0) * .7));transition:opacity .4s ease}
.roj .roj-czesc.lit{--min:.92}
/* sieci pojawiają się po kolei, gdy iskra je ogląda */
.roj-sieci{list-style:none;padding:0}
.roj-siec{height:1px}
.roj-ukryte{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
/* zombie i solipsysta: ekran lepki, postać odsłania iskra */
.roj-st.lepkie{display:block;height:115vh;padding:0}
.roj-lepki{position:sticky;top:0;height:100vh;overflow:hidden}
.roj-st.lepkie .roj-lepki{display:flex;align-items:center;padding:0 56px 0 8vw}
.roj-st.lepkie .roj-t{max-width:min(40vw,560px)}
.roj-st.lepkie .roj-t{position:relative}
.roj-sol{position:absolute;left:calc(100% + 20px);top:50%;transform:translateY(-50%);width:400px;height:34vh;margin:0}
.roj-sol-p{position:absolute;left:2%;bottom:4vh;height:15vh;aspect-ratio:100/222;opacity:0;transition:opacity 1.6s ease}
.roj-sol-obrot{height:100%;transform:scaleX(-1)}
/* snop świecy w prawo, od płomienia (66% szerokości po odbiciu, 39% wysokości); skrypt wodzi nim w górę i w dół */
.roj-sol-snop{position:absolute;left:66%;top:calc(39% - 80px);width:min(340px,80vw);height:160px;transform-origin:0 50%;will-change:transform;clip-path:polygon(0 50%,100% 0,100% 100%);background:radial-gradient(ellipse 100% 70% at 0 50%,rgba(255,201,120,.24),rgba(255,201,120,0) 75%);opacity:0;transition:opacity 1.2s ease;pointer-events:none}
.roj-sol.plonie .roj-sol-snop{opacity:1}
.roj-sol.widac .roj-sol-p{opacity:1}
.roj-sol-nazwa{position:absolute;left:50%;top:calc(100% + 6px);transform:translateX(-50%);font:400 17px var(--font-display);letter-spacing:.04em;color:var(--zloto);white-space:nowrap}
.roj-chmura span{position:absolute;font:italic 400 15px var(--font-display);color:#d6cdbd;opacity:0;white-space:nowrap;transition:opacity .6s ease,color .6s ease,text-shadow .6s ease}
.roj-chmura span.widac{opacity:.45}
.roj-chmura span.widac.lit{opacity:.95;color:#ffe2a8;text-shadow:0 0 10px rgba(255,201,120,.55)}
/* słowa po prawej solipsysty, w wachlarzu jego snopu */
.roj-chmura .c0{left:32%;top:8%}.roj-chmura .c1{left:46%;top:23%}.roj-chmura .c2{left:28%;top:38%}.roj-chmura .c3{left:44%;top:53%}.roj-chmura .c4{left:30%;top:68%}.roj-chmura .c5{left:42%;top:83%}
/* postać: kontur */
.postac{display:block;height:100%;width:auto;overflow:visible;--kontur:rgba(236,230,218,.5)}
.postac .szata{fill:#000;stroke:var(--kontur);stroke-width:1.1;vector-effect:non-scaling-stroke}
.postac .linie{fill:none;stroke:var(--kontur);stroke-width:.9;vector-effect:non-scaling-stroke;opacity:.65}
.postac .twarz{fill:#000;stroke:var(--kontur);stroke-width:.9;vector-effect:non-scaling-stroke}
.postac .swiatlo,.postac .poswiata{opacity:0;transition:opacity 1.2s ease}
.postac .s1{stop-color:var(--swiatlo);stop-opacity:.5}.postac .s2{stop-color:var(--swiatlo);stop-opacity:.18}.postac .s3{stop-color:var(--swiatlo);stop-opacity:0}
.postac .g1{stop-color:var(--swiatlo);stop-opacity:.4}.postac .g3{stop-color:var(--swiatlo);stop-opacity:0}
.postac .swieca{fill:#d8cebb}
.postac .plomien{opacity:0;transform-box:view-box;transform-origin:34.25px 90px;transition:opacity .5s ease}
.postac .plomien path{fill:var(--swiatlo)}
.postac .rdzen{fill:#fff6e2}
.plonie .postac .swiatlo{opacity:.6}.plonie .postac .poswiata{opacity:1}
.plonie .postac .plomien{opacity:1;animation:plomien 1.7s ease-in-out infinite}
@keyframes plomien{0%,100%{transform:scale(1,1) rotate(0)}25%{transform:scale(.93,1.09) rotate(-3deg)}50%{transform:scale(1.05,.94) rotate(2deg)}75%{transform:scale(.97,1.05) rotate(-1deg)}}
/* osnowy: u góry tekst i postacie, na dole nici */
.roj-st.poziom{display:block;height:440vh;padding:0}
.roj-tor{position:absolute;top:0;left:0;height:100%;width:300vw;display:flex;will-change:transform}
.roj-slowo-osn{position:absolute;transform:translateX(-50%);font:300 14px var(--font-body);letter-spacing:.02em;color:#cfc6b6;white-space:nowrap;opacity:0;transition:color .4s ease,text-shadow .4s ease;will-change:transform,opacity}
.roj-slowo-osn.lit{color:var(--k);text-shadow:0 0 10px var(--k),0 0 20px var(--k)}
.roj-slowo-osn.u-plotna{cursor:pointer}
.roj-slowo-osn .zn{display:inline-block}
.roj-st.poziom{--mh:15vh}
.roj-mnich{position:absolute;height:var(--mh);aspect-ratio:100/222;transform-origin:50% 100%;will-change:transform,opacity}
.roj-mnich-c{height:100%;transform:scaleX(-1)}
.roj-mnich-nazwa{position:absolute;left:50%;top:calc(100% + 8px);transform:translateX(-50%);font:400 13px var(--font-body);letter-spacing:.06em;white-space:nowrap;opacity:0;text-shadow:0 0 4px #000,0 0 10px #000}
.roj-lot{position:fixed;left:0;top:0;z-index:2;font:500 17px var(--font-body);white-space:nowrap;opacity:0;pointer-events:none;will-change:transform,opacity}
.roj .roj-ku-plotnu{position:absolute;top:0;right:0;bottom:0;width:26vw;border:0;background:linear-gradient(90deg,rgba(240,192,96,0),rgba(240,192,96,0));transition:background .3s ease}
.roj .roj-ku-plotnu::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(240,192,96,0),rgba(240,192,96,.08));opacity:0;pointer-events:none}
.roj .roj-ku-plotnu.puls::after{animation:puls 2.6s ease-in-out infinite}
@keyframes puls{50%{opacity:1}}
.roj .roj-ku-plotnu:hover,.roj .roj-ku-plotnu:focus-visible{background:linear-gradient(90deg,rgba(240,192,96,0),rgba(240,192,96,.07));outline:0}
/* kognitywistyka i solipsysta w cieniu */
.roj-st.kogni .roj-t{max-width:min(46vw,640px)}
.roj-cien-w{position:relative}
.roj-cien{position:absolute;right:-150px;top:-10px;height:15vh;opacity:0;transition:opacity 2.6s ease 1s}
.roj-st.in .roj-cien{opacity:.3}
/* kogni.pl/wiki: kropką staje się iskra */
.roj-st.wiki{min-height:80vh;justify-content:center;padding-left:56px}
.roj .roj-wiki{font-family:var(--font-display);font-weight:500;font-size:clamp(44px,5vw,76px);letter-spacing:.06em;line-height:1;color:#e2ddd4;border:0}
/* kropka nad ı jak w logo; z JS rysuje ją iskra */
.roj-wiki-i{position:relative;display:inline-block}
.roj-wiki-kropka{position:absolute;left:calc(50% - .19em);top:-.07em;width:.26em;height:.26em;border-radius:50%;background:#f0c060;box-shadow:0 0 0 .075em #0e0d0b,0 0 0 .12em rgba(240,192,96,.9),0 0 .45em .14em rgba(240,192,96,.45)}
.roj-js .roj-wiki-kropka{opacity:0}
@media (max-width:760px){
  .roj-st{padding:52vh 20px 8vh 20px!important;align-items:flex-start;justify-content:flex-start!important}
