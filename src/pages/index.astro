---
import Base from '../layouts/Base.astro';
import { cardByName, slugify } from '../rocznik/data.js';

// Strona startowa: ekrany przewijane, na każdym jedno zdanie akapitu duże, reszta mała; na końcu kropka do kogniwiki.
// [[Tytuł karty|słowa]] linkuje do karty; link działa, gdy karta ma stronę (karta Rocznika 2026,
// karta kogniwiki, gdy istnieje src/pages/wiki/), inaczej słowo zostaje zwykłym tekstem. Kropka linkuje pod tym samym warunkiem.
const WIKI = Object.keys(import.meta.glob('./wiki/**/*.astro')).length > 0 ? '/wiki/' : '';
const kartaUrl = (t) => cardByName(t)?.url || (WIKI ? WIKI + slugify(t) + '/' : '');
// {{słowo}} to miejsce, na którym staje iskra (kropka z logo, która wędruje z czytelnikiem).
const md = (t) => t.replace(/\{\{([^}]+)\}\}/g, '<span class="iskra-cel">$1</span>').replace(/\[\[([^|\]]+)(?:\|([^\]]+))?\]\]/g, (_, k, w) => {
  const u = kartaUrl(k);
  return u ? '<a href="' + u + '">' + (w || k) + '</a>' : (w || k);
});
// Ekrany: k = stan roju; tekst: lista [duże?, treść].
const EKRANY = [
  { k: 'mozg', uklad: 'lewo', tekst: [
    [true, 'Kognitywistyka bada {{poznanie}}: jak organizmy i sztuczne systemy odbierają świat, uczą się i działają.'],
    [false, 'Pod tą nazwą mieszczą się różne programy badawcze. [[Podejście obliczeniowe]] opisuje umysł jako przetwarzanie informacji, tym samym językiem w mózgu i w komputerze. [[Poznanie ucieleśnione|Podejście ucieleśnione]] rozciąga poznanie na ciało, otoczenie i działanie organizmu. [[Neuronauka poznawcza]] szuka w aktywności mózgu mechanizmów myślenia i zachowania.'],
  ] },
  { k: 'wyspy', uklad: 'lewo', tekst: [
    [true, 'Niestety, te programy rzadko prowadzą ze sobą {{dialog}}, każdy opiera się na własnych, często różnie rozumianych definicjach, a dziedzina od dekad trwa w [[Kryzys kognitywistyki|kryzysie]].'],
  ] },
  { k: 'twarz', uklad: 'lewo dlugi', tekst: [
    [false, 'Na tej stronie przyjmuję jedno z możliwych rozumień. Szukam w nim spójnego szkieletu, który mógłby opisać poznanie. Doświadczasz znaczenia czytanych słów, a Twoje doświadczenie może być zmierzone jako aktywność Twojego mózgu.'],
    [true, '{{Doświadczenie}} to aktywność biologiczna organizmu.', 'zl'],
    [false, 'Na przykład rozpoznawanie twarzy bliskiej osoby to aktywność sieci skupionej wokół prawego zakrętu wrzecionowatego. Po uszkodzeniu tej sieci twarz zostaje w strumieniu Twojego doświadczenia jako twarz, ale już niczyja: to [[Prozopagnozja|prozopagnozja]].'],
  ] },
  { k: 'jest', uklad: 'srodek', tekst: [
    [false, 'Moim punktem startowym jest doświadczenie. Tekst, znaczenie, emocja, spojrzenie w oczy, smak dojrzałego mango, głos bliskiej osoby. Doświadczenie... jest. A jednocześnie ciągle się zmienia, to proces, przepływ [[Bioinformacja|bioinformacji]] między miliardami rezonujących ze sobą komórek, które identyfikuję ze swoim ciałem i ze sobą.'],
    [true, 'Startując od {{doświadczenia}} z jednej strony i od biologii z drugiej, szukam mechanizmów opisujących, w jaki dokładnie sposób doświadczenie to aktywność biologiczna.'],
  ] },
];
const OSNOWY = [['socjologia', '#8fa274'], ['psychologia', '#5f9a96'], ['biologia', '#6585b0'], ['fizyka', '#8577b3']];
const PANELE = [
  { duze: 'Socjologia, psychologia, biologia i fizyka to soczewki, przez które od narodzin kształtują się moje Modele Mentalne.', nici: [
    'Wchłaniam wzorce kulturowe: język, zwyczaje i wartości mojej wspólnoty.',
    'Uczę się rozumieć siebie i innych.',
    'Moje ciało rośnie, a sieci mózgu dojrzewają w kontakcie ze światem.',
    'Uczę się nawigować swoim biologicznym ciałem w fizycznej przestrzeni.',
  ] },
  { duze: 'Te soczewki opisują to samo doświadczenie, więc kognitywistyka może je połączyć.', nici: [
    'Rozmowa z bliską osobą toczy się w języku, którego nauczyła mnie wspólnota.',
    'Słuchając, buduję predykcje o jej myślach i uczuciach.',
    'Ta rozmowa to aktywność moich sieci mózgu, od kory słuchowej po sieć domyślną.',
    'Jej głos to fala ciśnienia powietrza, którą receptory w uchu przetwarzają w bioinformację.',
  ] },
];
---
<Base title="kogni.pl" activePage="" description="kogni.pl: kognitywistyka na Uniwersytecie w Białymstoku. Doświadczenie to aktywność biologiczna organizmu.">
<canvas class="roj-plotno" aria-hidden="true"></canvas>
<main class="roj">
  {EKRANY.map((e, i) => (
    <section class={'roj-st ' + e.uklad + (i === 0 ? ' pierwszy' : '')} data-k={e.k}>
      <div class="roj-t">
        {e.tekst.map(([duze, t, kl]) => duze
          ? (i === 0 ? <h1 class="roj-duze" set:html={md(t)} /> : <p class={'roj-duze' + (kl ? ' ' + kl : '')} set:html={md(t)} />)
          : <p set:html={md(t)} />)}
      </div>
    </section>
  ))}
  <section class="roj-st poziom" data-k="osnowy" aria-label="Osnowy: socjologia, psychologia, biologia, fizyka">
    <div class="roj-lepki"><div class="roj-tor">
      {PANELE.map((p) => (
        <div class="roj-panel">
          <p class="roj-duze">{p.duze}</p>
          {p.nici.map((t, i) => <p class={'roj-nic n' + i}>{t}</p>)}
        </div>
      ))}
    </div>
    {OSNOWY.map(([n, c], i) => <span class={'roj-nitka n' + i} style={'color:' + c} aria-hidden="true">{n}</span>)}
    <a class="roj-ku-plotnu" href="/2026/" aria-label="Rocznik 2026: Płótno"></a>
    </div>
  </section>
  <section class="roj-st kropka" data-k="kropka" aria-label="kogniwiki">
    <div class="roj-lepki">
      {WIKI
        ? <a class="roj-kropka" href={WIKI}><span class="roj-kropka-nazwa">kogniwiki</span></a>
        : <span class="roj-kropka"><span class="roj-kropka-nazwa">kogniwiki</span></span>}
    </div>
  </section>
</main>

<style is:global>
body:has(.roj){background:#000}
body:has(.roj) .rocznik-head,body:has(.roj) .site-footer{position:relative;z-index:1}
body:has(.roj) .site-footer::before{display:none}
.roj-plotno{position:fixed;inset:0;width:100vw;height:100vh;z-index:0;pointer-events:none}
.roj{position:relative;z-index:1;--kosc:#ece6da;--mgla:#b3aa9b;--zloto:#f0c060}
.roj-st{min-height:100vh;display:flex;align-items:center;padding:12vh 56px 12vh 8vw}
.roj-st.lewo .roj-t{max-width:min(40vw,560px)}
.roj-st.srodek{justify-content:center;padding-left:56px}
.roj-st.srodek .roj-t{max-width:680px}
.roj-st.pierwszy{min-height:calc(100vh - 120px);padding-top:0;padding-bottom:4vh}
.roj-st.dlugi{min-height:150vh}
.roj-t{opacity:0;transform:translateY(28px);transition:opacity .9s ease,transform .9s ease}
.roj-st.in .roj-t{opacity:1;transform:none}
.roj p,.roj h1{margin:0}
.roj-t p{font-family:var(--font-body);font-size:17px;line-height:1.9;color:var(--mgla);font-weight:300}
.roj-t > * + *{margin-top:1em}
.roj .roj-duze{font-family:var(--font-display);font-weight:400;font-size:clamp(28px,2.7vw,40px);line-height:1.2;letter-spacing:.005em;color:var(--zloto)}
.roj-t > .roj-duze{margin:.45em 0 .55em}
.roj .roj-duze.zl{text-shadow:0 0 calc(var(--s,0) * 26px) rgba(240,192,96,calc(var(--s,0) * .75))}
.roj-t > .roj-duze:first-child{margin-top:0}
.roj a{color:var(--kosc);text-decoration:none;border-bottom:1px solid rgba(240,192,96,.55)}
.roj a:hover{color:var(--zloto)}
.roj a:focus-visible{outline:2px solid var(--zloto);outline-offset:3px}
.roj-st.poziom{display:block;height:320vh;padding:0}
.roj-lepki{position:sticky;top:0;height:100vh;overflow:hidden}
.roj-tor{position:absolute;top:0;left:0;height:100%;width:200vw;display:flex;will-change:transform}
.roj-panel{position:relative;width:100vw;height:100%;overflow:hidden}
.roj-panel p{position:absolute;left:clamp(30px,9vw,140px);max-width:min(760px,80vw)}
.roj-panel .roj-duze{top:6vh;font-size:clamp(28px,2.8vw,40px)}
.roj-nic{font-family:var(--font-display);font-style:italic;font-size:clamp(19px,1.6vw,24px);line-height:1.45;color:var(--mgla);font-weight:300;max-width:min(980px,84vw)!important}
.roj-nitka{position:absolute;left:clamp(30px,9vw,140px);top:0;padding:3px 10px;background:#000;font:400 12px var(--font-body);letter-spacing:.08em;white-space:nowrap;transform:translateY(-50%);opacity:0;pointer-events:none;will-change:transform}
.roj-nitka.n0{top:40vh}.roj-nitka.n1{top:58vh}.roj-nitka.n2{top:76vh}.roj-nitka.n3{top:94vh}
.roj .roj-ku-plotnu{position:absolute;top:0;right:0;bottom:0;width:26vw;border:0;background:linear-gradient(90deg,rgba(240,192,96,0),rgba(240,192,96,0));transition:background .3s ease}
.roj .roj-ku-plotnu:hover,.roj .roj-ku-plotnu:focus-visible{background:linear-gradient(90deg,rgba(240,192,96,0),rgba(240,192,96,.07));outline:0}
.roj-nic.n0{bottom:calc(60vh + 12px)}.roj-nic.n1{bottom:calc(42vh + 12px)}.roj-nic.n2{bottom:calc(24vh + 12px)}.roj-nic.n3{bottom:calc(6vh + 12px)}
.roj-st.kropka{display:block;height:260vh;padding:0}
.roj .roj-kropka{position:absolute;left:50%;top:50%;width:120px;height:120px;margin:-60px 0 0 -60px;border:0;border-radius:50%;opacity:0;pointer-events:none;transition:opacity .6s ease}
.roj-kropka.widac{opacity:1;pointer-events:auto}
.roj a.roj-kropka{cursor:pointer}
.roj a.roj-kropka:focus-visible{outline:1px solid var(--zloto);outline-offset:6px}
.roj-kropka-nazwa{position:absolute;top:calc(100% + 6px);left:50%;transform:translateX(-50%);font:500 24px var(--font-display);letter-spacing:2px;color:#e2ddd4;white-space:nowrap;transition:color .2s ease}
.roj a.roj-kropka:hover .roj-kropka-nazwa{color:var(--zloto)}
@media (max-width:760px){
  .roj-st{padding:52vh 20px 8vh 20px!important;align-items:flex-start;justify-content:flex-start!important}
  .roj-st.lewo .roj-t{max-width:none}
  .roj-st.pierwszy{padding-top:calc(34vh + 33vw + 16px)!important}
  .roj-st.poziom,.roj-st.kropka{padding:0!important}
  .roj-st.poziom{height:240vh}
  .roj-st.kropka{height:180vh}
  .roj-st.dlugi{min-height:130vh}
  .roj-st.srodek{padding-top:18vh!important}
  .roj-t p{font-size:15px}
  .roj-panel .roj-duze{top:4vh;font-size:26px}
  .roj-nic{font-size:18px;line-height:1.35}
  .roj-panel p{max-width:74vw}
  .roj-nic{max-width:74vw!important}
  .roj .roj-ku-plotnu{width:18vw}
}
@media (prefers-reduced-motion:reduce){.roj-t{opacity:1;transform:none;transition:none}.roj-kropka{transition:none}}
</style>

