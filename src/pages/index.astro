.roj .roj-naglowek{opacity:0}
.roj .roj-zrodlo{transition:color .8s ease,text-shadow .8s ease}
.roj .roj-zrodlo.zloty{color:var(--zloto);text-shadow:0 0 12px rgba(240,192,96,.45)}
/* po solipsyście tekst płynie dalej z krótszymi odstępami */
/* odstępy między blokami od solipsysty, przy 878 px wysokości: 160, 227, 163, 186 px (jego słowo, 2026-10-19: Wiem o 60%, kolejne o 20%) */
.roj-st.ciag[data-k=wiem]{padding-top:0;margin-top:-20.5vh}
.roj-st.ciag[data-k=ja]{padding-top:25.8vh}
.roj-st.ciag[data-k=doswiadcza]{padding-top:18.6vh;padding-bottom:0}
.roj-st.ciag[data-k=dyscypliny]{padding-top:21.1vh;padding-bottom:22vh}
.roj .roj-dysc,.roj .roj-dysc-k{font-weight:500}
.roj-t{opacity:0;transform:translateY(28px);transition:opacity .9s ease,transform .9s ease}
.roj-st.in .roj-t{opacity:1;transform:none}
.roj p,.roj h1,.roj ul{margin:0}
.roj-t p,.roj-lista li{font-family:var(--font-body);font-size:17px;line-height:1.9;color:var(--kosc);font-weight:300}
.roj-t > * + *{margin-top:1em}
/* od „Jesteś człowiekiem” dalej akapity mają więcej powietrza (jego słowo, 2026-10-19, dwa razy) */
.roj-st:is([data-k=zombie],[data-k=wiem],[data-k=ja],[data-k=doswiadcza],[data-k=dyscypliny],[data-k=kogni]) .roj-t > * + *{margin-top:2.2em}
.roj .roj-duze{font-family:var(--font-display);font-weight:400;font-size:clamp(28px,2.7vw,40px);line-height:1.2;letter-spacing:.005em;color:var(--zloto)}
.roj-t > .roj-duze{margin:.45em 0 .55em}
.roj-t > .roj-duze:first-child{margin-top:0}
.roj a{color:var(--kosc);text-decoration:none;border-bottom:1px solid rgba(240,192,96,.55)}
.roj a:hover{color:var(--zloto)}
.roj a:focus-visible{outline:2px solid var(--zloto);outline-offset:3px}
/* Cześć: przygaszone, dopóki iskra go nie oświetli */
.roj .roj-czesc{font-family:var(--font-display);font-weight:400;font-size:clamp(56px,6vw,96px);line-height:1;letter-spacing:.01em;color:var(--zloto);opacity:max(var(--min,.16),calc(.16 + var(--s,0) * .84));text-shadow:0 0 calc(var(--s,0) * 34px) rgba(240,192,96,calc(var(--s,0) * .7));transition:opacity .4s ease}
.roj .roj-czesc.lit{--min:.92}
/* sieci pojawiają się po kolei, gdy iskra je ogląda */
.roj-sieci{list-style:none;padding:0;margin:0!important;height:0}
.roj-siec{height:1px}
.roj-ukryte{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
/* zombie i solipsysta: ekran lepki, postać odsłania iskra */
.roj-st.lepkie{display:block;height:115vh;padding:0}
.roj-lepki{position:sticky;top:0;height:100vh;overflow:hidden}
.roj-st.lepkie .roj-lepki{display:flex;align-items:center;padding:0 56px 0 8vw}
.roj-st.lepkie .roj-t{max-width:min(40vw,560px)}
.roj-st.lepkie .roj-t{position:relative}
.roj-sol{position:absolute;left:calc(100% + 20px);top:50%;transform:translateY(-50%);width:400px;height:34vh;margin:0}
.roj-sol-p{position:absolute;left:2%;bottom:4vh;height:15vh;aspect-ratio:100/222;opacity:0;transition:opacity 1.6s ease}
.roj-sol-obrot{height:100%;transform:scaleX(-1)}
/* snop świecy w prawo, od płomienia (66% szerokości po odbiciu, 39% wysokości); skrypt wodzi nim w górę i w dół */
.roj-sol-snop{position:absolute;left:66%;top:calc(39% - 80px);width:min(340px,80vw);height:160px;transform-origin:0 50%;will-change:transform;clip-path:polygon(0 50%,100% 0,100% 100%);background:radial-gradient(ellipse 100% 70% at 0 50%,rgba(255,201,120,.24),rgba(255,201,120,0) 75%);opacity:0;transition:opacity 1.2s ease;pointer-events:none}
.roj-sol.plonie .roj-sol-snop{opacity:1}
.roj-sol.widac .roj-sol-p{opacity:1}
.roj-sol-nazwa{position:absolute;left:50%;top:calc(100% + 6px);transform:translateX(-50%);font:400 17px var(--font-display);letter-spacing:.04em;color:var(--zloto);white-space:nowrap}
.roj-chmura span{position:absolute;font:italic 400 15px var(--font-display);color:#d6cdbd;opacity:0;white-space:nowrap;transition:opacity .6s ease,color .6s ease,text-shadow .6s ease}
.roj-chmura span.widac{opacity:.45}
.roj-chmura span.widac.lit{opacity:.95;color:#ffe2a8;text-shadow:0 0 10px rgba(255,201,120,.55)}
/* słowa po prawej solipsysty, w wachlarzu jego snopu */
.roj-chmura .c0{left:32%;top:8%}.roj-chmura .c1{left:46%;top:23%}.roj-chmura .c2{left:28%;top:38%}.roj-chmura .c3{left:44%;top:53%}.roj-chmura .c4{left:30%;top:68%}.roj-chmura .c5{left:42%;top:83%}
