.roj-slowo-osn{position:absolute;transform:translateX(-50%);font:300 14px var(--font-body);letter-spacing:.02em;color:#cfc6b6;white-space:nowrap;opacity:0;transition:color .4s ease,text-shadow .4s ease;will-change:transform,opacity}
