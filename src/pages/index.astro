---
import Base from '../layouts/Base.astro';
import R from '../rocznik/2026/rocznik.json';
import { WIKI_ON } from '../karty/data.js';

// Strona startowa: ekrany przewijane nad rojem cząstek z masek sieci. Złote zdania duże, białe opisy małe.
// {{słowo}} to miejsce, na którym staje iskra (kropka z logo, która wędruje z czytelnikiem); {{słowo|klasa}} dokłada klasę.
const WIKI = WIKI_ON ? '/wiki/' : '';
const md = (t) => t.replace(/\{\{([^}|]+)(?:\|([^}]+))?\}\}/g, (_, w, k) => '<span class="iskra-cel' + (k ? ' ' + k : '') + '">' + w + '</span>');
const T = {
  pytanie: 'Czym jest {{doświadczanie}}?',
  akt: 'Doświadczanie jest {{aktywnością}} sieci mózgowych.',
  zmiany: 'Zmiany struktury mózgu (np. degeneracje, lezje, uszkodzenia) i zmiany funkcjonowania struktur między sobą (np. substancje psychoaktywne, uzależnienia, nauka, rozwój) zmieniają doświadczanie.',
  zombie: ['Dla Ciebie doświadczanie też się {{dzieje}}, prawda?', 'Nie mogę tego wiedzieć, ale założę, że tak. Inaczej byłbym solipsystą.'],
  wiem: ['Znam tylko moje własne {{doświadczanie}}.', 'O Twoim doświadczaniu mogę tylko wnioskować. To mój Model Mentalny, będący jednocześnie moją aktywnością biologiczną.'],
  ja: ['Ale... "{{ja}}" to też Model Mentalny', 'Model "ja" zmienia się w czasie,  Zmienia się płynnie (nauka, dryfowanie) i gwałtownie (szok, przeskok). "Ja" to Statek Tezeusza strukturalnie i funkcjonalnie połączonych komórek.'],
  dysc: ['{{Doświadczanie}} dyscyplin.', 'Doświadczanie siatek pojęciowych poszczególnych dyscyplin przez: [[socjologów]], [[psychologów]], [[biologów]], [[fizyków]].'],
  dosw: ['{{Doświadczanie}}.', 'Skoro podmiot, który doświadcza, i treść doświadczania są zmienne, to zostaje samo doświadczanie. Doświadczanie Modeli Mentalnych świata, ciała, "ja".'],
  // jego tekst (2026-10-20), jak go napisał
  kogni: [
    '{{Interdyscyplinarne}} doświadczanie',
    'Kognitywistyka łączy dyscypliny. Człowiek z zewnątrz jest opisywany przez fizykę, biologię, psychologię i socjologię. Od wewnątrz jest doświadczanie. Doświadczają się zmysły i doświadczają się wyjaśnienia.',
    'Weźmy na przykład doświadczanie sztormu u wybrzeża Krety 2500 lat temu. Dzisiejsze doświadczania wyjaśnią nam, że doświadczania wtedy były wyjaśniane gniewem Posejdona. Doświadczanie sztormu dzisiaj wyjaśnia fizyka. Tylko jak głęboko sięga to wyjaśnienie? Jak dokładnie powstaje sztorm? Skąd nad morzem bierze się niż? Dlaczego ciepłe, wilgotne powietrze unosi się do góry? Czym jest ciśnienie, skoro powietrze to cząstki, które się zderzają? Dlaczego cząstki w ogóle się poruszają? Na każde pytanie jest drobniejsze wyjaśnienie, a każde z nich, opisane dzisiaj, wydaje się oczywiste. Dwie osoby, które mówią „fizyka”, mogą mieć na myśli wyjaśnienia o zupełnie innej głębokości. A pod każdym z nich jest to samo doświadczanie: fale, wiatr, strach.',
    'Dyscypliny to wyjaśnienia przyczynowo-skutkowe dla doświadczania. Kryje się tu jednak koło: dyscypliny opierają się na doświadczaniu i wyjaśniają doświadczanie. W danej chwili jest jedno doświadczanie, wyjaśniane przez wcześniejsze doświadczania, wyjaśniane przez wcześniejsze doświadczania, wyjaśniane przez wcześniejsze doświadczania... Fizykowi, biologowi, psychologowi, socjologowi... każdemu doświadczają się inne wcześniejsze doświadczania, które inaczej wyjaśniają doświadczanie sztormu: fizykowi wiatr, biologowi ciało żeglarza, psychologowi jego strach, socjologowi zachowanie załogi.',
    'Więc skoro doświadczają się wyjaśnienia... niech to będą interdyscyplinarne wyjaśnienia. Spróbujmy wyjaśnić doświadczanie wszystkimi dyscyplinami {{naraz|hura}}.',
  ],
};
// Sieci w kolejności od receptorów; numer to etykieta w masce BraiNets_MASKS.
const SIECI = [
  [2, 'Sieć wzrokowa'],
  [3, 'Sieć czuciowo-ruchowa'],
  [4, 'Sieć grzbietowa uwagi'],
  [8, 'Sieć brzuszna uwagi'],
  [6, 'Sieć istotności'],
  [5, 'Sieć kontroli'],
  [7, 'Sieć domyślna'],
];
const KOLOR = { 2: '#ee6b6f', 3: '#f9d780', 4: '#e58e76', 5: '#f69959', 6: '#a9b26f', 7: '#bb6fb2', 8: '#6fb3a8' };
const OSNOWY = [['socjologia', '#8fa274'], ['psychologia', '#5f9a96'], ['biologia', '#6585b0'], ['fizyka', '#8577b3']];
const KOL_OSN = Object.fromEntries(OSNOWY);
// mnich to badacz swojej dyscypliny
const BADACZ = { socjologia: 'socjolog', psychologia: 'psycholog', biologia: 'biolog', fizyka: 'fizyk' };
// nazwy dyscyplin w tekście: każda w kolorze swoich osnów; przy przewijaniu lecą pod swoich mnichów
// lot: te nazwy wylatują do mnichów; pozostałe tylko w kolorach swoich osnów
// w drugiej części strony nazwy dyscyplin i ich badaczy w kolorach ich osnów (jego słowo, 2026-10-21)
const KOL_DYSC: [RegExp, number][] = [[/^socjolog/i, 0], [/^psycholog/i, 1], [/^biolog/i, 2], [/^fizy[kc]/i, 3]];
const koloruj = (t: string) => t.replace(/(socjolog|psycholog|biolog|fizy[kc])\p{L}*/giu, (w) => { const i = KOL_DYSC.find(([r]) => r.test(w))![1]; return '<span class="roj-dysc-k" style="color:' + OSNOWY[i][1] + '">' + w + '</span>'; });
const dysc = (t: string, lot = true) => { let k = 0; return t.replace(/\[\[([^\]]+)\]\]/g, (_, w) => { const i = k++; return '<span class="' + (lot ? 'roj-dysc' : 'roj-dysc-k') + '" data-k="' + i + '" style="color:' + OSNOWY[i][1] + '">' + w + '</span>'; }); };
// Słowa, które oświetlają postacie: osnowy Płótna, każda grupa w swoim kolorze.
const GRUPY = R.grupy.map((g) => ({ nazwa: g.nazwa, kolor: KOL_OSN[g.nazwa], slowa: g.osnowy.map((o) => o.nazwa) }));
const CHMURA = ['mózg w naczyniu', 'matrix', 'zły demon Kartezjusza', 'sen Zhuangzi', 'problem innych umysłów', 'filozoficzne zombie'];
// osnowy: wysokość każdej nici (vh) i miejsce jej mnicha (vw)
const YN_VH = [30, 48, 66, 84], MNICH_X = [17, 23, 11, 20];
// słowa osnów na różnych wysokościach nad swoją osnową: 24 px plus 0 do 10 vh, rozrzucone, a nie po kolei
const WYS = (k, j) => (((j * 37 + k * 23) % 11) / 10 * 10).toFixed(1);
// Postać w habicie z kapturem, bez twarzy, ze świecą: sam kontur, obrócona o mniej więcej 50 stopni w lewo.
// Płomień i światło w kolorze --swiatlo.
const SYLWETKA = 'M50 6 C62 5 73 12 76 26 C78 38 77 48 80 58 C86 80 88 120 90 160 C91 185 92 205 93 216 C75 221 45 222 21 217 C22 180 25 140 26 110 C26 90 28 70 33 56 C29 48 28 38 30 28 C32 16 40 8 50 6 Z';
const postac = (id, swiatlo = '#ffc978') => `<svg class="postac" viewBox="0 0 100 222" style="--swiatlo:${swiatlo}" aria-hidden="true"><defs>`
  + `<radialGradient id="ps${id}" cx="34" cy="90" r="110" gradientUnits="userSpaceOnUse"><stop offset="0" class="s1"/><stop offset=".32" class="s2"/><stop offset="1" class="s3"/></radialGradient>`
  + `<radialGradient id="pg${id}" cx="34" cy="86" r="30" gradientUnits="userSpaceOnUse"><stop offset="0" class="g1"/><stop offset="1" class="g3"/></radialGradient></defs>`
  + `<path class="szata" d="${SYLWETKA}"/>`
  + `<path class="swiatlo" fill="url(#ps${id})" d="${SYLWETKA}"/>`
  + `<path class="linie" d="M52 8 C56 20 58 34 62 50 M33 56 C45 62 66 62 80 58 M77 62 C73 84 61 99 45 104 M81 80 C77 98 65 110 47 112 M60 122 C62 152 64 186 66 218 M45 120 C43 152 41 186 39 219"/>`
  + `<ellipse class="twarz" cx="39" cy="36" rx="7.5" ry="12" transform="rotate(-12 39 36)"/>`
  + `<ellipse class="linie" cx="42" cy="108" rx="5" ry="6.5" transform="rotate(-25 42 108)"/>`
  + `<circle class="poswiata" cx="34" cy="86" r="30" fill="url(#pg${id})"/>`
  + `<rect class="swieca" x="31.5" y="88" width="5.5" height="15" rx="1"/>`
  + `<g class="plomien"><path d="M34.25 76 C37.25 81 38.25 85 36.75 88.5 C35.75 90.5 32.75 90.5 31.75 88.5 C30.25 85 31.25 81 34.25 76 Z"/><ellipse class="rdzen" cx="34.25" cy="87" rx="1.2" ry="2.4"/></g>`
  + `</svg>`;
---
<Base title="kogni.pl" activePage="" description="kogni.pl: kognitywistyka na Uniwersytecie w Białymstoku. Czym jest doświadczanie?">
<!-- przełącznik animacji (jego słowo, 2026-10-22): wybór czytelnika wygrywa z ustawieniem systemu; klasa staje na html, zanim ruszy skrypt strony -->
<script is:inline>(function(){var z=null;try{z=localStorage.getItem('kogni-animacje')}catch(e){}var c=z?z==='off':matchMedia('(prefers-reduced-motion: reduce)').matches;if(c)document.documentElement.classList.add('roj-cicho')})();</script>
<canvas class="roj-plotno" aria-hidden="true"></canvas>
<canvas class="roj-plotno roj-iskra" aria-hidden="true"></canvas>
<main class="roj">
  <!-- ekran startowy (jego słowo, 2026-10-22): logo w lewym górnym rogu, przyciski po lewej schodami od logo ku Story, mózg po prawej; rój formuje z logo kreski ze strzałkami do przycisków; Story stoi pośrodku, a do historii wchodzi się tylko nim -->
  <section class="roj-st start" data-k="start" aria-label="Menu">
    <button type="button" class="roj-anim" role="switch" aria-checked="true"><span>Animacje</span><span class="roj-anim-tor" aria-hidden="true"></span></button>
    <nav class="roj-menu-st" aria-label="Główne">
      {WIKI ? <a class="roj-btn" href={WIKI}>Wiki</a> : <span class="roj-btn wkrotce">Wiki</span>}
      <a class="roj-btn" href="/2026/">Kursy</a>
      <a class="roj-btn" href="/kontakt">Kontakt</a>
    </nav>
    <a class="roj-btn roj-story" href="#czesc">Story</a>
  </section>
  <section class="roj-st lewo pierwszy" data-k="czesc" id="czesc">
    <div class="roj-t"><h1 class="roj-czesc">Cześć!</h1></div>
  </section>
  <section class="roj-st lewo ciag" data-k="pytanie">
    <div class="roj-t">
      <p class="roj-duze" set:html={md(T.pytanie)} />
      <p><span class="roj-zrodlo">{T.akt.replace(/\{\{|\}\}/g, '')}</span></p>
      <p>{T.zmiany}</p>
    </div>
  </section>
  <section class="roj-st lewo oba" data-k="naglowek">
    <div class="roj-oba"><div class="roj-t"><p class="roj-duze roj-naglowek" set:html={md(T.akt)} />
      <ul class="roj-sieci">{SIECI.map(([n, nazwa]) => <li class="roj-siec" data-n={n} data-nazwa={nazwa.replace(/^Sieć\s+/, '')}><span class="roj-ukryte">{nazwa}</span></li>)}</ul>
    </div></div>
  </section>
  <section class="roj-st lepkie" data-k="zombie">
    <div class="roj-lepki">
      <div class="roj-t">
        <p class="roj-duze" set:html={md(T.zombie[0])} />
        <p set:html={md(T.zombie[1])} />
        <div class="roj-sol">
          <div class="roj-chmura">{CHMURA.map((w, i) => <span class={'c' + i} style={'--i:' + i}>{w}</span>)}</div>
          <div class="roj-sol-p"><div class="roj-sol-snop"></div><div class="roj-sol-obrot" set:html={postac('sol')} /><span class="roj-sol-nazwa">solipsysta</span></div>
        </div>
      </div>
    </div>
  </section>
  <section class="roj-st lewo ciag" data-k="wiem">
    <div class="roj-t"><p class="roj-duze" set:html={md(T.wiem[0])} /><p set:html={md(T.wiem[1])} /></div>
  </section>
  <section class="roj-st lewo ciag" data-k="ja">
    <div class="roj-t"><p class="roj-duze" set:html={md(T.ja[0])} /><p set:html={md(T.ja[1])} /></div>
  </section>
  <section class="roj-st srodek ciag" data-k="doswiadcza">
    <div class="roj-t"><p class="roj-duze" set:html={md(T.dosw[0])} /><p set:html={md(T.dosw[1])} /></div>
  </section>
  <section class="roj-st srodek ciag" data-k="dyscypliny">
    <div class="roj-t"><p class="roj-duze" set:html={md(T.dysc[0])} /><p set:html={dysc(T.dysc[1])} /></div>
  </section>
  <section class="roj-st poziom" data-k="osnowy" aria-label="Osnowy: socjologia, psychologia, biologia, fizyka">
    <div class="roj-lepki"><div class="roj-tor">
      {GRUPY.map((g, k) => g.slowa.map((w, j) => <span class="roj-slowo-osn" data-k={k} style={'--k:' + g.kolor + ';left:' + (35 + 240 * (j + .5) / g.slowa.length).toFixed(1) + 'vw;top:calc(' + YN_VH[k] + 'vh - 24px - ' + WYS(k, j) + 'vh)'}>{[...w].map((z) => z === ' ' ? ' ' : <span class="zn">{z}</span>)}</span>))}
    </div>
    {GRUPY.map((g, k) => <div class="roj-mnich" data-k={k} style={'left:' + MNICH_X[k] + 'vw;top:calc(' + YN_VH[k] + 'vh - var(--mh))'}><div class="roj-mnich-c plonie" set:html={postac('m' + k, g.kolor)} /><span class="roj-mnich-nazwa" style={'color:' + g.kolor}>{BADACZ[g.nazwa] || g.nazwa}</span></div>)}
    <a class="roj-ku-plotnu" href="/2026/" aria-label="Rocznik 2026: Płótno"></a>
    </div>
  </section>
  <section class="roj-st lewo kogni" data-k="kogni">
    <div class="roj-t">
      <p class="roj-duze" set:html={md(T.kogni[0])} />
      <p set:html={koloruj(T.kogni[1])} />
      <div class="roj-cien-w"><p set:html={koloruj(T.kogni[2])} /><div class="roj-cien" set:html={postac('cien')} /></div>
      <p set:html={koloruj(T.kogni[3])} />
      <p set:html={koloruj(md(T.kogni[4]))} />
    </div>
  </section>
  <section class="roj-st wiki" data-k="wiki" aria-label="kogniwiki">
    <div class="roj-t">
      {WIKI
        ? <a class="roj-wiki" href={WIKI}>kogn<span class="roj-wiki-i">ı<span class="roj-wiki-kropka"></span></span>.pl/wiki</a>
        : <span class="roj-wiki">kogn<span class="roj-wiki-i">ı<span class="roj-wiki-kropka"></span></span>.pl/wiki</span>}
    </div>
  </section>
  <div class="roj-loty" aria-hidden="true">{OSNOWY.map(([n, c]) => <span class="roj-lot" style={'color:' + c}></span>)}</div>
</main>

<style is:global>
body:has(.roj){background:#000}
body:has(.roj) .rocznik-head,body:has(.roj) .site-footer{position:relative;z-index:1}
body:has(.roj) .site-footer::before{display:none}
/* na stronie startowej logo stoi w lewym górnym rogu, a menu przejmują przyciski ekranu startowego */
body:has(.roj) .rocznik-head{align-items:flex-start;max-width:none;margin:0;padding-left:8vw;padding-right:8vw}
body:has(.roj) .rocznik-title{justify-content:flex-start}
body:has(.roj) .rocznik-bar,body:has(.roj) .rocznik-menu{display:none}
.roj-plotno{position:fixed;inset:0;width:100vw;height:100vh;z-index:0;pointer-events:none}
.roj-plotno.roj-iskra{z-index:3}
.roj{position:relative;z-index:1;--kosc:#ece6da;--mgla:#b3aa9b;--zloto:#f0c060}
.roj-st{position:relative;min-height:100vh;display:flex;align-items:center;padding:12vh 56px 12vh 8vw}
.roj-st.lewo .roj-t{max-width:min(40vw,560px)}
.roj-st.srodek{justify-content:center;padding-left:56px}
.roj-st.srodek .roj-t{max-width:680px}
.roj-st.pierwszy{min-height:calc(100vh - 120px);align-items:flex-end;padding-top:0;padding-bottom:14vh}
/* ekran startowy: pusty ekran na wysokość okna; przyciski stoją na nim w pionowej kolumnie, Story niżej i dopiero po czasie */
.roj-st.start{display:block;min-height:0;height:100vh;padding:0}
.roj-menu-st{position:absolute;right:clamp(24px,5vw,96px);top:calc(13vh - var(--hh,96px));display:flex;flex-direction:column;align-items:stretch;gap:16px}
/* na szerokim ekranie przyciski schodzą schodami od logo ku Story: każdy niżej i bliżej środka (jego słowo, 2026-10-22) */
@media (min-width:761px){
  .roj-menu-st{position:static}
  .roj-menu-st > *{position:absolute}
  .roj-menu-st > :nth-child(1){left:calc(8vw + 140px);top:calc(24vh - var(--hh,96px))}
  .roj-menu-st > :nth-child(2){left:calc(17vw + 140px);top:calc(44vh - var(--hh,96px))}
  .roj-menu-st > :nth-child(3){left:calc(26vw + 140px);top:calc(64vh - var(--hh,96px))}
}
.roj a.roj-btn,.roj span.roj-btn{display:block;box-sizing:border-box;min-width:6.6em;padding:.5em 1.05em;border:1px solid rgba(240,192,96,.55);background:rgba(0,0,0,.62);font-family:var(--font-display);font-weight:400;font-size:27px;line-height:1.2;letter-spacing:.02em;color:var(--kosc);text-decoration:underline;text-decoration-color:rgba(240,192,96,.75);text-decoration-thickness:1px;text-underline-offset:.26em;transition:border-color .2s ease,background .2s ease,color .2s ease,opacity .9s ease}
.roj a.roj-btn:hover{border-color:var(--zloto);background:rgba(240,192,96,.1);color:var(--zloto)}
.roj span.roj-btn.wkrotce{color:#6e675c;border-color:rgba(240,192,96,.22);text-decoration-color:rgba(240,192,96,.3)}
.roj a.roj-story{position:absolute;left:0;right:0;margin:0 auto;width:fit-content;text-align:center;top:calc(87vh - var(--hh,96px));opacity:0;pointer-events:none}
.roj a.roj-story.on{opacity:1;pointer-events:auto;animation:storyPuls 3.4s ease-in-out 1.4s infinite}
@keyframes storyPuls{0%,100%{box-shadow:0 0 0 0 rgba(240,192,96,0)}50%{box-shadow:0 0 16px 1px rgba(240,192,96,.3)}}
/* kółko, strzałka albo palec na zamkniętym ekranie startowym przypominają, którędy się wchodzi */
.roj a.roj-story.nudge{animation:storyNudge .9s ease-out 1}
@keyframes storyNudge{0%{box-shadow:0 0 0 0 rgba(240,192,96,.7);transform:scale(1)}30%{transform:scale(1.045)}100%{box-shadow:0 0 0 22px rgba(240,192,96,0);transform:scale(1)}}
html.roj-blok{overscroll-behavior:none}
/* przełącznik animacji w prawym górnym rogu, na wysokości logo; stoi na ekranie przez całą historię (jego słowo, 2026-10-22) */
.roj-anim{position:fixed;right:calc(8vw - 10px);top:32px;z-index:20;display:flex;align-items:center;gap:10px;padding:6px 10px;background:rgba(0,0,0,.55);border:0;border-radius:15px;cursor:pointer;font-family:Inter,sans-serif;font-weight:300;font-size:14px;letter-spacing:.04em;color:var(--mgla)}
.roj-anim:hover{color:var(--kosc)}
.roj-anim-tor{position:relative;width:34px;height:18px;box-sizing:border-box;border:1px solid rgba(240,192,96,.55);border-radius:9px;transition:background .2s ease}
.roj-anim-tor::after{content:'';position:absolute;top:2px;left:2px;width:12px;height:12px;border-radius:50%;background:#6e675c;transition:transform .2s ease,background .2s ease}
.roj-anim[aria-checked="true"] .roj-anim-tor{background:rgba(240,192,96,.16)}
.roj-anim[aria-checked="true"] .roj-anim-tor::after{transform:translateX(16px);background:var(--zloto)}
.roj-anim:focus-visible{outline:1px solid var(--zloto);outline-offset:4px}
html.roj-cicho .roj *{animation:none!important}
#czesc:focus{outline:none}
@media (prefers-reduced-motion:reduce){.roj a.roj-story.on,.roj a.roj-story.nudge{animation:none}}
/* Cześć, pytanie i sieci płyną jak jeden tekst */
.roj-st.ciag{min-height:0;padding-bottom:0}
.roj-st.ciag[data-k=pytanie]{padding-top:10vh}
/* nagłówek zostaje u góry ekranu; pod nim, po lewej, wchodzi mózg od środka, boczny zostaje po prawej,
   iskra ogląda oba (jego słowo, 2026-10-21); za tym ekranem rój się rozprasza */
.roj-st.oba{display:block;height:230vh;padding:0}
.roj-oba{position:sticky;top:0;height:100vh;padding:9vh 56px 0 8vw}
