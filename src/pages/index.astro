.roj-slowo-osn .zn{display:inline-block}
.roj-st.poziom{--mh:15vh}
.roj-mnich{position:absolute;height:var(--mh);aspect-ratio:100/222;transform-origin:50% 100%;will-change:transform,opacity}
.roj-mnich-c{height:100%;transform:scaleX(-1)}
