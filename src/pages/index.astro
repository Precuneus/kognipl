---
import Base from '../layouts/Base.astro';
import { latest } from '../rocznik/data.js';
const KURS = { Intro: 'Wstęp do kognitywistyki I', Neurokogni: 'Neurokognitywistyka' };
// Order: from the receptors to the default network (connectivity gradient, Margulies et al. 2016).
const SIECI = [
  { k: 'vis', kod: 'VIS', kolor: '#ee6b6f', nazwa: 'sieć wzrokowa', obszary: 'biegun potyliczny', rola: [['', '„Widzę.”']] },
  { k: 'smn', kod: 'SMN', kolor: '#f9d780', nazwa: 'sieć czuciowo-ruchowa', obszary: 'MC, SSC, PN', rola: [['', '„Czuję ciało i się ruszam.”']] },
  { k: 'dan', kod: 'DAN', kolor: '#e58e76', nazwa: 'sieć grzbietowa uwagi', obszary: 'FEF, IFJ, SPL, IPS, V3, V5', rola: [['', '„Koordynuję oko i rękę.”']] },
  { k: 'sn', kod: 'SN · VAN', kolor: '#8e9881', nazwa: 'sieć istotności i sieć brzuszna uwagi', obszary: 'aINS, ACC, TPJ', rola: [['SN', '„Coś zagraża schematowi ciała.”'], ['VAN', '„Coś przerywa plan.”']] },
  { k: 'cn', kod: 'CN', kolor: '#f69959', nazwa: 'sieć kontroli', obszary: 'dlPFC, rPFC, aIPL', rola: [['', '„Trzymam zadanie.”']] },
  { k: 'dmn', kod: 'DMN', kolor: '#bb6fb2', nazwa: 'sieć domyślna', obszary: 'mPFC, IFG, STS, MTG, pIPL, AG', rola: [['', '„Ja, przeszłość i przyszłość, inni ludzie.”']] },
];
const R2025 = [['/2025/', 'Strona startowa'], ['/2025/wstep-2/', 'Wstęp do kognitywistyki II'], ['/2025/mip/', 'Mózg i poznanie'], ['/2025/design/', 'Warsztaty Design Thinking'], ['/2025/drugi-mozg/', 'Drugi mózg z AI']];
const R2026 = [['/2026/', 'Płótno'], ['/2026/osnowy/', 'Osnowy'], ['/2026/watki/', 'Wątki'], ['/2026/wstep-1/', 'Wstęp do kognitywistyki I'], ['/2026/neurocogni/', 'Neurokognitywistyka']];
---
<Base title="kogni.pl" activePage="" description="kogni.pl: kognitywistyka na Uniwersytecie w Białymstoku. Sieci mózgu, Rocznik 2025 i Rocznik 2026.">
<h1 class="sr-only">kogni.pl</h1>

<section class="sieci" aria-labelledby="sieci-h">
  <p class="sieci-lead">Doświadczenie jest aktywnością sieci Twojego mózgu: od środka czytasz te słowa, a z boku przyrządy mierzą rzut tej samej aktywności.</p>
  <h2 class="sr-only" id="sieci-h">Sieci mózgu</h2>
  <div class="sieci-grid">
    <figure class="sieci-fig">
      <div class="sieci-stack" data-sieci>
        <img class="sieci-all" src="/images/2026/sieci.webp" width="1200" height="900" alt="Boczny widok lewej półkuli mózgu z obszarami sieci w kolorach: biegun potyliczny, kora ruchowa i czuciowa, sieć grzbietowa uwagi, sieć istotności, sieć kontroli i sieć domyślna, z podpisami obszarów." />
        {SIECI.map((s) => <img class="sieci-layer" data-k={s.k} data-src={'/images/2026/sieci-' + s.k + '.webp'} width="1200" height="900" alt="" aria-hidden="true" />)}
      </div>
      <figcaption>Rysunek mózgu: Patrick J. Lynch i C. Carl Jaffe, CC BY 2.5. Sieci i podpisy: Olgierd Borowiecki.</figcaption>
    </figure>
    <div class="sieci-side">
      <ul class="sieci-legend" aria-label="Sieci mózgu i ich role">
        {SIECI.map((s) => (
          <li>
            <button type="button" data-k={s.k} aria-pressed="false" style={'--c:' + s.kolor}>
              <span class="sieci-sw" aria-hidden="true"></span>
              <span class="sieci-txt">
                <span class="sieci-kod">{s.kod}</span> <span class="sieci-nazwa">{s.nazwa}</span>
                {s.rola.map(([who, r]) => <span class="sieci-rola">{who && <b>{who}</b>}{r}</span>)}
                <span class="sieci-obszary">{s.obszary}</span>
              </span>
            </button>
          </li>
        ))}
      </ul>
      <p class="sieci-note">Od receptorów do sieci domyślnej, według gradientu łączności (Margulies i in. 2016). <a href="/2026/karty/sieci-wielkoskalowe/">Karta: Sieci wielkoskalowe →</a></p>
    </div>
  </div>
</section>

<section class="drzwi" aria-label="Roczniki">
  <div class="drzwi-card">
    <p class="drzwi-k">2025/26</p>
    <h2><a href="/2025/">Rocznik 2025</a></h2>
    <p class="drzwi-opis">Strona z roku akademickiego 2025/26, tak jak była: pytania kognitywistyki i kursy semestru letniego.</p>
    <ul>{R2025.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
  </div>
  <div class="drzwi-card drzwi-now">
    <p class="drzwi-k">2026/27</p>
    <h2><a href="/2026/">Rocznik 2026</a></h2>
    <p class="drzwi-opis">Rocznik 2026 prowadzi tę myśl przez zajęcia tego roku: każde zajęcia to wątek, który przechodzi przez osnowy od społeczeństwa po fizykę, a każde miejsce, w którym je splata, to karta.</p>
    <a class="drzwi-latest" href={latest.url}><span>Ostatnie zajęcia · {KURS[latest.course] || latest.course} · {latest.date}</span>{latest.title}</a>
    <ul>{R2026.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
  </div>
</section>

<script>
  const stack = document.querySelector('[data-sieci]');
  const buttons = [...document.querySelectorAll('.sieci-legend button')];
  let pinned = '';
  let loaded = false;
  const load = () => {
    if (loaded) return;
    loaded = true;
    stack.querySelectorAll('.sieci-layer').forEach((img) => { img.src = img.dataset.src; });
  };
  const show = (k) => {
    stack.classList.toggle('has-on', !!k);
    stack.querySelectorAll('.sieci-layer').forEach((img) => img.classList.toggle('on', img.dataset.k === k));
    buttons.forEach((b) => b.classList.toggle('on', b.dataset.k === k));
  };
  const fine = matchMedia('(hover: hover)').matches;
  buttons.forEach((b) => {
    b.addEventListener('pointerenter', () => { load(); if (fine) show(b.dataset.k); });
    b.addEventListener('pointerleave', () => { if (fine) show(pinned); });
    b.addEventListener('focus', () => { load(); show(b.dataset.k); });
    b.addEventListener('blur', () => show(pinned));
    b.addEventListener('click', () => {
      load();
      pinned = pinned === b.dataset.k ? '' : b.dataset.k;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.k === pinned)));
      show(pinned || (fine ? b.dataset.k : ''));
    });
  });
</script>
</Base>
