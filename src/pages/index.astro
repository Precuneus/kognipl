---
import Base from '../layouts/Base.astro';
import RocznikHeader from '../components/RocznikHeader.astro';
import Board from '../components/Board.astro';
import { latest, cardsOf, cardByName, viewData } from '../rocznik/data.js';
const { OS, BAND, GN } = viewData('plotno');
const groupOf = {};
BAND.reduce((start, n, g) => { for (let k = 0; k < n; k++) groupOf[OS[start + k]] = g; return start + n; }, 0);
const INK = ['#b3c39b', '#8fc4bf', '#9fb7da', '#b4aada'];
const COL = { i: '#f0c060', n: '#edbbc5' };
const fresh = cardsOf(latest.id);
const Q = {
  'Skąd wiesz, że to, co widzisz, jest prawdziwe?': ['Kontrolowane halucynacje', 'Pręciki, czopki i droga wzrokowa', 'Ślepowidzenie i szlaki wzrokowe'],
  'Dlaczego czasem sny wydają się bardziej realne niż rzeczywistość?': ['Kontrolowane halucynacje'],
  'Czy Twoje decyzje podejmujesz Ty, czy Twój mózg podejmuje je za Ciebie?': ['Sprawczość jako wybór gier', 'Phineas Gage'],
  'Dlaczego nie możesz poczuć tego, co czuje ktoś inny?': ['Trzeci szlak wzrokowy', 'Dylemat dwóch przycisków', 'Propriocepcja i interocepcja'],
  'Kim właściwie jesteś, kiedy nikt nie patrzy?': ['Odkrywanie cech', 'Westworld'],
  'Czym jest wyobraźnia?': ['Gra myślą - kontrolery EEG', 'Rozszczepiony mózg i TPJ'],
  'Dlaczego niektóre mózgi działają inaczej niż inne?': ['Sieć istotności', 'Pacjent H.M.', 'Ian Waterman'],
  'Czy świadomość jest obliczeniem, iluzją, czy czymś zupełnie innym?': ['Westworld', 'Rój agentów', 'Kontrolowane halucynacje'],
};
const kartyOf = (q) => (Q[q] || []).map(cardByName).filter(Boolean);
const clsOf = (s) => s.cls.endsWith('intro') ? 'i' : 'n';
---
<Base title="kogni.pl" activePage="start">

<style is:global>
  /* === ALL SCROLLING CONTENT === */
  .scroll-content {
    position: relative;
    background: var(--bg-deep);
    padding-bottom: 1px;
  }


  /* Title section (over hero image, no dark bg) */
  .title-section {
    text-align: center;
    padding: 40px 24px 60px;
    max-width: 820px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .title-section h1, .title-section .start-k {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 400;
    color: var(--text-primary);
    letter-spacing: 4px;
    line-height: 1.1;
    margin-bottom: 14px;
  }

  .title-section .subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .title-section h1, .title-section .start-k { font-size: 38px; letter-spacing: 2px; }
    .title-section .subtitle { font-size: 17px; }
  }
  @media (max-width: 480px) {
    .title-section h1, .title-section .start-k { font-size: 28px; }
    .title-section .subtitle { font-size: 15px; }
  }

  /* Rocznik on the start page */
  .start-lead { max-width: 680px; margin: 36px auto 0; padding: 0 24px; text-align: center; }
  .start-lead p { font-family: var(--font-display); font-size: 22px; line-height: 1.55; color: var(--text-primary); }
  .start-lead p + p { margin-top: 14px; font-size: 19px; color: var(--text-secondary); }
  .start-latest { max-width: 1120px; margin: 64px auto 0; padding: 0 24px; }
  .start-latest-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; margin-bottom: 22px; }
  .start-latest-kicker { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; }
  .start-latest-title { font-family: var(--font-display); font-size: 38px; font-weight: 500; line-height: 1.1; color: var(--text-primary); margin-top: 6px; }
  .start-latest-all { font-size: 14px; color: #e8a84c; text-decoration: none; }
  .start-latest-all:hover { color: #f0c060; }
  .start-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; }
  .start-card { position: relative; display: flex; flex-direction: column; background: #16140f; border: 1px solid rgba(180,155,100,0.2); border-radius: 14px; padding: 16px 18px 12px; text-decoration: none; transition: border-color .18s ease, box-shadow .18s ease; }
  .start-card:hover { box-shadow: 0 0 18px rgba(240,192,96,0.12); }
  .start-card-os { font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; }
  .start-card h3 { font-family: var(--font-display); font-size: 23px; font-weight: 500; line-height: 1.15; color: var(--text-primary); margin: 6px 0 0; }
  .start-card p { font-size: 14px; line-height: 1.6; color: var(--text-primary); margin-top: 8px; flex: 1 1 auto; }
  .start-card-enter { align-self: flex-end; margin-top: 8px; width: 36px; height: 36px; border-radius: 50%; border: 1px solid rgba(232,168,76,0.45); color: #e8a84c; display: flex; align-items: center; justify-content: center; }
  .start-plotno-head { text-align: center; margin: 72px auto 0; padding: 0 24px; }
  .start-plotno .rocznik-plotno main > div > div > div { margin: 0 auto; }
  .q-karty { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .q-karty-label { width: 100%; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-dim); }
  .q-karty a { font-size: 13px; min-height: 34px; display: inline-flex; align-items: center; padding: 5px 14px; border-radius: 999px; border: 1px solid; text-decoration: none; }
  @media (max-width: 720px) { .start-lead p { font-size: 19px; } .start-latest-title { font-size: 30px; } }

  /* Territory section */
  .territory { padding: 64px 0; }
  .territory-intro {
    max-width: 620px;
    margin: 0 auto 56px;
    text-align: center;
    padding: 0 24px;
  }
  .territory-intro p {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.9;
  }
  .territory-intro p + p { margin-top: 20px; }

  .domain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .domain-card { padding: 32px 24px 28px; }
  .domain-icon { font-size: 28px; margin-bottom: 16px; display: block; opacity: 0.7; }
  .domain-name {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 10px;
    line-height: 1.3;
  }
  .domain-desc {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Questions accordion */
  .questions-section {
    padding: 64px 0;
    max-width: 720px;
    margin: 0 auto;
  }
  .question-item {
    border-bottom: 1px solid var(--border-subtle);
  }
  .question-item:first-child { border-top: 1px solid var(--border-subtle); }
  .question-trigger {
    display: flex;
    align-items: baseline;
    gap: 12px;
    width: 100%;
    padding: 20px 24px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: all 0.3s;
  }
  .question-trigger:hover { background: rgba(232, 168, 76, 0.03); }
  .question-trigger .q-icon {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 500;
    color: var(--warm-glow);
    opacity: 0.5;
    font-size: 16px;
    flex-shrink: 0;
    transition: opacity 0.3s;
  }
  .question-item.open .question-trigger .q-icon { opacity: 0.8; }
  .question-trigger .q-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
    color: var(--text-secondary);
    line-height: 1.5;
    transition: color 0.3s;
  }
  .question-trigger:hover .q-text,
  .question-item.open .question-trigger .q-text { color: var(--text-primary); }
  .question-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
  }
  .question-body-inner {
    padding: 0 24px 28px 52px;
  }
  .q-voices {
    margin-bottom: 20px;
  }
  .q-voices-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 12px;
  }
  .q-voice {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    padding: 6px 0;
    opacity: 0.75;
  }
  .q-voice::before {
    content: '\201E';
    color: var(--warm-glow);
    opacity: 0.4;
    margin-right: 4px;
  }
  .q-voice::after {
    content: '\201D';
    color: var(--warm-glow);
    opacity: 0.4;
    margin-left: 2px;
  }
  .q-areas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .q-area {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--warm-glow);
    opacity: 0.6;
    padding: 4px 10px;
    border: 1px solid rgba(232, 168, 76, 0.15);
    background: var(--warm-glow-soft);
  }

  /* CTA */
  .cta-section {
    text-align: center;
    padding: 40px 24px 80px;
    max-width: 820px;
    margin: 0 auto;
  }
  .cta-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
    color: var(--text-secondary);
    margin-bottom: 28px;
    line-height: 1.7;
  }
  .cta-links { display: flex; justify-content: center; gap: 32px; }
  .cta-link {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-dim);
    text-decoration: none;
    padding: 10px 24px;
    border: 1px solid var(--border-subtle);
    transition: all 0.3s;
  }
  .cta-link:hover {
    color: var(--warm-glow);
    border-color: rgba(232, 168, 76, 0.25);
    background: var(--warm-glow-soft);
  }
  .cta-link.primary {
    color: var(--warm-glow);
    border-color: rgba(232, 168, 76, 0.2);
    background: var(--warm-glow-soft);
  }
  .cta-link.primary:hover {
    border-color: rgba(232, 168, 76, 0.4);
    background: var(--warm-glow-mid);
  }

  @media (max-width: 768px) {
    .domain-grid { grid-template-columns: 1fr; max-width: 480px; }
    .cta-links { flex-direction: column; align-items: center; gap: 12px; }
  }
</style>

<div class="scroll-content">

<RocznikHeader heading />

<div class="start-lead">
  <p>Doświadczenie jest aktywnością sieci Twojego mózgu: od środka czytasz te słowa, a z boku przyrządy mierzą rzut tej samej aktywności.</p>
  <p>Rocznik 2026 prowadzi tę myśl przez zajęcia tego roku: każde zajęcia to wątek, który przechodzi przez osnowy od społeczeństwa po fizykę, a każde miejsce, w którym je splata, to karta.</p>
</div>

<section class="start-latest" aria-labelledby="ostatnie">
  <div class="start-latest-head">
    <div>
      <p class="start-latest-kicker" style={'color:' + COL[latest.c]} id="ostatnie">Ostatnie zajęcia · {latest.course} · {latest.date}</p>
      <h2 class="start-latest-title">{latest.title}</h2>
    </div>
    <a class="start-latest-all" href={latest.url}>Cały wątek →</a>
  </div>
  <div class="start-cards">
    {fresh.map((s) => (
      <a class="start-card" href={s.url} style={'border-color:' + COL[clsOf(s)] + '55'}>
        <span class="start-card-os" style={'color:' + INK[groupOf[s.o]]}>{s.o}</span>
        <h3>{s.h}</h3>
        <p>{s.d}</p>
        <span class="start-card-enter" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="4" r="2" fill="currentColor" stroke="none"></circle><path d="M6 7 V12 Q6 16 10 16 H18"></path><path d="M14.5 12.5 L18 16 L14.5 19.5"></path></svg></span>
      </a>
    ))}
  </div>
</section>

<div class="start-plotno-head">
  <p class="section-label">Płótno</p>
  <p class="section-title">Cały rok: zajęcia na osnowach</p>
</div>
<div class="start-plotno"><Board view="plotno" /></div>


<div class="divider"><span class="divider-icon">&#9998;</span></div>

<!-- Questions -->
<div class="questions-section">
  <p class="section-label">Pytania, które stawiamy</p>
  <p class="section-title">Tam, gdzie dyscypliny się spotykają</p>

  <div class="question-item">
    <button class="question-trigger">
      <span class="q-icon">&#10022;</span>
      <span class="q-text">Skąd wiesz, że to, co widzisz, jest prawdziwe?</span>
    </button>
    <div class="question-body"><div class="question-body-inner">
      <div class="q-voices">
        <p class="q-voices-label">Tak pytali studenci</p>
        <p class="q-voice">Czy jestem realna... Często robię coś i dopiero później mam moment derealizacji.</p>
        <p class="q-voice">Co jeśli nic co się dzieje czy co widzę nie jest realne?</p>
        <p class="q-voice">Czy jestem w matrixie?</p>
        <p class="q-voice">Dlaczego ludzie z tej samej sytuacji wychodzą z zupełnie innymi wnioskami?</p>
      </div>
      <div class="q-areas">
        <span class="q-area">Percepcja</span>
        <span class="q-area">Filozofia umysłu</span>
        <span class="q-area">Neurobiologia zmysłów</span>
      </div>
      {kartyOf("Skąd wiesz, że to, co widzisz, jest prawdziwe?").length > 0 && (
        <div class="q-karty"><span class="q-karty-label">Karty</span>{kartyOf("Skąd wiesz, że to, co widzisz, jest prawdziwe?").map((s) => <a href={s.url} style={'color:' + COL[clsOf(s)] + ';border-color:' + COL[clsOf(s)] + '66'}>{s.h}</a>)}</div>
      )}
    </div></div>
  </div>

  <div class="question-item">
    <button class="question-trigger">
      <span class="q-icon">&#10022;</span>
      <span class="q-text">Dlaczego czasem sny wydają się bardziej realne niż rzeczywistość?</span>
    </button>
    <div class="question-body"><div class="question-body-inner">
      <div class="q-voices">
        <p class="q-voices-label">Tak pytali studenci</p>
        <p class="q-voice">Co się dzieje w naszym mózgu kiedy śnimy? Dlaczego to wszystko wydaje się tak bardzo realne?</p>
        <p class="q-voice">Skąd w śnie bierze się ta świadomość, że śnimy?</p>
        <p class="q-voice">Czy niewidzący widzi swoje sny?</p>
        <p class="q-voice">Czy sny faktycznie mogą mieć znaczenie? Czy sny prorocze to prawda czy zwykła bujda?</p>
      </div>
      <div class="q-areas">
        <span class="q-area">Świadomość</span>
        <span class="q-area">Neurobiologia snu</span>
        <span class="q-area">Psychologia poznawcza</span>
      </div>
      {kartyOf("Dlaczego czasem sny wydają się bardziej realne niż rzeczywistość?").length > 0 && (
        <div class="q-karty"><span class="q-karty-label">Karty</span>{kartyOf("Dlaczego czasem sny wydają się bardziej realne niż rzeczywistość?").map((s) => <a href={s.url} style={'color:' + COL[clsOf(s)] + ';border-color:' + COL[clsOf(s)] + '66'}>{s.h}</a>)}</div>
      )}
    </div></div>
  </div>

  <div class="question-item">
    <button class="question-trigger">
      <span class="q-icon">&#10022;</span>
      <span class="q-text">Czy Twoje decyzje podejmujesz Ty, czy Twój mózg podejmuje je za Ciebie?</span>
    </button>
    <div class="question-body"><div class="question-body-inner">
      <div class="q-voices">
        <p class="q-voices-label">Tak pytali studenci</p>
        <p class="q-voice">Czy we mnie jest dusza czy to wszystko działanie mojego mózgu i wyobrażanie sobie błędnie że kieruje mną moje ja?</p>
        <p class="q-voice">Czy jest jakiś mechanizm wychodzenia z błędnego koła i paraliżu decyzyjnego?</p>
        <p class="q-voice">Ile w życiu mam siły sprawczej, a ile rzeczy to przypadek?</p>
      </div>
      <div class="q-areas">
        <span class="q-area">Wolna wola</span>
        <span class="q-area">Neuronauka decyzji</span>
        <span class="q-area">Filozofia umysłu</span>
      </div>
      {kartyOf("Czy Twoje decyzje podejmujesz Ty, czy Twój mózg podejmuje je za Ciebie?").length > 0 && (
        <div class="q-karty"><span class="q-karty-label">Karty</span>{kartyOf("Czy Twoje decyzje podejmujesz Ty, czy Twój mózg podejmuje je za Ciebie?").map((s) => <a href={s.url} style={'color:' + COL[clsOf(s)] + ';border-color:' + COL[clsOf(s)] + '66'}>{s.h}</a>)}</div>
      )}
    </div></div>
  </div>

  <div class="question-item">
    <button class="question-trigger">
      <span class="q-icon">&#10022;</span>
      <span class="q-text">Co sprawia, że nie możesz przestać scrollować, choć wiesz, że powinieneś?</span>
    </button>
    <div class="question-body"><div class="question-body-inner">
      <div class="q-voices">
        <p class="q-voices-label">Tak pytali studenci</p>
        <p class="q-voice">Gdy jestem zmęczona sięgam po reelsy. Jest to odruchowe. Próbowałam wszystkie znane mi metody i wciąż umiem się zasiedzieć wbrew mojej woli.</p>
        <p class="q-voice">Wiem że muszę być konsekwentna, ale chęć zmiany zawsze jest mniej ważna od lenistwa i ciągłej prokrastynacji. Większość życia byłam sparaliżowana do działania.</p>
        <p class="q-voice">Dlaczego jak myślę o wpisywaniu hasła do telefonu to zapominam numerki, ale jak zrobię to bez myślenia to automatycznie to robię?</p>
      </div>
      <div class="q-areas">
        <span class="q-area">Nawyki</span>
        <span class="q-area">Układ nagrody</span>
        <span class="q-area">Pamięć proceduralna</span>
        <span class="q-area">Psychologia motywacji</span>
      </div>
      {kartyOf("Co sprawia, że nie możesz przestać scrollować, choć wiesz, że powinieneś?").length > 0 && (
        <div class="q-karty"><span class="q-karty-label">Karty</span>{kartyOf("Co sprawia, że nie możesz przestać scrollować, choć wiesz, że powinieneś?").map((s) => <a href={s.url} style={'color:' + COL[clsOf(s)] + ';border-color:' + COL[clsOf(s)] + '66'}>{s.h}</a>)}</div>
      )}
    </div></div>
  </div>

  <div class="question-item">
    <button class="question-trigger">
      <span class="q-icon">&#10022;</span>
      <span class="q-text">Dlaczego nie możesz poczuć tego, co czuje ktoś inny?</span>
    </button>
    <div class="question-body"><div class="question-body-inner">
      <div class="q-voices">
        <p class="q-voices-label">Tak pytali studenci</p>
        <p class="q-voice">Nigdy nie będę wiedzieć w jaki sposób się ktoś czuje lub co ktoś myśli, bo nie jestem w stanie się połączyć z drugą osobą myślami.</p>
        <p class="q-voice">To jak samotni jesteśmy przez to, że nasze receptory tylko odbierają świat i my jako świadomość nie możemy z nim wejść w pełną interakcję.</p>
        <p class="q-voice">Ludzie są tak skomplikowani, że jednocześnie mnie to okropnie fascynuje, ale też trochę przeraża.</p>
      </div>
      <div class="q-areas">
        <span class="q-area">Teoria umysłu</span>
        <span class="q-area">Empatia</span>
        <span class="q-area">Konstrukcja agenta</span>
        <span class="q-area">Izolacja epistemiczna</span>
      </div>
      {kartyOf("Dlaczego nie możesz poczuć tego, co czuje ktoś inny?").length > 0 && (
        <div class="q-karty"><span class="q-karty-label">Karty</span>{kartyOf("Dlaczego nie możesz poczuć tego, co czuje ktoś inny?").map((s) => <a href={s.url} style={'color:' + COL[clsOf(s)] + ';border-color:' + COL[clsOf(s)] + '66'}>{s.h}</a>)}</div>
      )}
    </div></div>
  </div>

  <div class="question-item">
    <button class="question-trigger">
      <span class="q-icon">&#10022;</span>
      <span class="q-text">Kim właściwie jesteś, kiedy nikt nie patrzy?</span>
    </button>
    <div class="question-body"><div class="question-body-inner">
      <div class="q-voices">
        <p class="q-voices-label">Tak pytali studenci</p>
        <p class="q-voice">Kim tak naprawdę jestem i czego tak naprawdę chcę?</p>
        <p class="q-voice">Jaki jest rdzeń danego człowieka i jak to się dzieje, że okoliczności czasem nie są w stanie go zmienić?</p>
