<Base title="Drugi mózg z AI - kogni.pl" activePage="kursy">

<style is:global>
  .course-page { max-width: 720px; margin: 0 auto; padding: 48px 24px 80px; }
  .course-page h1 { font-family: var(--font-display); font-size: 36px; font-weight: 400; color: var(--text-primary); letter-spacing: 2px; margin-bottom: 8px; text-align: center; }
  .course-page .meta { font-family: var(--font-body); font-size: 12px; font-weight: 300; color: var(--text-dim); text-align: center; letter-spacing: 1px; margin-bottom: 48px; }
  .course-page h2 { font-family: var(--font-display); font-size: 22px; font-weight: 500; color: var(--text-primary); margin: 48px 0 16px; letter-spacing: 1px; }
  .course-page h3 { font-family: var(--font-display); font-size: 17px; font-weight: 500; color: var(--text-primary); margin: 32px 0 12px; }
  .course-page p { font-family: var(--font-body); font-size: 15px; font-weight: 300; color: var(--text-secondary); line-height: 1.8; margin-bottom: 16px; }
  .back-link { display: inline-block; font-family: var(--font-body); font-size: 12px; font-weight: 400; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-dim); text-decoration: none; margin-bottom: 32px; transition: color 0.3s; }
  .back-link:hover { color: var(--warm-glow); }

  html { scroll-behavior: smooth; }

  .section-divider { width: 32px; height: 1px; background: var(--border-warm); opacity: 0.4; margin: 20px 0; }
  .section-badge { font-family: var(--font-body); font-size: 10px; font-weight: 500; letter-spacing: 2px; text-transform: uppercase; color: var(--warm-glow); opacity: 0.7; margin-bottom: 8px; display: block; }

  /* ─── Tab navigation ─── */
  .dm-tabs {
    display: flex;
    align-items: flex-start;
    gap: 0;
    margin: 0 0 40px;
    position: relative;
  }
  .dm-tab {
    flex: 1;
    text-align: center;
    position: relative;
  }
  .dm-tab::after {
    content: '';
    position: absolute;
    top: 18px;
    right: -1px;
    width: 100%;
    height: 1px;
    background: var(--border-subtle);
    z-index: 0;
  }
  .dm-tab:last-child::after { display: none; }
  .dm-tab button {
    all: unset;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    width: 100%;
  }
  .dm-tab-dot {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 10px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    color: var(--text-dim);
    position: relative;
    z-index: 1;
    transition: all 0.3s;
  }
  .dm-tab button:hover .dm-tab-dot {
    border-color: var(--border-warm);
    opacity: 1;
  }
  .dm-tab.viewing .dm-tab-dot {
    border-color: var(--warm-glow) !important;
    color: var(--warm-glow) !important;
    background: rgba(232, 168, 76, 0.06) !important;
    opacity: 1 !important;
  }
  .dm-tab-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-dim);
    line-height: 1.4;
  }
  .dm-tab.viewing .dm-tab-label {
    color: var(--text-secondary);
  }

  /* Tab panels */
  .dm-panel { display: none; }
  .dm-panel.active { display: block; }

  /* ─── Pill card ─── */
  .pill-card { border: 1px solid var(--border-warm); background: linear-gradient(135deg, rgba(232,168,76,0.04), transparent); padding: 28px 28px 24px; margin: 32px 0 48px; position: relative; }
  .pill-card::before { content: ''; position: absolute; inset: 4px; border: 1px solid rgba(232,168,76,0.08); pointer-events: none; }
  .pill-card-label { font-family: var(--font-body); font-size: 10px; font-weight: 500; letter-spacing: 2px; text-transform: uppercase; color: var(--warm-glow); margin-bottom: 10px; }
  .pill-card-title { font-family: var(--font-display); font-size: 20px; font-weight: 500; color: var(--text-primary); margin-bottom: 8px; letter-spacing: 0.5px; }
  .pill-card-desc { font-family: var(--font-body); font-size: 14px; font-weight: 300; color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px; }
  .pill-card-steps { font-family: var(--font-body); font-size: 14px; font-weight: 300; color: var(--text-secondary); line-height: 1.7; padding-left: 20px; margin: 0 0 20px; }
  .pill-card-steps li { margin-bottom: 6px; }
  .pill-card-steps a { color: var(--warm-glow); text-decoration: none; }
  .pill-card-steps a:hover { text-decoration: underline; }



  /* Section gate */
  .section-gate { border: 1px solid var(--border-subtle); background: var(--bg-card); padding: 32px 28px; margin: 48px 0; text-align: center; }
  .section-gate-label { font-family: var(--font-display); font-style: italic; font-size: 14px; color: var(--text-dim); margin-bottom: 16px; }
  .section-gate-form { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; }
  .section-gate-input { background: var(--bg-deep); border: 1px solid var(--border-subtle); color: var(--text-primary); font-family: var(--font-body); font-size: 14px; font-weight: 300; padding: 8px 16px; text-align: center; width: 180px; outline: none; transition: border-color 0.3s; letter-spacing: 1px; }
  .section-gate-input:focus { border-color: var(--border-warm); }
  .section-gate-input::placeholder { color: var(--text-dim); font-style: italic; letter-spacing: 0; }
  .section-gate-submit { background: none; border: 1px solid var(--border-subtle); color: var(--text-dim); font-family: var(--font-body); font-size: 11px; font-weight: 400; letter-spacing: 1.5px; text-transform: uppercase; padding: 9px 20px; cursor: pointer; transition: all 0.3s; }
  .section-gate-submit:hover { color: var(--warm-glow); border-color: rgba(232,168,76,0.25); background: var(--warm-glow-soft); }
  .section-gate-error { font-family: var(--font-display); font-style: italic; font-size: 13px; color: var(--accent-red, #c75050); margin-top: 10px; opacity: 0; transition: opacity 0.3s; height: 18px; }
  .section-gate-error.visible { opacity: 1; }
  .section-gate.unlocked { display: none; }

  .gated-section { display: none; }
  .gated-section.unlocked { display: block; }

  /* Tool section (PersonaBuilder wider container) */
  .tool-section { max-width: 1120px; margin: 0 auto; padding: 0 24px 80px; }
  .tool-intro { max-width: 720px; margin: 0 auto 32px; }
  .tool-intro h2 { font-family: var(--font-display); font-size: 26px; font-weight: 400; color: var(--text-primary); letter-spacing: 1px; margin-bottom: 12px; }
  .tool-intro p { font-family: var(--font-body); font-size: 15px; font-weight: 300; color: var(--text-secondary); line-height: 1.8; }

  .final-note { border-top: 1px solid var(--border-subtle); margin-top: 48px; padding-top: 32px; text-align: center; }
  .final-note p { font-family: var(--font-display); font-style: italic; font-size: 15px; color: var(--text-dim); line-height: 1.8; }

  /* ─── Pill download link ─── */
  .pill-download-link { color: var(--warm-glow); text-decoration: none; border-bottom: 1px solid rgba(232,168,76,0.3); transition: border-color 0.3s; }
  .pill-download-link:hover { border-color: var(--warm-glow); }

  /* ─── Skill library ─── */
</style>

