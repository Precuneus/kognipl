---
import Base from '../layouts/Base.astro';
---
<Base title="Kontakt - kogni.pl" activePage="kontakt">

<style is:global>
  /* Kontakt w stylu Rocznika: ciemne tło, złoto, karta jak na Płótnie, kropka z logo zamiast kreski (2026-10-20) */
  body:has(.kontakt){background:#0e0d0b}
  .kontakt{max-width:560px;margin:0 auto;padding:72px 24px 96px;text-align:center}
  .kontakt h1{font-family:var(--font-display);font-size:40px;font-weight:400;line-height:1.2;color:#f0c060;text-shadow:0 0 14px rgba(240,192,96,.25);margin:0 0 36px;animation:fadeUp .8s ease-out both}
  .kontakt-card{background:#16140f;border:1px solid rgba(180,155,100,.2);border-radius:14px;padding:36px 28px 32px;animation:fadeUp .8s ease-out .15s both;transition:box-shadow .18s ease}
  .kontakt-card:hover{box-shadow:0 0 18px rgba(240,192,96,.12)}
  .kontakt-name{font-family:var(--font-display);font-size:28px;font-weight:500;line-height:1.15;color:#e2ddd4}
  .kontakt-role{font-family:var(--font-body);font-size:11.5px;font-weight:400;letter-spacing:.14em;text-transform:uppercase;color:#f0c060;margin-top:8px}
  .kontakt-line{width:9px;height:9px;border-radius:50%;background:#f0c060;margin:22px auto;box-shadow:0 0 0 3px #16140f,0 0 0 4.5px rgba(240,192,96,.9),0 0 14px 4px rgba(240,192,96,.4)}
  .kontakt-detail{font-family:var(--font-body);font-size:15px;font-weight:300;color:#e2ddd4;line-height:2}
  .kontakt-detail a{color:#e8a84c;text-decoration:none;border-bottom:1px solid rgba(232,168,76,.35);transition:color .18s ease,border-color .18s ease}
  .kontakt-detail a:hover{color:#f0c060;border-color:#f0c060}
  @media (max-width:720px){.kontakt{padding:48px 16px 72px}.kontakt h1{font-size:32px}}
</style>

<div class="kontakt">
  <h1>Kontakt</h1>

  <div class="kontakt-card">
    <div class="kontakt-name">Olgierd Borowiecki</div>
    <div class="kontakt-role">asystent naukowo-dydaktyczny</div>
    <div class="kontakt-line"></div>
    <div class="kontakt-detail">
      <a href="mailto:o.borowiecki@uwb.edu.pl">o.borowiecki@uwb.edu.pl</a><br>
      pok. 316 · dyżur: środa 15:00–16:30<br>
      Wydział Filozofii i Kognitywistyki<br>
      Uniwersytet w Białymstoku<br>
      Kampus UwB, ul. Ciołkowskiego 1S, 15-245 Białystok
    </div>
  </div>
</div>

</Base>
