---
import Base from '../../layouts/Base.astro';
import KartaWiki from '../../components/KartaWiki.astro';
import { INK, WIKI_ON, KARTY, NETN, card, netCard, segs } from '../../karty/data.js';
import { KOLOR } from '../../karty/mozg.js';
// pierwszy artykuł wiki: karta Kognitywistyka w szablonie karty (jego słowo, 2026-10-22)
const pierwsza = card('Kognitywistyka');

// Lista sieci: każda sieć w kolorze ze strony startowej, z liczbą kart, które ją wskazują w części Sieć mózgowa (jego, 2026-10-23:
// *Build the brain index first*); rysunek mózgu z tej listy przeszedł do Atlasu (2026-11-10).
// osiem sieci modelu strony; sieć limbiczna osobno od domyślnej (jego słowo, 2026-11-09)
// kolory sieci ze strony startowej (mozg.js, 2026-10-23)
const ROLA = { VIS: '„Widzę.”', SMN: '„Czuję ciało i się ruszam.”', DAN: '„Koordynuję oko i rękę.”', VAN: '„Coś przerywa plan.”', SN: '„Coś zagraża schematowi ciała.”', CN: '„Dążę do celu.”', LIM: '„Coś mnie przyciąga albo odpycha.”', DMN: '„Ja, przeszłość i przyszłość, inni ludzie.”' };
const plain = (t) => segs(t).map((s) => s.t).join('');
const ile = (n) => n + ' ' + (n === 1 ? 'karta' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? 'karty' : 'kart');
const SIECI = Object.keys(KOLOR).map((kod) => {
  const own = netCard(kod);
  const karty = KARTY.filter((k) => k !== own && k.nets.some((n) => n[0] === kod))
    .map((k) => ({ h: k.h, url: k.url, g: k.g, why: plain((k.nets.find((n) => n[0] === kod && !n[2]) || k.nets.find((n) => n[0] === kod))[1]) }));
  return { kod, nazwa: NETN[kod], kolor: KOLOR[kod], rola: ROLA[kod], own, karty };
}).filter((s) => s.karty.length);
// Indeks powstaje dopiero, gdy choć jedna karta jest gotowa.
export function getStaticPaths() {
  return WIKI_ON ? [{ params: { indeks: undefined } }] : [];
}
---
<Base title="Wiki · kogni.pl" activePage="wiki" description={String((pierwsza && pierwsza.def) || '').replace(/<!--\[[so]:[^\]]*\]-->/g, '').trim()}>
  <div class="wi">
    {/* lista sieci w prawym panelu pierwszego artykułu, w miejscu jego części Sieć mózgowa (jego słowo, 2026-10-23: *embed the sieci mozgowe in the wiki main page to the panel to the right*) */}
    {pierwsza ? (
      <KartaWiki k={pierwsza} wstep>
        {SIECI.length > 0 && (
          <section slot="siec" class="wk-box wn" id="sieci" aria-labelledby="wn-h">
            <h2 id="wn-h">Sieci mózgu</h2>
            {/* lista sieci bez rysunku: mózg stoi w Atlasie, a nazwa sieci go otwiera (jego słowa, 2026-11-10: *lets remove the graphics of the
                sieci mozgowe from the wiki. We will link them to the atlas*) */}
            <p class="wn-lead">Wybierz sieć, żeby zobaczyć ją w atlasie.</p>
            <ul class="sieci-legend wn-legend" aria-label="Sieci mózgu">
              {/* link do karty sieci na jej nazwie, bez okna pod listą (jego słowo, 2026-11-09: *the link to the given network should be next
                  to its name. Remove this pop-up window below the list*); karta sieci stoi w Atlasie, więc nazwa otwiera Atlas na niej (2026-11-11) */}
              {SIECI.map((s) => (
                <li class="wn-row" style={'--c:' + s.kolor}>
                  <span class="sieci-sw" aria-hidden="true"></span>
                  <span class="sieci-txt"><a class="wn-sel" href={s.own ? s.own.url : '/atlas/#siec-' + s.kod.toLowerCase()} data-k={s.kod}><span class="sieci-kod">{s.kod}</span> <span class="sieci-nazwa">{s.nazwa}</span></a>{s.rola && <span class="wn-rola">{s.rola}</span>}<span class="wn-n">{ile(s.karty.length)}</span></span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </KartaWiki>
    ) : <h1 class="sr-only">kogni.pl/wiki</h1>}
  </div>
</Base>

<script>
  import { mozg } from '../../rocznik/2026/ryciny/zywe/mozg.js';
  document.querySelectorAll('.wz-zywa[data-zywa="mozg"]').forEach((el) => mozg(el as HTMLElement));
  import { iskraKursu } from '../../karty/iskra.js';
  iskraKursu();
</script>

<style is:global>
/* wiki stoi pośrodku okna (jego słowo, 2026-10-23: *center the wiki*); na telefonie 20px od brzegów */
.wi{max-width:1168px;margin:0 auto;padding:64px 24px 80px}
.wi-cards{display:flex;flex-wrap:wrap;gap:6px 8px}
.wi-cards a{display:inline-flex;align-items:center;text-decoration:none;font-size:13.5px;min-height:32px;padding:4px 12px;border-radius:999px;border:1px solid color-mix(in srgb,var(--c) 40%,transparent);color:var(--c)}
@media (max-width:720px){.wi{margin:0 20px;padding:32px 0 64px;max-width:none}}
/* lista sieci w prawym panelu pierwszego artykułu (2026-10-23), w jednej kolumnie; rysunek mózgu stoi w Atlasie (2026-11-10) */
.wn-lead{margin:0 0 14px;font-size:14px;line-height:1.6;color:#cfc8bb}
.wn-legend{margin:0;grid-template-columns:minmax(0,1fr);gap:2px}
.wn-legend li{margin:0}
.wn-row{position:relative;display:flex;gap:10px;align-items:flex-start;padding:7px 10px;border:1px solid transparent;border-radius:12px;transition:background .15s ease,border-color .15s ease}
.wn-row:hover,.wn-row.on{background:rgba(255,255,255,0.035);border-color:color-mix(in srgb,var(--c) 50%,transparent)}
.wn-legend .wn-sel{width:auto;display:inline;padding:0;margin:0;border:0;border-radius:0;background:none;text-align:left;font:inherit;color:inherit;cursor:pointer;text-decoration:none}
.wn-legend .wn-sel:hover{background:none;border:0}
.wn-sel::after{content:'';position:absolute;inset:0;border-radius:12px}
.wn-legend .wn-sel:focus-visible{outline:none}
.wn-sel:focus-visible::after{outline:2px solid #f0c060;outline-offset:2px}
.wn-legend .sieci-sw{flex-basis:12px;height:12px;margin-top:5px}
.wn-rola{display:block;font-family:var(--font-display);font-size:17px;line-height:1.3;color:var(--text-primary)}
.wn-n{display:block;font-size:12px;color:#8f877a}
@media (max-width:720px){.wn-row{padding:6px 8px;gap:8px}.wn-rola{display:none}}
</style>


