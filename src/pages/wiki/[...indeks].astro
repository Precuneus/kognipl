---
import Base from '../../layouts/Base.astro';
import { INDEX, INK, BASE, WIKI_ON } from '../../karty/data.js';
// Indeks powstaje dopiero, gdy choć jedna karta jest gotowa.
export function getStaticPaths() {
  return WIKI_ON ? [{ params: { indeks: undefined } }] : [];
}
---
<Base title="wiki · kogni.pl" activePage="wiki">
  <div class="wi">
    <h1 class="sr-only">kogni.pl/wiki</h1>
    <!-- wstęp: kognitywistyka jako interdyscyplinarne doświadczanie, łuk historii ze strony głównej, potem linki z Płótna (jego słowo, 2026-10-22) -->
    <div class="wi-intro">
      <p>Kognitywistykę traktuję jako interdyscyplinarne doświadczanie. Doświadczanie jest aktywnością sieci mózgowych, więc zmiany w mózgu, od uszkodzeń po naukę i rozwój, zmieniają to, czego doświadczasz. Znam tylko własne doświadczanie, a o Twoim wnioskuję. To wnioskowanie jest moim Modelem Mentalnym, a „ja” też jest Modelem Mentalnym, zmiennym jak Statek Tezeusza.</p>
      <p>Z zewnątrz człowieka opisują fizyka, biologia, psychologia i socjologia, a od wewnątrz jest doświadczanie. Każda dyscyplina wyjaśnia doświadczanie przyczynowo, ale sama opiera się na doświadczaniu. Wyjaśnienia zataczają więc koło. Sztorm u wybrzeża Krety 2500 lat temu wyjaśniano gniewem Posejdona, a dziś wyjaśnia go fizyka. Każdemu badaczowi ten sam sztorm wyjaśnia się inaczej: fizykowi wiatrem, biologowi ciałem żeglarza, psychologowi jego strachem, socjologowi zachowaniem załogi. Skoro doświadczają się wyjaśnienia, w tej wiki wyjaśniam doświadczanie wszystkimi dyscyplinami naraz.</p>
      <p>Na <a href="/2026/">Płótnie</a> widzisz osnowy każdej dyscypliny i zajęcia biegnące przez nie pionowymi wątkami. Tam, gdzie zajęcia spotykają osnowę, zawiązuje się splot, a jego okno prowadzi Cię do kart tej wiki. Klikając etykietę zajęć u góry Płótna, otwierasz ich opis, w którym karty też są linkami. Karty linkują do siebie nawzajem, więc do jednego pojęcia dojdziesz z kilku osnów. W części Na zajęciach karta pokazuje, które zajęcia do niej prowadzą.</p>
    </div>
    {INDEX.map((g) => (
      <section class="wi-group" id={g.nazwa.normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase()} style={'--ink:' + INK[g.g] + ';--base:' + BASE[g.g]}>
        <h2 class="wi-gname">{g.nazwa}</h2>
        {g.osnowy.map((o) => (
          <div class={'wi-os' + (o.n ? '' : ' wi-empty')} id={o.id}>
            <h3>{o.nazwa}</h3>
            {o.rodziny.map((r) => (
              <div class="wi-fam">
                <span class="wi-fname">{r.nazwa}</span>
                <span class="wi-cards">{r.karty.map((k) => <a href={k.url} style={'--c:' + INK[k.g]}>{k.h}</a>)}</span>
              </div>
            ))}
          </div>
        ))}
      </section>
    ))}
  </div>
</Base>

<style is:global>
/* kolumna zaczyna się na linii logo (8vw, na telefonie 20px), a wstęp ma pod menu oddech (2026-10-22) */
.wi{max-width:1120px;margin:0 8vw;padding:64px 0 80px}
.wi-intro{max-width:720px;margin:0 0 8px}
.wi-intro p{margin:0 0 14px;font-size:16.5px;line-height:1.75;color:#cfc8bb}
.wi-intro a{color:#f0c060;text-decoration:underline dotted 1px;text-underline-offset:4px}
.wi-group{margin-top:40px}
.wi-gname{margin:0 0 14px;font-size:12.5px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--ink);border-left:3px solid var(--base);padding-left:10px}
.wi-os{padding:16px 0;border-top:1px solid rgba(180,155,100,.12)}
.wi-os h3{margin:0 0 10px;font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:500;color:#e2ddd4}
.wi-empty h3{color:#5f584d}
.wi-fam{display:grid;grid-template-columns:220px minmax(0,1fr);gap:16px;padding:6px 0;align-items:baseline}
.wi-fname{font-size:13.5px;color:var(--ink)}
.wi-cards{display:flex;flex-wrap:wrap;gap:6px 8px}
.wi-cards a{display:inline-flex;align-items:center;text-decoration:none;font-size:13.5px;min-height:32px;padding:4px 12px;border-radius:999px;border:1px solid color-mix(in srgb,var(--c) 40%,transparent);color:var(--c)}
@media (max-width:720px){.wi{margin:0 20px;padding:32px 0 64px}.wi-fam{grid-template-columns:minmax(0,1fr);gap:6px}}
</style>
