---
import Base from '../../layouts/Base.astro';
import KartaWiki from '../../components/KartaWiki.astro';
import { KARTY } from '../../karty/data.js';
export function getStaticPaths() {
  return KARTY.map((k) => ({ params: { karta: k.id }, props: { k } }));
}
const { k } = Astro.props;
---
<Base title={k.h + ' · wiki · kogni.pl'} activePage="wiki">
  <KartaWiki k={k} />
</Base>
