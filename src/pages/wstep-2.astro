        <div class="session-row" style="color: color-mix(in srgb, var(--text-secondary) 70%, #4a86cc 30%)"><span class="s-key">s6</span> Sen i konsolidacja</div>
        <div class="session-row" style="color: color-mix(in srgb, var(--text-secondary) 70%, #8aab6a 30%)"><span class="s-key">s7</span> Neuroróżnorodność (ADHD, autyzm)</div>
        <div class="session-row" style="color: color-mix(in srgb, var(--text-secondary) 70%, #c4a55a 30%)"><span class="s-key">s8</span> Pojęcia i myślenie</div>
        <div class="session-row" style="color: color-mix(in srgb, var(--text-secondary) 70%, #ab6a8a 30%)"><span class="s-key">s9</span> Wolna wola i poznanie moralne</div>
        <div class="session-row" style="color: color-mix(in srgb, var(--text-secondary) 70%, #4a9d9d 30%)"><span class="s-key">s10</span> Psychodeliki</div>
        <div class="session-row" style="color: color-mix(in srgb, var(--text-secondary) 70%, #7a6bbf 30%)"><span class="s-key">s11</span> Reprezentacjonizm a percepcja bezpośrednia</div>
