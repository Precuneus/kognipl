---
// Symulacje: model przepływów z wątku kursu („Pierwszy krok”) na własnej stronie, na prawo od Atlasu (jego słowa, 2026-11-20: *Maybe
// Symulacje subpage? Right to Atlas. We wante to put it optimised in a separate subpage, not the same what Atlas is*). Własny silnik
// i własne dane w public/images/symulacje/; źródło modelu: THREADS/COURSES/01 Neurokogni/2026-11-20 Model przepływów/.
import Base from '../layouts/Base.astro';
import '../styles/wiki.css';
import { KARTY, INK } from '../karty/data.js';
// karty sceny pod modelem, chipami do wiki
const KARTY_SCEN = {
  chod: ['Propriocepcja', 'Predykcja', 'Zaskoczenie', 'Bioinformacja'],
  kubek: ['Propriocepcja', 'Predykcja', 'Zaskoczenie', 'Bioinformacja'],
  kuchnia: ['Drogi jąder podstawy', 'Działanie celowe i nawykowe', 'Dopaminowe zaskoczenie nagrodą'],
  wstawac: ['Predykcja', 'Zaskoczenie', 'Bioinformacja'],
  mysl: ['Sieć domyślna', 'Sieć kontroli', 'Sieć grzbietowa uwagi', 'Sieć istotności', 'Spirala jąder podstawy', 'Eksperyment Libeta', 'Dopaminowe zaskoczenie nagrodą'],
};
const chipy = Object.fromEntries(Object.entries(KARTY_SCEN).map(([sc, h]) => [sc, h.map((n) => KARTY.find((k) => k.h === n)).filter(Boolean)]));
const opis = 'W modelu predykcji i zaskoczenia postać idzie, sięga po kubek, otwiera szafkę, wstaje z krzesła i myśli o kawie, a mózg obok pokazuje, jak płyną w nim predykcje, pomiar i zaskoczenie.';
---
<Base title="Symulacje · model predykcji i zaskoczenia w mózgu · kogni.pl" activePage="symulacje" description={opis}>
<main class="sym">
<h1 class="sr">Symulacje. Model predykcji i zaskoczenia w mózgu</h1>
<div class="app">
  <div class="stage" id="stage">
    <div class="view" id="vB"><canvas id="cB" tabindex="0" aria-label="Mózg z przezroczystą korą. Drogami płyną naraz predykcje w stronę receptorów i pomiar od receptorów. Strzałki w lewo i w prawo wskazują kolejne stacje, a Escape zwalnia wskazaną."></canvas><div class="cie cie-x" data-os="x"><span class="kon">lewa</span><div class="tor"><span class="zost"></span><span class="gal" role="slider" tabindex="0" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="100" aria-label="Cięcie od lewej"></span><span class="gal" role="slider" tabindex="0" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="100" aria-label="Cięcie od prawej"></span></div><span class="kon">prawa</span></div><div class="cie cie-y" data-os="y"><span class="kon">tył</span><div class="tor"><span class="zost"></span><span class="gal" role="slider" tabindex="0" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="100" aria-label="Cięcie od tyłu"></span><span class="gal" role="slider" tabindex="0" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="100" aria-label="Cięcie od przodu"></span></div><span class="kon">przód</span></div><div class="cie cie-z" data-os="z"><span class="kon">góra</span><div class="tor"><span class="zost"></span><span class="gal" role="slider" tabindex="0" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-label="Cięcie od góry"></span><span class="gal" role="slider" tabindex="0" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-label="Cięcie od dołu"></span></div><span class="kon">dół</span></div></div>
    <div class="view" id="vF"><canvas id="cF" aria-label="Postać, jej rdzeń kręgowy, nerwy rąk i nóg, zakresy stawów"></canvas></div>
    <svg id="link" aria-hidden="true"><circle id="lpk" r="4.5" fill="#ff5340" opacity="0"/><path id="lp" fill="none" stroke="rgba(240,192,96,.10)" stroke-width="1"/><path id="lb" fill="none" stroke="#5f8fff" stroke-width="2.2" stroke-dasharray="16 12" stroke-linecap="round"/><path id="lr" fill="none" stroke="#ff5340" stroke-width="1.6" stroke-dasharray="4 3" stroke-linecap="round"/><g id="lead"></g></svg>
    <div id="tags"></div>
  </div>
  <div class="bar">
    <div class="btns">
      <button id="bPlay" aria-label="Pauza">⏸</button>
      <button id="bView" aria-label="Widok od nowa">↻</button>
      <button id="bOsobno" aria-pressed="false" title="Obracaj mózg i postać osobno">Obrót osobno</button>
      <button id="bWolno" aria-pressed="false" aria-label="Tempo dziesięć razy wolniej">0,1×</button>
      <button id="bNazwy" aria-pressed="true" title="Nazwy regionów przy mózgu">Nazwy</button>
      <button id="sChod" class="sc" aria-pressed="true">Chodzenie</button><button id="sKubek" class="sc" aria-pressed="false">Sięganie</button><button id="sKuchnia" class="sc" aria-pressed="false">Otwieranie</button><button id="sWstawac" class="sc" aria-pressed="false">Wstawanie</button><button id="sMysl" class="sc" aria-pressed="false">Myślenie</button>
      <button id="bSeq" aria-pressed="false">Po kolei</button>
      <span class="seq" id="seq" hidden><button id="bPrev" aria-label="Poprzednia część">‹</button><span id="seqN" aria-live="polite"></span><button id="bNext" aria-label="Następna część">›</button></span>
    </div>
    <div class="chips" id="chips">
      <button class="chip" data-c="P" aria-pressed="false"><i style="background:var(--beta)"></i>predykcje · wolniejszy rytm</button>
      <button class="chip" data-c="M" aria-pressed="false"><i style="background:var(--gamma)"></i>pomiar · szybszy rytm</button>
      <button class="chip" data-c="D" aria-pressed="false" hidden><i style="background:var(--dopa)"></i>dopamina</button>
    </div>
    <div class="ex" id="ex" aria-live="polite"></div>
  </div>
</div>
<section aria-label="Scenariusze" class="wk-box sym-karty">
  <h2>Scenariusze</h2>
  <ol class="sym-scn" id="scn"></ol>
  <div class="sym-kart" id="kart">
  <h2>Karty</h2>
  {Object.entries(chipy).filter(([, ks]) => ks.length).map(([sc, ks]) => (
    <div class="wk-chips" data-scena={sc} hidden={sc !== 'chod'}>
      {ks.map((k) => <a href={k.url} class="wk-chip" style={'--c:' + INK[k.g]}>{k.h}</a>)}
    </div>
  ))}
  </div>
</section>
<div class="foot sym-zrodla">Ruch biegnie w czasie rzeczywistym i zwalnia w chwili zaskoczenia, żeby było widać, którędy zaskoczenie płynie. Kolory pokazują hipotezę Bastosa i współpracowników (2012) o zaskoczeniu płynącym szybszymi rytmami niż predykcje.<!--[s:bastos2012-errors-higher-frequencies]--> Rytmy są pokazane wolniej, w tej samej proporcji; w korze wzrokowej makaka połączenia w stronę receptorów pracują w rytmie beta, około 14–18 Hz, a połączenia od receptorów w rytmie theta, około 4 Hz, oraz w rytmie gamma, około 60–80 Hz (Bastos i in. 2015)<!--[s:bastos2015-gamma-ff-beta-fb]-->. U ludzi przy chwycie precyzyjnym rytm beta, 15–30 Hz, płynie między korą a mięśniami dłoni w obu kierunkach, z opóźnieniem około 23 ms w każdą stronę (Witham i in. 2011)<!--[s:witham2011-beta-cmc-both-directions]--><!--[s:witham2011-loop-delays-each-way]-->, a włókna czuciowe wrzecion mięśniowych, jak się wydaje, szczególnie dobrze przewodzą go z mięśni do ośrodkowego układu nerwowego (Baker 2007)<!--[s:baker2007-spindles-expected-actual-beta]-->. Model przepływu według aktywnego wnioskowania, active inference (Adams, Shipp i Friston 2013)<!--[s:adams2013-proprioceptive-predictions-reflex-arc]-->. Pętle jąder podstawy według Alexandra, DeLonga i Stricka (1986)<!--[s:alexander1986-motor-loop-through-vlo]--><!--[s:alexander1986-prefrontal-loop-through-va-md]-->, projekcje kory i neuronów dopaminowych do prążkowia według Haber (2003)<!--[s:haber2003-frontal-gradient-into-striatum]--><!--[s:haber2003-ventral-tier-snc-to-dorsal-striatum]-->. Pętla móżdżku według Kelly i Stricka (2003)<!--[s:kelly2003-cerebrocerebellar-closed-loops]-->, uczenie się móżdżku z zaskoczenia czuciowego według Tsenga i współpracowników (2007)<!--[s:tseng2007-sensory-prediction-errors-drive-adaptation]-->, badających adaptację sięgania u ludzi. Pęczek skośny czołowy według Cataniego i współpracowników (2012)<!--[s:catani2012-frontal-aslant-tract]-->, pęczek podłużny górny III według Thiebaut de Schotten i współpracowników (2011)<!--[s:thiebautdeschotten2011-slf-iii-ventral-right-lateralized]-->, obręcz według Bubb, Metzler-Baddeley i Aggletona (2018)<!--[s:bubb2018-cingulum-frontal-parietal-course]-->. Aktywność aksonów dopaminowych przed początkiem biegu u myszy według badania (Howe i Dombeck 2016)<!--[s:howe2016-transients-lead-locomotion-initiation]-->, wpływ pobudzania neuronów dopaminowych na chwilę ruchu według badania (Hamilos i in. 2021)<!--[s:hamilos2021-activation-earlier-inhibition-later]-->, działanie dopaminy na drogi prążkowia według przeglądu (Gerfen i Surmeier 2011)<!--[s:gerfen2011-d1-raises-d2-lowers-spn-excitability]-->. Pierwsza minuta po wstaniu według przeglądu (Harms i in. 2021)<!--[s:harms2021-hr-abrupt-in-first-3s]--><!--[s:harms2021-pressure-nadir-at-8s-baroreflex-recovery]-->, drogi bioinformacji z wnętrza ciała i model EPIC, Embodied Predictive Interoception Coding, według przeglądu (Khalsa i in. 2018)<!--[s:khalsa2018-afferent-pathways]--><!--[s:khalsa2018-epic-predictions-insula]-->. Kora z szablonu MNI ICBM152 2009c (Fonov i in. 2011), obszary z Allen Human Reference Atlas 3D (CC BY 4.0), jądra pod korą z CIT168 (Pauli, Nili i Tyszka 2018, CC BY 4.0), sieci Yeo i in. 2011 w parcelacji Schaefera i in. 2018. Drogi, także korowo-prążkowiowe, z atlasu HCP-1065 (Yeh 2022, CC BY-SA 4.0), dane Human Connectome Project (WU-Minn, Van Essen i Ugurbil). Predykcje hamujące drogi przewidzianej bioinformacji według modelu trasowania predykcyjnego, predictive routing (Bastos i in. 2020)<!--[s:bastos2020-predictions-inhibit-prepared-pathways]-->. Cienkie łuki łączą obszary bez wspólnej drogi w atlasie i pochodzą z modelu. W scenie Myślenie sieć domyślna po falach ostrych hipokampa u makaków według badania (Kaplan i in. 2016)<!--[s:kaplan2016-ripples-increase-dmn-selectively]--><!--[s:kaplan2016-dmn-rise-lags-ripple-onset]-->, fale ostre według przeglądu (Buzsáki 2015)<!--[s:buzsaki2015-spw-duration-replay-compression]-->, rytm theta hipokampa przy planowaniu drogi według badania (Kaplan i in. 2020)<!--[s:kaplan2020-theta-planning-novel-mazes]-->, planowanie w sieciach domyślnej, kontroli i grzbietowej uwagi według badania (Spreng i in. 2010)<!--[s:spreng2010-autobiographical-planning-dmn]-->, wyobrażanie ruchu według metaanalizy (Hétu i in. 2013)<!--[s:hetu2013-mi-fronto-parietal-m1-not-consistent]-->, spirala prążkowia według Haber, Fudge i McFarland (2000)<!--[s:haber2000-shell-core-central-dorsolateral]-->, sieci w prążkowiu według Choi, Yeo i Bucknera (2012)<!--[s:choi2012-seven-network-striatal-zones]-->, przełączanie sieci według modelu Menona i Uddin (2010)<!--[s:menon2010-salience-network-switching]-->, hamowanie w jądrach podstawy według hipotezy Minka (1996)<!--[s:mink1996-inhibit-competing-programs]-->, rytm beta przy ruchu według przeglądu (Kilavik i in. 2013)<!--[s:kilavik2013-beta-low-during-movement-rebounds-after]-->, chwila zgłaszanej chęci ruchu, około 150 ms przed nim, według badania (Schurger, Sitt i Dehaene 2012)<!--[s:schurger2012-neural-decision-distinct]-->. Ruch postaci z bazy CMU Graphics Lab Motion Capture Database (mocap.cs.cmu.edu), powstałej ze środków NSF EIA-0196217.</div>
</main>
</Base>

<style is:global>
.sym{--bg:#0e0d0b;--panel:#16140f;--line:rgba(180,155,100,.22);--fg:#e2ddd4;--fg2:#a09888;--candle:#f0c060;--beta:#5f8fff;--gamma:#ff5340;--dopa:#b98cff;--tag:#1c1a14;--font-d:'Cormorant Garamond',Georgia,serif;--font-b:Inter,system-ui,-apple-system,sans-serif;color-scheme:dark}
.sym .app{height:calc(100svh - var(--sym-gora,64px));display:grid;grid-template-rows:minmax(0,1fr) auto;gap:10px;padding-block:12px;box-sizing:border-box}
.sym .stage{position:relative;display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:12px;min-height:0}
.sym .view{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:16px;overflow:hidden;min-height:0}
.sym .view canvas{display:block;width:100%;height:100%;touch-action:none}
.sym #vB canvas{cursor:grab}
.sym #link{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}
.sym #tags{position:absolute;inset:0;pointer-events:none}
.sym .tag{position:absolute;left:0;top:0;background:var(--tag);border:1px solid rgba(240,192,96,.45);border-radius:8px;padding:3px 9px;font-size:12px;font-weight:500;color:#efe8dc;white-space:nowrap;opacity:0;transition:opacity .25s}
.sym .tag.on{opacity:1}
.sym .tag.side{padding:1px 7px;font-size:11px;color:var(--fg2);border-color:rgba(180,155,100,.35)}
/* the regions of a scene, named in a column at each side of the brain: always there, brighter while the region is in play (--w), gold while the ring points at it */
.sym .tag.kol{white-space:normal;max-width:132px;padding:3px 8px;font-size:11px;line-height:1.25;border-color:rgba(240,192,96,calc(.16 + .5*var(--w,0)));transition:opacity .25s,border-color .25s}
.sym .tag.kol.pr{text-align:right}
.sym .tag.kol.on{opacity:calc(.6 + .4*var(--w,0));pointer-events:auto;cursor:default}
.sym .tag.kol.krag{border-color:var(--candle);color:#fff6e0}
@media (max-width:760px){.sym .tag.kol{max-width:84px;font-size:10px;line-height:1.15;padding:2px 4px;background:rgba(28,26,20,.82)}.sym .tag.kol:not(.pr){max-width:104px}}
.sym .bar{display:grid;grid-template-columns:auto minmax(0,1fr);gap:8px 14px;align-items:center}
.sym .btns{display:flex;gap:6px;align-items:center}
.sym button{font:inherit;color:var(--fg);background:var(--panel);border:1px solid var(--line);border-radius:10px;min-width:40px;height:36px;cursor:pointer;font-size:15px;padding:0 10px}
@media (hover:hover){.sym button:hover{border-color:rgba(240,192,96,.5)}}
.sym button:focus-visible{outline:2px solid var(--candle);outline-offset:2px}
.sym button[aria-pressed=true]{border-color:var(--candle)}
.sym #bSeq,.sym #bWolno,.sym .sc{font-size:13px;white-space:nowrap}
.sym .btns{flex-wrap:wrap}
.sym .seq{display:flex;gap:6px;align-items:center}
.sym .seq[hidden]{display:none}
.sym #seqN{font-size:13px;color:var(--fg);min-width:10em;text-align:center;white-space:nowrap}
.sym .chips{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.sym .chip{font-size:12px;color:var(--fg2);height:30px;padding:0 10px;display:inline-flex;align-items:center;gap:7px}
.sym .chip i{width:8px;height:8px;border-radius:50%;display:inline-block}
.sym .chip.dim{border-color:rgba(180,155,100,.1)}
.sym .chip.dim i{opacity:.3}
.sym #cB:focus-visible{outline:2px solid var(--candle);outline-offset:-3px}
.sym .chip[hidden]{display:none}
.sym .ex{grid-column:1/-1;font-family:var(--font-d);font-style:italic;font-weight:500;font-size:21px;line-height:1.35;height:2.7em;overflow:hidden;color:var(--fg)}
.sym .foot{grid-column:1/-1;font-size:11px;color:#8f8678;line-height:1.5}
.sym .err{position:absolute;inset:0;display:grid;place-items:center;color:var(--fg2);font-size:14px;padding:20px;text-align:center}
.sym .cie{position:absolute;z-index:3;display:flex;align-items:center;gap:10px;font:500 11px/1 var(--font-b);color:var(--fg2);letter-spacing:.04em}
.sym .cie-x,.sym .cie-y{left:50%;transform:translateX(-50%);width:min(58%,420px);height:28px}
.sym .cie-x{top:6px}
.sym .cie-y{bottom:6px}
.sym .cie-z{right:6px;top:50%;transform:translateY(-50%);height:min(58%,340px);width:34px;flex-direction:column}
.sym .kon{white-space:nowrap;text-shadow:0 0 3px var(--panel),0 0 7px var(--panel)}
.sym .tor{position:relative;flex:1 1 auto;align-self:stretch;touch-action:none;cursor:pointer}
.sym .tor::before{content:'';position:absolute;background:rgba(160,152,136,.35);border-radius:2px}
.sym .cie-x .tor::before,.sym .cie-y .tor::before{left:0;right:0;top:50%;height:4px;margin-top:-2px}
.sym .cie-z .tor::before{top:0;bottom:0;left:50%;width:4px;margin-left:-2px}
.sym .zost{position:absolute;background:var(--candle);opacity:.6;border-radius:2px;pointer-events:none}
.sym .cie-x .zost,.sym .cie-y .zost{top:50%;height:4px;margin-top:-2px}
.sym .cie-z .zost{left:50%;width:4px;margin-left:-2px}
.sym .gal{position:absolute;width:14px;height:14px;border-radius:50%;background:var(--panel);border:2px solid var(--candle);box-sizing:border-box;transform:translate(-50%,-50%);cursor:grab}
.sym .cie-x .gal,.sym .cie-y .gal{top:50%}
.sym .cie-z .gal{left:50%}
.sym .gal:focus-visible{outline:2px solid var(--candle);outline-offset:3px}
@media (max-width:760px){.sym .seq{flex-basis:100%}
.sym #seqN{min-width:0;flex:1}
.sym .stage{grid-template-columns:1fr;grid-template-rows:minmax(0,1.15fr) minmax(0,1fr)}
.sym .bar{grid-template-columns:1fr}
.sym .chips{justify-content:flex-start}
.sym .ex{font-size:16px;height:5.4em}
.sym .foot{line-height:1.4}}
@media (prefers-reduced-motion:reduce){.sym .tag,.sym .tag.kol{transition:none}}
.sym .bez-ruchu .tag,.sym .bez-ruchu .tag.kol{transition:none}   /* the site's Animacje switch, as the system setting */
.sym .tag.kol:not(.on){visibility:hidden}   /* a name switched off is off for a screen reader too */
.sym{background:var(--bg);color:var(--fg);font-family:var(--font-b);font-weight:300;padding:0 max(16px,env(safe-area-inset-left,0px));box-sizing:border-box}
.sym .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.sym .ex{height:4.1em}   /* three lines on a wide screen, so no caption is cut */
@media (max-width:760px){.sym .app{height:auto}.sym .stage{height:calc(100svh - var(--sym-gora,64px) - 24px)}.sym .ex{height:auto;min-height:5.4em}}   /* on a phone the model fills the screen and the controls follow on scroll */
.sym .sym-karty{margin:6px 0 18px}
.sym .sym-zrodla{margin:0 0 28px}
.sym .sym-scn{list-style:none;margin:0;padding:0;display:grid;gap:2px}
.sym .sym-scn li{display:grid;grid-template-columns:minmax(0,22em) minmax(0,1fr);gap:4px 18px;align-items:baseline;padding:7px 0;border-top:1px solid rgba(180,155,100,.12)}
.sym .sym-scn li:first-child{border-top:0}
.sym .sym-scn button{height:auto;min-height:36px;padding:4px 0;border:0;background:none;text-align:left;font-family:var(--font-d);font-style:italic;font-weight:500;font-size:19px;line-height:1.25;color:var(--fg);white-space:normal;border-radius:6px}
.sym .sym-scn button[aria-current=true]{color:var(--candle)}
@media (hover:hover){.sym .sym-scn button:hover{color:var(--candle)}}
.sym .sym-scn span{font-size:14px;line-height:1.5;color:var(--fg2)}
.sym .sym-kart{margin-top:26px}
.sym .sym-kart[hidden]{display:none}
@media (max-width:760px){.sym .sym-scn li{grid-template-columns:1fr}}
.sym .sym-karty[hidden],.sym .sym-karty [hidden]{display:none}
/* Myślenie: a thought over the figure's head, its rim in the gold its network takes in the same frame, two small circles leading to the head */
.sym .dymek{position:absolute;inset:0;pointer-events:none;opacity:0;z-index:2}
.sym .dymek .dk{position:absolute;left:0;top:0;width:96px;height:72px;border:1.5px solid var(--candle);border-radius:50%;background:var(--tag);display:grid;place-items:center}
.sym .dymek .dk svg{width:60px;height:45px}
.sym .dymek i{position:absolute;left:0;top:0;border:1.5px solid var(--candle);border-radius:50%;background:var(--tag)}
.sym .dymek .dk1{width:12px;height:12px}.sym .dymek .dk2{width:7px;height:7px}
@media (max-width:760px){.sym .dymek .dk{width:72px;height:54px}.sym .dymek .dk svg{width:46px;height:34px}}

</style>

<script>
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { LineSegments2 } from 'three/addons/lines/LineSegments2.js';
import { LineSegmentsGeometry } from 'three/addons/lines/LineSegmentsGeometry.js';
import { LineMaterial } from 'three/addons/lines/LineMaterial.js';

// the model fills the screen under the site's header, whatever height the header takes
const gora = () => { const h = document.querySelector('.rocznik-header, header'); document.querySelector('.sym').style.setProperty('--sym-gora', (h ? Math.ceil(h.getBoundingClientRect().height) : 64) + 'px'); };
gora(); addEventListener('resize', gora);

(async () => {

const $ = (i) => document.getElementById(i);
