---
// Atlas mózgu: osobna strona obok wiki, z linkami w obie strony (jego słowa, 2026-11-10: *lets make an "Atlas" subpage, next to the wiki.
// And link between them!*). Mózg w 3D z trzema cięciami i trzy przekroje w jednej skali (2026-11-11), czołowy i poziomy z obiema
// półkulami (*I'd like the view on the both hemispheres on the sections*), przełącznik Sieci i Obszary, klik zaznacza sieć albo obszar we wszystkich widokach (*The view should be modified to click
// different regions (and a switch region/network) and clicking should switch to the marked region/network*); nad tytułem stoi
// zaznaczenie z linkami. Ziarno i zaznaczanie robi `src/karty/ziarno.js`.
// Anatomia stoi tutaj, a wiki zostaje dla pojęć i przypadków (jego słowa, 2026-11-10: *When I have a network choosen, or a region...
// below the brains the card of this network/region should be visible. And then below the other cards. I want to move the anatomy
// (networks/regions) to the atlas page, and keep wiki for the conceptual things / cases etc... linking back and forth*, potem
// 2026-11-11: *ok, execute*): każda karta anatomii ma tu własną stronę ze swoim zaznaczeniem i kartą pod widokami, pod nią karty
// zaznaczenia; klik w Atlasie zmienia kartę na miejscu i adres bez przeładowania. Bez zaznaczenia pod widokami stoi przegląd trybu:
// Sieci wielkoskalowe w trybie Sieci, Płaty mózgu w trybie Obszary.
import Base from '../../layouts/Base.astro';
import '../../styles/wiki.css';
import KartaWiki from '../../components/KartaWiki.astro';
import TerminDymek from '../../components/TerminDymek.astro';
import { KARTY, NETN, INK, ATLAS, STRONY, netCard } from '../../karty/data.js';
import { KOLOR } from '../../karty/mozg.js';
import { zywy, suwak, DANE, OBJ, regiony, regionyAtlasu, kartySieci, listaObszarow, PLATY, PLAT_KOL } from '../../karty/widoki.js';
export function getStaticPaths() {
  return ATLAS.map((s) => ({ params: { strona: s.sciezka === '/atlas/' ? undefined : s.sciezka.split('/')[2] }, props: { s } }));
}
const { s } = Astro.props;
const k = s.k;
const WSZYSTKIE = new Set(Object.keys(NETN));
const karty = Object.fromEntries(Object.keys(NETN).map((n) => [n, netCard(n)]).filter(([, c]) => c).map(([n, c]) => [n, c.url]));
// lista obszarów do wyboru klawiaturą i czytnikiem ekranu w trybie Obszary, w grupach według płata (audyt Atlasu, 2026-11-10: obszarów
// nie dało się wybrać bez myszy); struktury pod korą i istota biała w osobnej grupie; struktury Allena i ich grupy (2026-11-11)
const { REG, A2R, JAK, RODZAJ, NAZWY } = regionyAtlasu(regiony());
// przekroje z objętości: sieć Yeo w kolorze sieci strony, do której należy jej grupa (istotności i brzuszna uwagi: SN i VAN po równo,
// s:uddin2019-group-combines-van-salience; skroniowo-ciemieniowa bez grupy, szara)
const OBJETOSC = { krok: OBJ.krok, poczatek: OBJ.poczatek, wymiar: OBJ.wymiar, sieci: OBJ.sieci.map(([, pl, kody]) => [pl, kody]), A2R, JAK, RODZAJ, NAZWY, mozg: OBJ.mozg, url: '/images/mozg-widoki/objetosc.bin' };
// lista sieci w trybie Sieci: klawiatura wybiera sieć tak jak klik, odkąd rysunek z boku z linkami sieci zszedł ze strony (2026-11-11)
const sieciListy = DANE.kolejnosc.filter((n) => NETN[n]);
// karty obszaru: karty, których miejsce leży w zaznaczonym obszarze, w kolorze swojej grupy
const kartyObszaru = {};
KARTY.forEach((x) => x.obszary.forEach((n) => { (kartyObszaru[n] = kartyObszaru[n] || []).push([x.h, x.url, INK[x.g]]); }));
// lista obszarów: najważniejsze płaty i obszary na początku (2026-11-11, `listaObszarow` w `widoki.js`)
const grupy = listaObszarow(REG, kartyObszaru);
// karty wiki po adresie: Atlas otwarty z karty wiki pokazuje link z powrotem do niej (jego słowa, 2026-11-10: *We will link them to the
// atlas, and link back from atlas to the wiki*)
const WIKI = Object.fromEntries(KARTY.filter((x) => x.url.startsWith('/wiki/')).map((x) => [x.url, x.h]));
const start = { tryb: s.tryb, siec: s.siec, obszar: s.obszar };
const glowna = s.sciezka === '/atlas/';
const tytul = glowna || !k ? 'Atlas mózgu · kogni.pl' : k.h + ' · Atlas mózgu · kogni.pl';
const opis = glowna || !k ? 'Atlas mózgu na kogni.pl: mózg do obracania i cięcia w trzech płaszczyznach, z kartą każdej sieci mózgowej i każdego obszaru.' : String(k.def || '').replace(/<!--\[[so]:[^\]]*\]-->/g, '').trim();
---
<Base title={tytul} activePage="atlas" description={opis}>
  <script is:inline>(function(){var z=null;try{z=localStorage.getItem('kogni-animacje')}catch(e){}var c=z?z==='off':matchMedia('(prefers-reduced-motion: reduce)').matches;if(c)document.documentElement.classList.add('roj-cicho');if(/^#(siec|obszar|plat)-/.test(location.hash))document.documentElement.classList.add('at-czeka')})();</script>
  <aside aria-label="Animacje"><button type="button" class="wk-anim" role="switch" aria-checked="true"><span>Animacje</span><span class="wk-anim-tor" aria-hidden="true"></span></button></aside>
  <article class="wk at" style="--ink:#f0c060;--base:#c89a3c">
    {/* drzwi w obie strony: karta prowadzi do Atlasu linkiem pod listą sieci, Atlas wraca do karty, z której przyszedł czytelnik (design:
        *Every door swings both ways*); bez karty w poprzedniej stronie link się nie pokazuje i nie zajmuje miejsca. Ścieżka Wiki › Atlas
        i pudełko tytułu zeszły ze strony (jego słowa, 2026-11-11: *remove the wiki>atlas and the atlas box from the top of the page - just
        taking place*) */}
    <a class="at-wroc" href="/wiki/" data-wiki={JSON.stringify(WIKI)} hidden><span aria-hidden="true">← </span><span></span></a>
    <div class="at-grid wk-brain" data-ziarno data-atlas data-kolory={JSON.stringify(KOLOR)} data-kolejnosc={JSON.stringify(DANE.kolejnosc)} data-lit={[...WSZYSTKIE].join(',')} data-karty={JSON.stringify(karty)} data-nazwy={JSON.stringify(NETN)} data-wspolne={JSON.stringify(DANE.wspolne || [])} data-regiony={JSON.stringify(REG)} data-karty-sieci={JSON.stringify(kartySieci(KARTY))} data-karty-obszaru={JSON.stringify(kartyObszaru)} data-strony={JSON.stringify(STRONY)} data-platy={JSON.stringify(PLAT_KOL)} data-start={JSON.stringify(start)} data-objetosc={JSON.stringify(OBJETOSC)}>
      {/* tytułem strony jest nazwa pudełka mózgu (jego słowa, 2026-11-11: *Rename mozg to Atlas Mózgu*), w kroju etykiet pudełek; obok niej
          zaznaczenie z linkami, które stało nad tytułem (jego słowa, 2026-11-10: *list a region/network above the title*) */}
      {/* mózg nie stoi w pudełku (jego słowa, 2026-11-11: *do not box it*) */}
      <section aria-label="Atlas Mózgu" class="at-widoki">
        <div class="at-pasek">
          <h1 class="at-tytul">Atlas Mózgu</h1>
          <p class="wk-tu" aria-live="polite"></p>
          {/* przełącznik stoi w miejscu w obu stanach (design: *a control holds its place*) */}
          <label class="at-lista" data-tryb="sieci"><span class="sr-only">Sieć</span><select><option value="">wybierz sieć</option><option value="wiele" hidden></option>{sieciListy.map((n) => <option value={n}>{n} · {NETN[n]}</option>)}</select></label>
          {/* w trybie Obszary pole szukania w miejscu listy (jego słowo, 2026-11-11: *add the search*): pisanie zawęża obszary po nazwie
              polskiej, angielskiej i po skrócie, puste pole pokazuje całą listę w jej kolejności; strzałki, Enter i Esc jak w liście */}
          {/* w trybie Płaty lista płatów (jego słowa, 2026-11-11: *we should add płaty to the views*) */}
          <label class="at-lista at-lista-off" data-tryb="platy"><span class="sr-only">Płat</span><select><option value="">wybierz płat</option>{PLATY.map((p) => <option value={p}>{p}</option>)}</select></label>
          <div class="at-lista at-lista-off at-szukaj" data-tryb="obszary">
            <label class="sr-only" for="at-szukaj">Szukaj obszaru</label>
            <input id="at-szukaj" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="at-wyniki" autocomplete="off" spellcheck="false" placeholder="szukaj obszaru" data-lista={JSON.stringify(grupy)} />
            <ul id="at-wyniki" role="listbox" aria-label="Obszary" hidden></ul>
          </div>
          <div class="at-tryb" role="group" aria-label="Co zaznacza klik"><button type="button" data-tryb="sieci" aria-pressed="true">Sieci</button><button type="button" data-tryb="platy" aria-pressed="false">Płaty</button><button type="button" data-tryb="obszary" aria-pressed="false">Obszary</button></div>
        </div>
        {/* mózg w 3D jest ryciną centralną (jego słowa, 2026-11-11: *make the brain with the sliders central. We want to have this as a central
            figure... and... somehow show the slices relative to this brain*, potem *can we make C and possible to rotate?*); suwaki cięć
            leżą na osiach mózgu w widoku startowym (*the suwaki should scale somehow within the image*), poziomy pionowo (*Maybe przekroj
            poziomy should be vertical?*); trzecie cięcie, strzałkowe, idzie od jednego boku przez środek do drugiego (*add a 3rd cut on the 3d
            brain, from lateral to medial to lateral*), a trzy rysunki z kolokwium zeszły ze strony; płaskie przekroje do czytania, w jednej
            skali, na komputerze po bokach mózgu obok swoich suwaków (*We want to move the brain slices in the desktop version to sides... next
            to the suwaki*): strzałkowy u góry z lewej przy górnym suwaku, czołowy u dołu z lewej przy dolnym, poziomy z prawej przy pionowym;
            na węższym ekranie w rzędzie pod mózgiem; każde cięcie ma swój wyłącznik (*we want a switch on/off button next to each*) */}
        <div class="at-glowny">
          <div class="at-boki at-boki-lewe"><Fragment set:html={zywy('strzalkowy') + zywy('czolowy')} /></div>
          <div class="at-3d" role="group" aria-label="Mózg w trzech wymiarach z cięciem czołowym, poziomym i strzałkowym" data-powierzchnia="/images/mozg-widoki/powierzchnia.bin">
            <div class="at-3d-scena"></div>
            <Fragment set:html={suwak('strzalkowy') + suwak('czolowy') + suwak('poziomy')} />
            {/* powrót do widoku startowego, widoczny zawsze, po suwakach w kolejności klawiatury (przegląd Atlasu 2026-11-11: po
                przybliżeniu i obrocie student nie wiedział, jak wrócić; dwuklik robi to samo) */}
            <button type="button" class="at-3d-start" aria-label="Widok startowy" data-podpis="widok startowy">↻</button>
            <div class="wk-kody at-3d-nazwa" aria-hidden="true" hidden></div>
          </div>
          <div class="at-boki at-boki-prawe"><Fragment set:html={zywy('poziomy')} /></div>
        </div>
      </section>
      {/* karta zaznaczenia pod widokami; przy kilku zaznaczonych sieciach ich karty jedna pod drugą */}
      <div class="at-miejsce">{k && <KartaWiki k={k} wAtlasie />}</div>
      <section aria-label="Karty" class="wk-box at-karty" hidden>
        <h2>Karty</h2>
        <div class="wk-chips"></div>
      </section>
    </div>
    <p class="wk-zrodlo wk-zrodlo-mozg">Mózg w trzech wymiarach i przekroje liczone z szablonu MNI ICBM152 2009c (© 1993–2004 Louis Collins, McConnell Brain Imaging Centre, Montreal Neurological Institute, McGill University), ze strukturami z <a href="https://download.alleninstitute.org/informatics-archive/allen_human_reference_atlas_3d_2020/version_1/">Allen Human Reference Atlas – 3D, 2020</a> (Ding i in., Allen Institute for Brain Science, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>) i 17 sieciami Yeo i in. (2011) w parcelacji Schaefera i in. (2018), w móżdżku według mapy Bucknera i in. (2011) ze zbioru <a href="https://github.com/DiedrichsenLab/cerebellar_atlases">laboratorium Diedrichsena</a> (CC BY); powierzchnia i przekroje przeliczone, przekroje przerysowane liniami.</p>
  </article>
  <TerminDymek />
</Base>
<script>
  import { iskraKursu } from '../../karty/iskra.js';
  const iskra = iskraKursu({ zmienna: true });
  import { ziarno } from '../../karty/ziarno.js';
  import { mozg3d } from '../../karty/mozg3d.js';
  // karta zaznaczenia: strona Atlasu z kartą bierze z niej sekcję karty; pobrane strony zostają w pamięci strony
  const mozg = document.querySelector<HTMLElement>('.at-grid')!;
  const miejsce = document.querySelector<HTMLElement>('.at-miejsce')!;
  const pamiec = new Map<string, Promise<{ karta: Element | null; tytul: string }>>();
  const pobierz = (p: string) => {
    if (!pamiec.has(p)) pamiec.set(p, fetch(p).then((r) => (r.ok ? r.text() : Promise.reject(r.status))).then((t) => {
      const d = new DOMParser().parseFromString(t, 'text/html');
      return { karta: d.querySelector('.at-karta'), tytul: d.title };
    }));
    return pamiec.get(p)!;
  };
  const OGOLNY = 'Atlas mózgu · kogni.pl';
  let zadanie = 0;
  mozg.addEventListener('atlas-wybor', async (e) => {
    const { karty: chce, przewin, nazwa } = (e as CustomEvent).detail as { karty: string[]; przewin: boolean; nazwa: string };
    const jest = [...miejsce.querySelectorAll<HTMLElement>('.at-karta')].map((x) => x.dataset.strona);
    const nr = ++zadanie;
    if (chce.join() !== jest.join()) {
      try {
        const wyn = await Promise.all(chce.map(pobierz));
        if (nr !== zadanie) return;
        miejsce.replaceChildren(...wyn.filter((w) => w.karta).map((w) => document.importNode(w.karta!, true)));
        const dymek = document.querySelector<HTMLElement>('.td-w'); if (dymek) dymek.hidden = true;
        iskra();
      } catch (err) { /* karta się nie wczytała: zostaje poprzednia, adres prowadzi do nowej po przeładowaniu */ }
    }
    if (nr !== zadanie) return;
    // tytuł karty, a bez jednej karty nazwa zaznaczenia przed nazwą Atlasu (przegląd Atlasu 2026-11-11)
    // płat nie ma własnej karty: tytuł nazywa płat, nie kartę Płaty mózgu pod nim (przegląd 2026-11-11)
    const plat = ((e as CustomEvent).detail as { wybor?: { typ: string } }).wybor?.typ === 'plat';
    try { document.title = plat ? nazwa + ' · ' + OGOLNY : chce.length === 1 ? (await pobierz(chce[0])).tytul : nazwa ? nazwa + ' · ' + OGOLNY : OGOLNY; } catch (err) {}
    if (nr !== zadanie) return;
    document.documentElement.classList.remove('at-czeka');
    if (przewin) (miejsce.querySelector('.at-karta') || mozg.querySelector('.at-karty') || miejsce).scrollIntoView({ block: 'start' });
  });
  ziarno();
  mozg3d(document.querySelector<HTMLElement>('.at-3d')!);
  const wroc = document.querySelector<HTMLAnchorElement>('.at-wroc');
  try {
    const r = new URL(document.referrer);
    const h = r.origin === location.origin ? JSON.parse(wroc!.dataset.wiki || '{}')[r.pathname] : '';
    if (wroc && h) { wroc.href = r.pathname; (wroc.lastElementChild as HTMLElement).textContent = h; wroc.hidden = false; }
  } catch (e) {} // wejście bez poprzedniej strony albo z innej witryny: link zostaje ukryty
</script>
