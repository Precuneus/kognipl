---
import '../styles/global.css';
import '../rocznik/rocznik.css';
import RocznikHeader from '../components/RocznikHeader.astro';

interface Props {
  title?: string;
  activePage?: string;
  rocznik?: string;
  description?: string;
}

const { title = 'kogni.pl', activePage = '', rocznik = '', description = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---
<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="kogni.pl">
  <meta property="og:locale" content="pl_PL">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  {description && <meta property="og:description" content={description}>}
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="stylesheet" href="/fonts/fonts.css">
</head>
<body>

<RocznikHeader rocznik={rocznik} current={activePage} />

<slot />

<footer class="site-footer">
  <div class="compass-small">
    <svg viewBox="0 0 100 100" fill="none">
      <circle cx="50" cy="50" r="46" stroke="#6b6358" stroke-width="0.5" opacity="0.3"/>
      <path d="M50 6 L52.5 44 L50 40 L47.5 44 Z" fill="#a09888" opacity="0.4"/>
      <path d="M50 94 L52.5 56 L50 60 L47.5 56 Z" fill="#6b6358" opacity="0.3"/>
      <path d="M6 50 L44 47.5 L40 50 L44 52.5 Z" fill="#6b6358" opacity="0.3"/>
      <path d="M94 50 L56 47.5 L60 50 L56 52.5 Z" fill="#6b6358" opacity="0.3"/>
      <circle cx="50" cy="50" r="2" fill="#a09888" opacity="0.4"/>
    </svg>
  </div>
  <p class="footer-name">Olgierd Borowiecki</p>
  <p class="footer-faculty">Wydział Filozofii i Kognitywistyki</p>
  <p class="footer-info">
    Uniwersytet w Białymstoku &ensp;·&ensp; <a href="mailto:o.borowiecki@uwb.edu.pl">o.borowiecki@uwb.edu.pl</a>
  </p>
  {/* ujawnienie procesu na każdej stronie, jego zdanie (jego słowo, 2026-10-23: *add this to the footer*) */}
  <p class="footer-ai">
    Strona i jej treści wyłaniają się z procesu: pętli sprzężenia zwrotnego między inteligencją biologiczną a sztuczną. <span style="white-space:nowrap"><a href="/o-stronie/">O stronie</a> &ensp;·&ensp; <a href="/prywatnosc/">Prywatność</a></span>
  </p>
</footer>

{/* Candlelight card tracking (shared) */}
<script>
  document.querySelectorAll('.glow-card').forEach(card => {
    const light = card.querySelector('.card-light');
    const glow = card.querySelector('.card-border-glow');
    if (!light || !glow) return;
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) + 'px';
      const y = (e.clientY - rect.top) + 'px';
      light.style.setProperty('--light-x', x);
      light.style.setProperty('--light-y', y);
      glow.style.setProperty('--light-x', x);
      glow.style.setProperty('--light-y', y);
    });
  });
</script>

</body>
</html>