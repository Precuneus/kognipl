---
interface Props { current?: string; heading?: boolean }
const { current = '', heading = false } = Astro.props;
const views = [['plotno', 'Płótno', '/2026/'], ['osnowy', 'Osnowy', '/2026/osnowy/'], ['watki', 'Wątki', '/2026/watki/']];
---
<div class="rocznik-head">
  <div class="rocznik-title">
    <a href="/" aria-label="kogni.pl, strona główna" class="rocznik-logo">kogn<span class="rocznik-i">ı<span class="rocznik-knot"></span></span>.pl</a>
    <span aria-hidden="true" class="rocznik-bar">|</span>
    {heading ? <h1 class="rocznik-name">Rocznik 2026</h1> : <p class="rocznik-name">Rocznik 2026</p>}
  </div>
  <nav aria-label="Widoki" class="rocznik-views">
    {views.map(([k, label, href]) => (
      <a href={href} aria-current={current === k ? 'page' : undefined} class={current === k ? 'on' : ''}>{label}</a>
    ))}
  </nav>
</div>
