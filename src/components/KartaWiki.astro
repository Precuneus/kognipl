---
// Karta wiki w jednym szablonie: strona karty i pierwszy artykuł na /wiki/ (2026-10-22).
import { template } from '../rocznik/views/karta.js';
import { GRUPY, BASE, INK, NETN, segs, netCard, card, backlinks, classesOf, slugify, INDEKS, rodzinaUrl } from '../karty/data.js';
import { KOLOR } from '../karty/mozg.js';
import WIDOKI_DANE from '../karty/mozg-widoki.json';
import '../styles/wiki.css';
import TerminDymek from './TerminDymek.astro';
interface Props { k: any; wstep?: boolean }
const { k, wstep = false } = Astro.props;
const ink = INK[k.g], base = BASE[k.g];
const group = GRUPY[k.g] ? GRUPY[k.g].charAt(0).toUpperCase() + GRUPY[k.g].slice(1) : 'Wiki';

// Karta sieci pokazuje tylko swoją sieć (jego słowo, 2026-10-23: *the page is about dan so for the networks we use a single network*);
// sieć limbiczna jest osobną siecią (jego słowo, 2026-11-09).
const own = Object.keys(NETN).find((kod) => netCard(kod) === k);
const ownKey = own;

// Ryciny: te same rysunki co na karcie Rocznika (szablon karta.js), w kolorze karty.
const CAPT = {
  rp: 'Potencjał gotowości narasta przed wskazaną na zegarze chwilą decyzji, a ta wypada przed ruchem.',
  eeg: 'Droga sygnału z kory przez czaszkę i skórę głowy do elektrody.',
  przyciski: 'Czerwony daje pewne przeżycie, niebieski tylko wtedy, gdy naciśnie go ponad połowa.',
  karty: 'Karta pasuje do trzech kart wzorcowych naraz, więc regułę trzeba odkryć.',
  neuron: 'Neuron z dendrytami, ciałem komórki, aksonem i synapsami, obok komórka glejowa.',
};
// Rycina żywa na karcie, ten sam moduł co na wpisie zajęć (jego słowo, 2026-11-02: *put the animation of the predictive brain into the
// predykcje karta. Remember that updating one animation updates the other one also*): nazwa z ZYWE w `ryciny` karty.
const ZYWE = {
  mozg: 'W modelu kursu sieci mózgu leżą według odległości od receptorów: najbliżej sieć wzrokowa i czuciowo-ruchowa, a na drugim końcu głównego gradientu kory sieć domyślna (Margulies i in. 2016)<!--[s:margulies2016-dmn-far-end-from-sensorimotor]-->. Predykcje płyną falą od sieci domyślnej ku receptorom. Zaskoczenie biegnie w drugą stronę, przez sieć istotności, a każde kolejne kliknięcie „zaskoczenie” sięga o sieć wyżej. Przeciągnij mózg w bok, a zobaczysz jego przyśrodkową ścianę.',
};
const unmark = (t) => String(t || '').replace(/<!--\[s:[^\]]*\]-->/g, '');
const FIGKEY = { rp: 'isRp', eeg: 'isEeg', przyciski: 'isPrzyciski', karty: 'isKarty', neuron: 'isNeuron' };
const svgOf = (name) => {
  const key = FIGKEY[name]; if (!key) return '';
  const i = template.indexOf('<sc-if value="{{bk.' + key + '}}"'); if (i < 0) return '';
  const a = template.indexOf('<svg', i), b = template.indexOf('</svg>', a) + 6;
  return template.slice(a, b).replace(/\{\{bk\.acc\}\}/g, base);
};
const inBody = new Set(k.body.filter((b) => b.fig).map((b) => b.fig));
const blocksOut = k.body.concat(k.fig.filter((f) => !inBody.has(f)).map((f) => ({ fig: f })));
let nfig = 0;
const items = blocksOut.map((b) => b.fig ? (ZYWE[b.fig] ? { zywa: b.fig, fig: 'zywa', cap: 'Ryc. ' + (++nfig) + '. ' + unmark(ZYWE[b.fig]) } : { fig: svgOf(b.fig), cap: CAPT[b.fig] ? 'Ryc. ' + (++nfig) + '. ' + CAPT[b.fig] : '' }) : b).filter((b) => b.t || b.fig);
const kindOf = (u) => (/youtu\.?be/.test(u) ? 0 : (/doi\.org|frontiersin|journals|\.pdf|pubmed|ncbi/.test(u) ? 1 : 2));
const kinds = ['Filmy', 'Artykuły', 'Inne'].map((name, q) => ({ name, items: k.l.filter((l) => kindOf(l[1]) === q) })).filter((x) => x.items.length);
const back = backlinks(k);
// karta z akapitem kursu dostaje Iskrę i przełącznik animacji ze strony startowej (jego słowa, 2026-11-09: *if we add iskra, we need to
// add on/off animation there also*); przełącznik stoi też na każdej karcie, której sieć świeci w ziarnie mózgu, bo to ziarno się rusza
// (audyt 2026-11-09, WCAG 2.2.2); karta bez sieci i bez akapitu kursu ma tylko szare ziarno, które nie zmienia obrazu
const kurs = items.some((b) => b.kurs);
const zaj = classesOf(k);
// rodzina o nazwie tej karty powtarzałaby tytuł nad sobą, więc wiersz rodzin pomija kartę samą (przegląd 2026-11-05: Predykcja, Interocepcja i cztery inne)
const rodz = k.r2.filter((r) => card(r) !== k);
const nets = k.nets.map(([kod, why]) => ({ kod, name: NETN[kod] || kod, why, to: netCard(kod) }))
  .filter((n) => !own || n.kod === ownKey);
// Sieci tej karty w kolorach strony startowej; sieć limbiczna świeci własnym kolorem.
const on = new Set(own ? [ownKey] : nets.map((n) => n.kod));
const lit = (n) => on.has(n);
const ruch = kurs || on.size > 0;
// Każda sieć na mózgu karty prowadzi do swojej karty (jego słowo, 2026-11-09: *make the all networks clickable on every wiki card*).
// Trzy widoki z kolokwium Neurokogni, boczny, przyśrodkowy i brzuszny (jego słowo, 2026-11-09: *We have the 3 views of the brain
// from the exam (lateral, ventral, medial), can we adapt these pictures to be visible in the wiki cards?*). Sieci pokrywają korę
// zakręt po zakręcie według Yeo i in. 2011 i Uddin, Yeo i Spreng 2019 (*detaailed marking*) i nakładają się: ośrodek należy do kilku
// sieci naraz, a jego przynależność zmienia się w czasie (*real multi-membership and the time*), rysowane ziarnem (*ziarno, I love it*).
// Ziarno rysuje `src/karty/ziarno.js` na płótnie pod liniami, z mapy sieci `<plik>-sieci.png` i ośrodków `huby` z `mozg-widoki.json`;
// wielokąty obszarów zostają linkami dla klawiatury i czytnika ekranu.
// oba rysunki Cartera pokazują lewą półkulę, więc podpis ją nazywa (przegląd 2026-11-09: karta sieci brzusznej mówi o prawej);
// widok od dołu to kresomózg z ryciny 630 Sobotty, bez móżdżku i pnia (jego słowa, 2026-11-10: *can we remove the cerebellum so that
// the ventral cerebrum will be visible?*), z obiema półkulami
const WIDOKI = [['lateral', 'z boku, lewa półkula', 'lewej półkuli z boku'], ['medial', 'od środka, lewa półkula', 'lewej półkuli od środka'], ['ventral', 'od dołu', 'mózgu od dołu']];
const swieci = [...on].map((n) => NETN[n]).filter(Boolean);
const IMG = '/images/mozg-widoki/';
const esc = (t) => t.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
const widok = Object.fromEntries(WIDOKI.map(([v, cap, gdzie]) => {
  const d = WIDOKI_DANE[v], [W, H] = d.vb, f = d.plik;
  const sieci = d.sieci.map((n) => {
    const polys = d.obszary.filter(([m]) => m === n).map(([, p]) => p);
    // etykieta stoi w obszarze sieci, w miejscu wybranym przy generowaniu rysunków tak, żeby żadne dwie etykiety widoku się nie
    // nakładały i żadna nie wychodziła poza rysunek; jest elementem strony, nie rysunku, więc ma 12 px w każdym widoku i na każdym
    // ekranie, jak kody pod wskaźnikiem (przegląd 2026-11-09: w widoku od dołu etykiety były większe, DMN i SN zachodziły na siebie)
    const [cx, cy] = d.etykiety[n];
    const to = netCard(n);
    const body = polys.map((p) => '<polygon class="wk-hit" points="' + p.map((q) => q.join(',')).join(' ') + '"/>').join('');
    const tag = '<span class="wk-nl" aria-hidden="true" data-k="' + n + '" style="left:' + (cx / W * 100).toFixed(2) + '%;top:' + (cy / H * 100).toFixed(2) + '%' + (lit(n) ? '' : ';display:none') + '">' + n + '</span>';
    return {
      // obszar sieci tej karty nie jest linkiem do niej samej (przegląd 2026-11-09: stuknięcie przeładowywało kartę)
      // klawiatura i czytnik ekranu idą przez widok z boku, który ma wszystkie sieci; w dwóch pozostałych te same linki byłyby
      // powtórzeniem przed hasłem (przegląd 2026-11-09: 16 przystanków tabulatora w paśmie)
      shape: to && to !== k ? '<a href="' + to.url + '" class="wk-nb" data-k="' + n + '"' + (v === 'lateral' ? '' : ' tabindex="-1"') + '><title>' + NETN[n] + '</title>' + body + '</a>' : '<g>' + body + '</g>',
      tag,
    };
  });
  // widoki nie są rycinami opisu, tylko mapą sieci karty, więc nie noszą numeru „Ryc.”, jak lista sieci obok nich
  return [v, '<figure class="wk-widok wk-widok-' + f + '" data-pole="' + IMG + f + '-sieci.png" data-k="' + d.pole.k + '" data-vb="' + W + ' ' + H + '" data-huby="' + esc(JSON.stringify(d.huby)) + '">'
    + '<div class="wk-pole"><canvas class="wk-ziarno" aria-hidden="true"></canvas>'
    + '<svg viewBox="0 0 ' + W + ' ' + H + '"' + (v === 'lateral' ? ' role="group" aria-label="Sieci mózgowe na ' + gdzie + (swieci.length ? ', zaznaczona: ' + swieci.join(', ') : '') + '"' : ' aria-hidden="true"') + '>'
    + sieci.map((s) => s.shape).join('')
    + '<image href="' + IMG + f + '.webp" width="' + W + '" height="' + H + '" class="wk-linie"/>'
    + '</svg>' + sieci.map((s) => s.tag).join('') + '<div class="wk-kody" aria-hidden="true" hidden></div></div><figcaption>' + cap + '</figcaption></figure>'];
}));
const karty = Object.fromEntries(Object.keys(NETN).map((n) => [n, netCard(n)]).filter(([, c]) => c && c !== k).map(([n, c]) => [n, c.url]));
const brainData = { kolory: JSON.stringify(KOLOR), kolejnosc: JSON.stringify(WIDOKI_DANE.kolejnosc), lit: [...on].join(','), karty: JSON.stringify(karty), nazwy: JSON.stringify(NETN), wspolne: JSON.stringify(WIDOKI_DANE.wspolne || []) };
---
  {ruch && <script is:inline>(function(){var z=null;try{z=localStorage.getItem('kogni-animacje')}catch(e){}var c=z?z==='off':matchMedia('(prefers-reduced-motion: reduce)').matches;if(c)document.documentElement.classList.add('roj-cicho')})();</script>}
  {ruch && <aside aria-label="Animacje"><button type="button" class="wk-anim" role="switch" aria-checked="true"><span>Animacje</span><span class="wk-anim-tor" aria-hidden="true"></span></button></aside>}
  <article class={'wk' + (wstep ? ' wk-wstep' : '')} style={'--ink:' + ink + ';--base:' + base}>
  <nav aria-label="Ścieżka" class="wk-path">
    {k.grupa ? (
      // karta dyscypliny: ścieżka od jej grupy na mapie osnów; karta grupy stoi sama (2026-10-23)
      k.grupa === 'wiki'
        ? <Fragment><a href="/wiki/">Wiki</a><span aria-hidden="true"> › </span><span aria-current="page">{k.h}</span></Fragment>
        : k.grupa.toLowerCase() === k.h.toLowerCase()
        ? <Fragment><a href="/wiki/mapa-osnow/">Mapa osnów</a><span aria-hidden="true"> › </span><span aria-current="page">{k.h}</span></Fragment>
        : <Fragment><a href={'/wiki/' + slugify(group) + '/'}>{group}</a><span aria-hidden="true"> › </span><span aria-current="page">{k.h}</span></Fragment>
    ) : (
      <Fragment><a href={INDEKS + '#' + slugify(GRUPY[k.g])}>{group}</a><span aria-hidden="true"> › </span><a href={INDEKS + '#' + slugify(k.o)}>{k.o}</a><span aria-hidden="true"> › </span><span aria-current="page">{k.h}</span></Fragment>
    )}
  </nav>
  {/* widoki z boku i od środka leżą poziomo nad hasłem (jego słowa, 2026-11-09: *can we make the brain images above the haslo? ...
      horizontally we can have the lateral and medial view*), widok od dołu pod nimi po prawej (2026-11-10: *can you perhaps make the
      ventral view BELOW the row of lateral and medial views?*), a pod nim tekst o sieci (2026-11-09: *below the ventral view we can
      have text about the network*); pasmo jest pudełkiem karty z nagłówkiem „Sieć mózgowa”, a widok od dołu z tekstem o sieci zwisa
      z niego w prawej kolumnie jako jedna całość (2026-11-10: *can you embed the figures more into the page layout? Now they are
      slightly disonnected from the content of the card*); na wąskim ekranie pasmo i tekst o sieci stoją zaraz pod hasłem, przed
      opisem (przegląd 2026-11-09: na telefonie mózg zaczynał się po sześciu ekranach opisu); ziarno czyta wszystkie trzy widoki z
      siatki karty, która nosi dane sieci */}
  <div class={'wk-grid wk-grid-karta' + (Astro.slots.has('siec') ? '' : ' wk-brain')} data-ziarno={Astro.slots.has('siec') ? undefined : ''} data-kolory={brainData.kolory} data-kolejnosc={brainData.kolejnosc} data-lit={brainData.lit} data-karty={brainData.karty} data-nazwy={brainData.nazwy} data-wspolne={brainData.wspolne}>
    {!Astro.slots.has('siec') && <div class="wk-box wk-pasmo"><h2>Sieć mózgowa</h2><Fragment set:html={widok.lateral + widok.medial} /></div>}
    <div class="wk-col wk-lewa">
      <section aria-label="Termin" class="wk-box wk-mysl">
        <h2>Termin</h2>
        <h1>{k.h}</h1>
        {rodz.length > 0 && <p class="wk-rodziny">{rodz.map((r, i) => [i ? ' · ' : '', rodzinaUrl(r, k) ? <a href={rodzinaUrl(r, k)}>{r}</a> : r])}</p>}
        {zaj.length > 0 && <p class="wk-zaj">Na zajęciach {zaj.map((z, i) => [i ? ' · ' : '', <a href={z.url} style={'color:' + (z.kurs === 'Intro' ? '#f0c060' : '#edbbc5')}>{z.label.split(':')[0]}</a>])}</p>}
      </section>
      <section aria-label="Opis" class="wk-box wk-opis">
        <h2>Opis</h2>
        {items.map((b) => b.t ? (b.przyklad ? (
          <p class="wk-p wk-przyklad">{segs(b.t).map((s) => s.url ? <a href={s.url} title={s.label} data-def={s.def} style={'color:' + s.color}>{s.t}</a> : s.t)}</p>
        ) : b.kurs ? (
          <div class="wk-kurs"><p class="wk-p">{segs(b.t).map((s) => s.url ? <a href={s.url} title={s.label} data-def={s.def} style={'color:' + s.color}>{s.t}</a> : s.t)}</p></div>
        ) : (
          <p class="wk-p">{segs(b.t).map((s) => s.url ? <a href={s.url} title={s.label} data-def={s.def} style={'color:' + s.color}>{s.t}</a> : s.t)}</p>
        )) : (
          b.zywa ? <figure class="wk-fig"><div class="wz-zywa" data-zywa={b.zywa}><canvas role="img" aria-label={b.cap}></canvas><button type="button">zaskoczenie</button></div><figcaption>{b.cap}</figcaption></figure>
          : <figure class="wk-fig"><Fragment set:html={b.fig} /><figcaption>{b.cap}</figcaption></figure>
        ))}
        {Astro.slots.has('indeks') && <slot name="indeks" />}
      </section>
    </div>
    <div class="wk-col wk-prawa">
      {Astro.slots.has('siec') ? <slot name="siec" /> : (
      <section aria-label="Sieć mózgowa" class="wk-box wk-siec">
        {/* bez nagłówka: pudełko jest dalszym ciągiem pasma z mózgiem, nad którym stoi „Sieć mózgowa” */}
        <Fragment set:html={widok.ventral} />
        {/* mózg stoi na każdej karcie, także bez sieci, żeby każda sieć prowadziła do swojej karty (jego słowo, 2026-11-09) */}
        {nets.length > 0 ? (
          <Fragment>
            <dl>
              {nets.map((n) => (
                <div class="wk-net">
                  <dt>{n.to && n.to !== k ? <a href={n.to.url} class="wk-kod" style={KOLOR[n.kod] ? 'color:' + KOLOR[n.kod] : ''}>{n.kod}</a> : <span class="wk-kod" style={KOLOR[n.kod] ? 'color:' + KOLOR[n.kod] : ''}>{n.kod}</span>}<span class="wk-netname">{n.name}</span></dt>
                  <dd>{segs(n.why).map((s) => s.url ? <a href={s.url} title={s.label} data-def={s.def} style={'color:' + s.color}>{s.t}</a> : s.t)}</dd>
                </div>
              ))}
            </dl>
          </Fragment>
        ) : <p class="wk-p">{k.nw}</p>}
      </section>
      )}
      {kinds.length > 0 && (
        <section aria-label="Materiały" class="wk-box">
          <h2>Materiały</h2>
          {kinds.map((kd) => (
            <div class="wk-kind">
              <h3>{kd.name}</h3>
              <ul>{kd.items.map((l) => <li><a href={l[1]} target="_blank" rel="noopener">{l[0]}</a> {l[2] && <span class="wk-meta">{l[2]}</span>}</li>)}</ul>
            </div>
          ))}
        </section>
      )}
      {back.length > 0 && (
        <section aria-label="Linkują tutaj" class="wk-box">
          <h2>Linkują tutaj</h2>
          <div class="wk-chips">{back.map((b) => <a href={b.url} class="wk-chip" style={'--c:' + INK[b.g]}>{b.h}</a>)}</div>
        </section>
      )}
      {zaj.length > 0 && (
        <section aria-label="Na zajęciach" class="wk-box">
          <h2>Na zajęciach</h2>
          <div class="wk-chips">{zaj.map((z) => <a href={z.url} class="wk-chip" style={'--c:' + (z.kurs === 'Intro' ? '#f0c060' : '#edbbc5')}>{z.label}</a>)}</div>
        </section>
      )}
    </div>
  </div>
  {!Astro.slots.has('siec') && <p class="wk-zrodlo wk-zrodlo-mozg">Rysunki mózgu: z boku i od środka Henry Vandyke Carter, <i>Anatomy of the Human Body</i> Graya, 1918; od dołu K. Hajek, <a href="https://commons.wikimedia.org/wiki/File:Sobo_1909_630.png">ryc. 630</a> w <i>Atlas and Text-book of Human Anatomy</i> Sobotty, 1909, przerysowana liniami; wszystkie w domenie publicznej.</p>}
</article>
<TerminDymek />
<script>
  import { mozg } from '../rocznik/2026/ryciny/zywe/mozg.js';
  document.querySelectorAll('.wz-zywa[data-zywa="mozg"]').forEach((el) => mozg(el as HTMLElement));
  import { iskraKursu } from '../karty/iskra.js';
  iskraKursu();
  import { ziarno } from '../karty/ziarno.js';
  ziarno();
</script>
